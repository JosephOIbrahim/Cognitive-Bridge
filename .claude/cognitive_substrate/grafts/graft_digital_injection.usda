# ===================================================================
# INJECTION PARAMETERS -- The Pharmacology
# ===================================================================

def "InjectionParameters" (
    doc = """Injection parameters and topology map.
    These are READ by converter.py's InjectionEngine at conversion time.
    The gain equation is applied in Python (exact arithmetic),
    NOT left for Claude to interpret at runtime."""
)
{
    # Data-only prim: not rendered to markdown
    bool enabled = false
    # ----- Global Injection Strength -----
    # s_NM: The single scalar that controls injection intensity.
    # 0.0   = placebo (identity transform, no behavioral change)
    # 0.005 = microdose (subtle entropy boost)
    # 0.015 = moderate (noticeable exploration shift)
    # 0.025 = full classical (modularity dissolution, DMF LSD-equivalent)
    # 0.040 = high (experimental -- may destabilize routing)
    float s_NM = 0.0

    # ----- Active Profile -----
    # Which named injection profile to use. "none" = no injection.
    # Profiles define d_map, behavioral modulations, and pharmacokinetics.
    string active_profile = "none"

    # ----- Phase Topology Map (d_rec analogs) -----
    # Hub centrality of each cascade phase, normalized 0.0-1.0.
    # Derived from routing traffic volume and cross-phase connectivity.
    # Hub phases (high d_rec) receive MORE gain modulation.
    # Peripheral phases (low d_rec) stay near baseline.
    #
    # Calibration basis:
    #   SAFETY:        0.90 -- highest traffic, touches everything, anchors system
    #   KNOWLEDGE:     0.85 -- high traffic hub, broad connectivity
    #   SIGNAL:        0.80 -- routes to all experts, high fan-out
    #   EXPERT:        0.75 -- selects specialists, moderate-high connectivity
    #   DOMAIN:        0.50 -- moderate routing, context-dependent
    #   PROJECT:       0.40 -- moderate, session-dependent
    #   COST:          0.30 -- evaluative, lower traffic
    #   DEFAULT:       0.20 -- catch-all, low specificity
    #   CONSTITUTIONAL: 0.15 -- fires rarely, principle-check only
    #   CONSENT:       0.10 -- peripheral, fires infrequently

    # Stored as parallel arrays (USDA doesn't support dicts)
    string[] d_map_phases = [
        "KNOWLEDGE",
        "CONSTITUTIONAL",
        "SAFETY",
        "CONSENT",
        "COST",
        "SIGNAL",
        "PROJECT",
        "EXPERT",
        "DOMAIN",
        "DEFAULT"
    ]
    # NOTE: These are string representations of floats for USDA compatibility.
    # converter.py parses them to float at load time.
    string[] d_map_values = [
        "0.85",
        "0.15",
        "0.90",
        "0.10",
        "0.30",
        "0.80",
        "0.40",
        "0.75",
        "0.50",
        "0.20"
    ]
}

