{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "SYNAPSE_ROOT": "C:\\Users\\User\\SYNAPSE"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/User/.claude/hooks/guard-deployed-files.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/User/.claude/hooks/guard-dangerous-bash.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/User/.claude/hooks/check-python-encoding.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/User/.claude/hooks/gsd-context-monitor.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/User/.claude/hooks/session-start-check.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/User/.claude/hooks/gsd-check-update.js\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"C:/Users/User/.claude/hooks/gsd-statusline.js\""
  },
  "enabledPlugins": {
    "superpowers-developing-for-claude-code@superpowers-developing-for-claude-code-dev": true,
    "last30days@last30days": true,
    "image-generator@dair-academy-plugins": true,
    "llm-council@dair-academy-plugins": true
  },
  "skipDangerousModePermissionPrompt": true
}
