return \"\";\n}\n\ninterface EditorialGridProps {\n  rows: GridRow[];\n  filterCategory?: string;\n}\n\nexport function EditorialGrid({ rows, filterCategory = \"All\" }: EditorialGridProps) {\n  const filteredRows = useMemo(() => {\n    if (filterCategory === \"All\") return rows;\n    return rows\n      .map((row) => {\n        const filtered = row.slugs\n          .map((slug, i) => {\n            const p = PROJECT_MAP.get(slug);\n            return p && p.category === filterCategory ? i : -1;\n          })\n          .filter((i) => i !== -1);\n\n        if (filtered.length === 0) return null;\n\n        return {\n          ...row,\n          type:\n            filtered.length === 1\n              ? (\"hero\" as GridRowType)\n              : filtered.length === 2 && row.type === \"triple\"\n                ? (\"wide-narrow\" as GridRowType)\n                : row.type,\n          slugs: filtered.map((i) => row.slugs[i]),\n          text: filtered.map((i) => row.text[i]),\n          heights: filtered.map((i) => row.heights[i]),\n        };\n      })\n      .filter((row): row is GridRow => row !== null);\n  }, [rows, filterCategory]);\n\n  return (\n    <div className={styles.container}>\n      {filteredRows.map((row, ri) => (\n        <div\n          key={ri}\n          className={`${styles.row} ${responsiveClass(row.type)}`}\n          style={{ gridTemplateColumns: colsFor(row.type) }}\n        >\n          {row.slugs.map((slug, si) => {\n            const project = PROJECT_MAP.get(slug);\n            if (!project) return null;\n            return (\n              <GridCard\n                key={slug}\n                project={project}\n                showText={row.text[si]}\n                height={row.heights[si]}\n                columnIndex={si}\n              />\n            );\n          })}\n        </div>\n      ))}\n    </div>\n  );\n}\n","structuredPatch":[{"oldStart":80,"oldLines":6,"newStart":80,"newLines":7,"lines":["                 showText={row.text[si]}","                 height={row.heights[si]}","                 columnIndex={si}","+                priority={ri === 0 && si === 0}","               />","             );","           })}"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"24c46a15-cd5f-45be-b1c0-5e52ec95703b"}
