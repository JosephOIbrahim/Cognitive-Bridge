400ms var(--ease),\n    transform 600ms var(--ease);\n}\n\n/* Hover: full opacity + subtle scale inside the crop window */\n.card:hover .imageInner {\n  opacity: 1;\n  transform: scale(1.04);\n}\n\n/* --- Text block --- */\n\n.textBlock {\n  margin-top: 14px;\n  padding-bottom: 0;\n  opacity: 0;\n  transform: translateY(12px);\n  transition:\n    opacity 500ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 200ms),\n    transform 500ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 200ms);\n}\n\n.cardRevealed .textBlock {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* --- Text styles --- */\n\n.title {\n  font-size: 18px;\n  font-weight: 500;\n  margin: 0 0 6px;\n  color: var(--text);\n  letter-spacing: 0.015em;\n  line-height: 1.3;\n}\n\n.desc {\n  font-size: 14px;\n  font-weight: 400;\n  margin: 0 0 8px;\n  color: var(--muted);\n  letter-spacing: normal;\n  line-height: 1.4;\n}\n\n/* Elevator metatags */\n.metatagWrapper {\n  height: 30px;\n  overflow: hidden;\n  margin-top: 8px;\n}\n\n.metatagInner {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  transform: translateY(-110%);\n  opacity: 0;\n  transition:\n    transform 350ms var(--ease),\n    opacity 250ms var(--ease);\n}\n\n.card:hover .metatagInner {\n  transform: translateY(0);\n  opacity: 1;\n  transition:\n    transform 350ms var(--ease-out),\n    opacity 250ms var(--ease-out);\n}\n\n/* --- Accessibility: reduced motion --- */\n@media (prefers-reduced-motion: reduce) {\n  .imageInner {\n    clip-path: none;\n    opacity: 0.75;\n    transform: none;\n    transition: opacity 300ms var(--ease);\n  }\n  .card:hover .imageInner {\n    opacity: 1;\n    transform: none;\n  }\n  .textBlock {\n    opacity: 1;\n    transform: none;\n    transition: none;\n  }\n}\n","structuredPatch":[{"oldStart":115,"oldLines":6,"newStart":115,"newLines":13,"lines":["     opacity 250ms var(--ease-out);"," }"," ","+/* --- Responsive: scale card heights on mobile --- */","+@media (max-width: 768px) {","+  .card {","+    -