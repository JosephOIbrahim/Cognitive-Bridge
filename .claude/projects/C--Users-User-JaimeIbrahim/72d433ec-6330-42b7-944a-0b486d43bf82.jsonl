lY > 20);\n    window.addEventListener(\"scroll\", handler, { passive: true });\n    return () => window.removeEventListener(\"scroll\", handler);\n  }, []);\n\n  const isActive = (href: string) => {\n    if (href === \"/work\") return pathname === \"/\" || pathname.startsWith(\"/work\");\n    return pathname.startsWith(href);\n  };\n\n  return (\n    <nav className={`${styles.nav} ${scrolled ? styles.navScrolled : \"\"}`}>\n      {/* Left: nav links */}\n      <div className={`${styles.links} ${styles.linksLeft}`}>\n        {NAV_LINKS.map((link) => (\n          <Link key={link.href} href={link.href} className={`${styles.navLink} ${isActive(link.href) ? styles.navLinkActive : \"\"}`}>\n            {link.label}\n          </Link>\n        ))}\n      </div>\n\n      {/* Center: nameplate — full reload to replay intro */}\n      <a\n        href=\"/\"\n        className={styles.nameplate}\n        onClick={(e) => {\n          e.preventDefault();\n          try { sessionStorage.removeItem(\"jaime-intro-played\"); } catch {}\n          window.location.href = \"/\";\n        }}\n      >\n        <span className={styles.hairline} />\n        <span className={styles.nameplateText}>Jaime Ibrahim</span>\n        <span className={styles.hairline} />\n      </a>\n\n      {/* Right: social links */}\n      <div className={`${styles.links} ${styles.linksRight}`}>\n        {SOCIAL_LINKS.map((link) => (\n          <a\n            key={link.label}\n            href={link.href}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className={styles.navLink}\n          >\n            {link.label}\n          </a>\n        ))}\n      </div>\n\n      {/* Mobile menu button */}\n      <button\n        className={styles.mobileMenuBtn}\n        onClick={() => setMobileOpen(!mobileOpen)}\n        aria-label=\"Toggle menu\"\n      >\n        <span\n          className={styles.mobileMenuLine}\n          style={{\n            transform: mobileOpen ? \"rotate(45deg