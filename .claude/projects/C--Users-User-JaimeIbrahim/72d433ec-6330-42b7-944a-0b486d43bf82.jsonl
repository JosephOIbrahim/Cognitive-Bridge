n    41→  const details = detailImages(project.slug);\n    42→  const idx = PROJECTS.findIndex((p) => p.slug === project.slug);\n    43→  const prev = idx > 0 ? PROJECTS[idx - 1] : null;\n    44→  const next = idx < PROJECTS.length - 1 ? PROJECTS[idx + 1] : null;\n    45→\n    46→  return (\n    47→    <div style={{ paddingTop: \"var(--nav-h)\" }}>\n    48→      {/* Back link */}\n    49→      <div style={{ maxWidth: \"var(--max-w)\", margin: \"0 auto\", padding: \"clamp(24px, 4vh, 40px) var(--pad) 0\" }}>\n    50→        <Link href=\"/work\" className=\"link-muted\" style={{ fontSize: 13, letterSpacing: \"0.06em\", textTransform: \"uppercase\", display: \"inline-flex\", alignItems: \"center\", gap: 8 }}>\n    51→          {BackArrow}\n    52→          All Work\n    53→        </Link>\n    54→      </div>\n    55→\n    56→      {/* Header */}\n    57→      <div style={{ padding: \"clamp(32px, 6vh, 64px) var(--pad) clamp(48px, 6vh, 80px)\", maxWidth: \"var(--max-w)\", margin: \"0 auto\" }}>\n    58→        <h1 style={{ fontSize: \"clamp(36px, 4.5vw, 64px)\", fontWeight: 400, letterSpacing: \"-0.02em\", color: \"var(--text)\", margin: \"0 0 24px\", lineHeight: 1.05 }}>\n    59→          {project.title}\n    60→        </h1>\n    61→        <div style={{ display: \"flex\", gap: \"clamp(40px, 6vw, 120px)\", alignItems: \"flex-start\", flexWrap: \"wrap\" }}>\n    62→          <p style={{ fontSize: \"clamp(16px, 1.4vw, 20px)\", fontWeight: 400, color: \"var(--muted)\", lineHeight: 1.6, margin: 0, maxWidth: 540, flex: \"1 1 360px\" }}>\n    63→            {project.longDesc || project.desc}\n    64→          </p>\n    65→          <div style={{ flex: \"0 0 180px\" }}>\n    66→            {[\n    67→              { label: \"Role\", value: \"Brand Design Director\" },\n    68→              { label: \"Year\", value: project.year },\n    69→              { label: \"Discipline\", value: project.category },\n    70→              ...(project.credits ? [{ label: \"Credits\", value: