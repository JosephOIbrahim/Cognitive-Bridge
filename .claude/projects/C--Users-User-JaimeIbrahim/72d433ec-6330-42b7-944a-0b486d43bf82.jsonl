{"parentUuid":"b8248520-9946-44f2-9137-367d582e94f7","isSidechain":false,"userType":"external","cwd":"C:\\Users\\User\\JaimeIbrahim","sessionId":"72d433ec-6330-42b7-944a-0b486d43bf82","version":"2.1.45","gitBranch":"main","slug":"prancy-greeting-snail","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BVNadDWe61QGH2SXKrdjPh","type":"tool_result","content":"     1→import type { Project, GridRow, CaseStudy, Thought } from \"./types\";\n     2→\n     3→export const PROJECTS: Project[] = [\n     4→  {\n     5→    slug: \"battlebank\", title: \"Battle Bank Launch\", category: \"Identity\",\n     6→    desc: \"Visual identity for a challenger fintech brand\",\n     7→    longDesc: \"A group of experienced banking industry experts are launching a challenger bank. It was important to create an identity for the bank that stood out from the traditional banks. The mountains of Colorado were an inspiration for the bank and it was important to nod to that throughout the brand touchpoints. As the creative director overseeing the brand and identity of this project, I provided creative and art direction to a team of designers, illustrators and developers.\",\n     8→    credits: \"Creative direction\",\n     9→    heroAlt: \"Battle Bank brand identity — logo, color palette, and mountain-inspired collateral\",\n    10→    color: \"#2D5A45\", year: \"2024\", featured: true,\n    11→  },\n    12→  {\n    13→    slug: \"glg-brand\", title: \"GLG Brand Development\", category: \"Identity\",\n    14→    desc: \"Global rebrand for the world's insight network\",\n    15→    longDesc: \"As the creative director at GLG, I was tasked with bringing a visual system to life across every brand touchpoint. These include brand marketing campaigns, our website, digital ads, and internal programs. The main goal was to make sure the visual representation of GLG fit with the brand promise. Through color, iconography, photography and typography GLG came to life. In doing this work I built a team of talented designers and writers. Below are a few key projects that my team has created.\",\n    16→    credits: \"Creative direction, design\",\n    17→    heroAlt: \"GLG global rebrand — visual identity system across digital and print touchpoints\",\n    18→    color: \"#1E3A5F\", year: \"2024\", featured: true,\n    19→  },\n    20→  {\n    21→    slug: \"glg-video\", title: \"GLG Brand Manifesto Video\", category: \"Motion\",\n    22→    desc: \"Brand manifesto video for global town hall\",\n    23→    longDesc: \"As part of a company rebrand, I directed a brand manifesto video to be used at our global town hall. We wanted to introduce the new messaging and get the employees excited about GLG's visual evolution. I worked with the brand management team, an editor and voice over talent to bring this video to life.\",\n    24→    credits: \"Creative direction\",\n    25→    videoUrl: \"https://player.vimeo.com/video/570306596\",\n    26→    heroAlt: \"GLG brand manifesto video — motion graphics frames from global town hall presentation\",\n    27→    color: \"#2B4A70\", year: \"2024\",\n    28→  },\n    29→  {\n    30→    slug: \"glg-explainer\", title: \"GLG Explainer Video\", category: \"Motion\",\n    31→    desc: \"Marketing explainer for global business units\",\n    32→    longDesc: \"The marketing team was getting a lot of requests for campaigns that would explain how GLG worked. We decided to create an explainer video that our business units could use globally when working with new potential clients and council members.\",\n    33→    credits: \"Creative direction\",\n    34→    videoUrl: \"https://player.vimeo.com/video/910157740\",\n    35→    heroAlt: \"GLG explainer video — animated frames showing how the insight network works\",\n    36→    color: \"#3D5A80\", year: \"2024\",\n    37→  },\n    38→  {\n    39→    slug: \"liquidstock\", title: \"Liquid Stock Branding\", category: \"Identity\",\n    40→    desc: \"Fintech brand identity for equity solutions\",\n    41→    longDesc: \"A newly launched fintech startup was looking for a logo and identity for their brand. The company was founded in California and wanted to have their look and feel reflect their location as well as the idea of liquidity as that was what they did for their customers. The solution was a simple mark that stood out against the competition.\",\n    42→    credits: \"Creative direction and design\",\n    43→    heroAlt: \"Liquid Stock fintech brand identity — logo mark and California-inspired visual system\",\n    44→    color: \"#4A6741\", year: \"2023\", featured: true,\n    45→  },\n    46→  {\n    47→    slug: \"year-ahead\", title: \"The Year Ahead\", category: \"Design\",\n    48→    desc: \"Inaugural business summit branding\",\n    49→    longDesc: \"Branding for inaugural business summit that brought together senior executives, public sector officials and thought leaders from around the world to engage in conversations focused on the challenges, opportunities and trends facing them in the coming year. The brand would be seen throughout Chicago leading up to the event, across social media, apps, signage.\",\n    50→    credits: \"Art direction, design\",\n    51→    heroAlt: \"The Year Ahead summit branding — event signage and collateral for Chicago business summit\",\n    52→    color: \"#8B4513\", year: \"2023\", featured: true,\n    53→  },\n    54→  {\n    55→    slug: \"tiaa\", title: \"TIAA\", category: \"Design\",\n    56→    desc: \"Enterprise rebranding initiative\",\n    57→    longDesc: \"As part of a company-wide rebranding initiative the below are a few projects that stood out. A timeline installation, collateral pieces and a retirement project that spanned 30 years. After thirty years of compiling data on the habits of retirees TIAA published its findings we compiled a website that shares the data, videos of customer experiences and links to stories written about the findings.\",\n    58→    credits: \"Art direction, design\",\n    59→    videoUrl: \"https://player.vimeo.com/video/910195637\",\n    60→    heroAlt: \"TIAA enterprise rebrand — timeline installation, collateral, and retirement data project\",\n    61→    color: \"#00529B\", year: \"2023\", featured: true,\n    62→  },\n    63→  {\n    64→    slug: \"bloomberg\", title: \"Bloomberg Video Installation\", category: \"Design\",\n    65→    desc: \"Video installation for Bloomberg offices\",\n    66→    longDesc: \"A large-scale video installation created for Bloomberg's office environment, combining art direction and design to showcase the intersection of data and visual storytelling.\",\n    67→    credits: \"Art direction, design\",\n    68→    videoUrl: \"https://player.vimeo.com/video/910191569\",\n    69→    heroAlt: \"Bloomberg video installation — motion graphics for office digital displays\",\n    70→    color: \"#1A1A1A\", year: \"2022\", featured: true,\n    71→  },\n    72→  {\n    73→    slug: \"employee-brand\", title: \"Employee Brand Identity\", category: \"Design\",\n    74→    desc: \"Bloomberg summer picnic series branding\",\n    75→    longDesc: \"Bloomberg had a history of throwing a series of global summer picnics to thank the employees for all of their hard work during the year. The concept behind this particular year's summer picnic series is to celebrate the diversity and vibrance of color, combined with the energy and movement of the people. This is a visual representation of the Bloomberg employees and the company as a whole. Get in the Mix promotes joining, linking, connecting, collaborating, getting together and having fun.\",\n    76→    credits: \"Art direction and design\",\n    77→    heroAlt: \"Bloomberg employee brand — summer picnic series event identity\",\n    78→    color: \"#6B4C9A\", year: \"2022\",\n    79→  },\n    80→  {\n    81→    slug: \"opera\", title: \"The Metropolitan Opera\", category: \"Motion\",\n    82→    desc: \"Bloomberg sponsorship preview spot\",\n    83→    longDesc: \"Bloomberg was a sponsor for The Metropolitan Opera's movie theater initiative. We created this spot that focused on the combination of art and data to run as a preview before the live streaming event.\",\n    84→    credits: \"Art direction, design\",\n    85→    videoUrl: \"https://player.vimeo.com/video/910179983\",\n    86→    cropPosition: \"left center\",\n    87→    color: \"#8B2942\", year: \"2022\",\n    88→  },\n    89→  {\n    90→    slug: \"construction\", title: \"Construction Wall\", category: \"Design\",\n    91→    desc: \"Environmental mural for Bloomberg pantry\",\n    92→    longDesc: \"Bloomberg was doing some construction in the main, famous pantry area. Because the company valued design, the facilities team came to the internal creative team to create a mural to put up for the duration of the project. I worked closely with a copywriter to develop a concept that would be bold, clever and informative. There were quotes all along the wall about progress, waiting and having patience.\",\n    93→    credits: \"Design\",\n    94→    color: \"#7A7A7A\", year: \"2021\",\n    95→  },\n    96→  {\n    97→    slug: \"product-branding\", title: \"Product Brand Identity\", category: \"Design\",\n    98→    desc: \"Bloomberg wealth product branding\",\n    99→    longDesc: \"Bloomberg's wealth management division needed a cohesive brand identity across its product suite. The project encompassed stationery systems, digital touchpoints, and environmental branding that unified the product family under a sophisticated visual language.\",\n   100→    credits: \"Art direction, design\",\n   101→    color: \"#1A1A1A\", year: \"2022\",\n   102→  },\n   103→];\n   104→\n   105→export function getProject(slug: string): Project | undefined {\n   106→  return PROJECTS.find((p) => p.slug === slug);\n   107→}\n   108→\n   109→export const GRID_ROWS_HOME: GridRow[] = [\n   110→  { type: \"hero\", slugs: [\"battlebank\"], text: [true], heights: [560] },\n   111→  { type: \"wide-narrow\", slugs: [\"glg-brand\", \"glg-video\"], text: [true, true], heights: [520, 380] },\n   112→  { type: \"narrow-wide\", slugs: [\"liquidstock\", \"year-ahead\"], text: [true, true], heights: [400, 560] },\n   113→  { type: \"hero\", slugs: [\"tiaa\"], text: [true], heights: [480] },\n   114→  { type: \"wide-narrow\", slugs: [\"bloomberg\", \"employee-brand\"], text: [true, true], heights: [460, 340] },\n   115→];\n   116→\n   117→export const GRID_ROWS_ALL: GridRow[] = [\n   118→  ...GRID_ROWS_HOME,\n   119→  { type: \"narrow-wide\", slugs: [\"opera\", \"construction\"], text: [true, true], heights: [380, 520] },\n   120→  { type: \"hero\", slugs: [\"glg-explainer\"], text: [true], heights: [400] },\n   121→  { type: \"hero\", slugs: [\"product-branding\"], text: [true], heights: [480] },\n   122→];\n   123→\n   124→export const CATEGORIES = [\n   125→  \"All\", \"Identity\", \"Design\", \"Motion\",\n   126→] as const;\n   127→\n   128→export const CASE_STUDIES: Record<string, CaseStudy> = {\n   129→  battlebank: {\n   130→    sections: [\n   131→      { heading: \"The Challenge\", body: \"Battle Bank needed a visual identity that could stand up in a crowded fintech landscape while communicating trust and tenacity. The name demanded a brand that felt bold without being aggressive.\", images: 2 },\n   132→      { heading: \"Strategic Foundation\", body: \"We began with a brand audit of the competitive landscape, identifying a whitespace opportunity: most challenger banks default to either playful illustration or stark minimalism. Battle Bank could own the middle ground -- serious capability wrapped in confident energy.\", images: 1 },\n   133→      { heading: \"Visual System\", body: \"The identity centers on a custom wordmark with sharpened geometry and a supporting system of graphic devices drawn from financial charting. The color palette grounds military greens with warm neutrals and a signal accent.\", images: 3 },\n   134→    ],\n   135→  },\n   136→  \"glg-brand\": {\n   137→    sections: [\n   138→      { heading: \"A Global Platform\", body: \"GLG connects the world's professionals with the expertise they need. The rebrand needed to work across 25+ countries, dozens of industries, and thousands of daily interactions.\", images: 2 },\n   139→      { heading: \"Simplifying Complexity\", body: \"The previous identity was fragmented across business units. We unified everything under a single, confident design language that could flex without breaking.\", images: 2 },\n   140→      { heading: \"Design Language\", body: \"Clean typography, a rationalized color system, and a flexible grid that adapts from pitch decks to product interfaces. Every element earns its place.\", images: 3 },\n   141→    ],\n   142→  },\n   143→};\n   144→\n   145→export const THOUGHTS: Thought[] = [\n   146→  { slug: \"brand-systems\", title: \"Why Brand Systems Beat Brand Guidelines\", date: \"Jan 2025\", excerpt: \"Guidelines tell you what not to do. Systems tell you how to think.\" },\n   147→  { slug: \"fractional-cd\", title: \"The Case for Fractional Creative Directors\", date: \"Nov 2024\", excerpt: \"Not every company needs a full-time CD. But every brand needs creative direction.\" },\n   148→  { slug: \"visual-storytelling\", title: \"Visual Storytelling in B2B\", date: \"Sep 2024\", excerpt: \"B2B doesn't have to be boring. Here's how to bring narrative to enterprise design.\" },\n   149→  { slug: \"design-leadership\", title: \"Design Leadership Without the Title\", date: \"Jul 2024\", excerpt: \"You don't need to be a director to lead design thinking in your organization.\" },\n   150→];\n   151→\n   152→export const CLIENTS = [\n   153→  \"Bloomberg\", \"GLG\", \"TIAA\", \"American Express\", \"Martha Stewart\", \"Bailard\",\n   154→  \"JC Flowers\", \"Johnson & Johnson\", \"Sony BMG\", \"Simon & Schuster\", \"Viacom\", \"Scholastic\",\n   155→] as const;\n   156→"}]},"uuid":"5bc8836e-2332-4dea-a015-ce6940eafbb1","timestamp":"2026-02-18T01:10:34.035Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\JaimeIbrahim\\src\\lib\\projects.ts","content":"import type { Project, GridRow, CaseStudy, Thought } from \"./types\";\n\nexport const PROJECTS: Project[] = [\n  {\n    slug: \"battlebank\", title: \"Battle Bank Launch\", category: \"Identity\",\n    desc: \"Visual identity for a challenger fintech brand\",\n    longDesc: \"A group of experienced banking industry experts are launching a challenger bank. It was important to create an identity for the bank that stood out from the traditional banks. The mountains of Colorado were an inspiration for the bank and it was important to nod to that throughout the brand touchpoints. As the creative director overseeing the brand and identity of this project, I provided creative and art direction to a team of designers, illustrators and developers.\",\n    credits: \"Creative direction\",\n    heroAlt: \"Battle Bank brand identity — logo, color palette, and mountain-inspired collateral\",\n    color: \"#2D5A45\", year: \"2024\", featured: true,\n  },\n  {\n    slug: \"glg-brand\", title: \"GLG Brand Development\", category: \"Identity\",\n    desc: \"Global rebrand for the world's insight network\",\n    longDesc: \"As the creative director at GLG, I was tasked with bringing a visual system to life across every brand touchpoint. These include brand marketing campaigns, our website, digital ads, and internal programs. The main goal was to make sure the visual representation of GLG fit with the brand promise. Through color, iconography, photography and typography GLG came to life. In doing this work I built a team of talented designers and writers. Below are a few key projects that my team has created.\",\n    credits: \"Creative direction, design\",\n    heroAlt: \"GLG global rebrand — visual identity system across digital and print touchpoints\",\n    color: \"#1E3A5F\", year: \"2024\", featured: true,\n  },\n  {\n    slug: \"glg-video\", title: \"GLG Brand Manifesto Video\", category: \"Motion\",\n    desc: \"Brand manifesto video for global town hall\",\n    longDesc: \"As part of a company rebrand, I directed a brand manifesto video to be used at our global town hall. We wanted to introduce the new messaging and get the employees excited about GLG's visual evolution. I worked with the brand management team, an editor and voice over talent to bring this video to life.\",\n    credits: \"Creative direction\",\n    videoUrl: \"https://player.vimeo.com/video/570306596\",\n    heroAlt: \"GLG brand manifesto video — motion graphics frames from global town hall presentation\",\n    color: \"#2B4A70\", year: \"2024\",\n  },\n  {\n    slug: \"glg-explainer\", title: \"GLG Explainer Video\", category: \"Motion\",\n    desc: \"Marketing explainer for global business units\",\n    longDesc: \"The marketing team was getting a lot of requests for campaigns that would explain how GLG worked. We decided to create an explainer video that our business units could use globally when working with new potential clients and council members.\",\n    credits: \"Creative direction\",\n    videoUrl: \"https://player.vimeo.com/video/910157740\",\n    heroAlt: \"GLG explainer video — animated frames showing how the insight network works\",\n    color: \"#3D5A80\", year: \"2024\",\n  },\n  {\n    slug: \"liquidstock\", title: \"Liquid Stock Branding\", category: \"Identity\",\n    desc: \"Fintech brand identity for equity solutions\",\n    longDesc: \"A newly launched fintech startup was looking for a logo and identity for their brand. The company was founded in California and wanted to have their look and feel reflect their location as well as the idea of liquidity as that was what they did for their customers. The solution was a simple mark that stood out against the competition.\",\n    credits: \"Creative direction and design\",\n    heroAlt: \"Liquid Stock fintech brand identity — logo mark and California-inspired visual system\",\n    color: \"#4A6741\", year: \"2023\", featured: true,\n  },\n  {\n    slug: \"year-ahead\", title: \"The Year Ahead\", category: \"Design\",\n    desc: \"Inaugural business summit branding\",\n    longDesc: \"Branding for inaugural business summit that brought together senior executives, public sector officials and thought leaders from around the world to engage in conversations focused on the challenges, opportunities and trends facing them in the coming year. The brand would be seen throughout Chicago leading up to the event, across social media, apps, signage.\",\n    credits: \"Art direction, design\",\n    heroAlt: \"The Year Ahead summit branding — event signage and collateral for Chicago business summit\",\n    color: \"#8B4513\", year: \"2023\", featured: true,\n  },\n  {\n    slug: \"tiaa\", title: \"TIAA\", category: \"Design\",\n    desc: \"Enterprise rebranding initiative\",\n    longDesc: \"As part of a company-wide rebranding initiative the below are a few projects that stood out. A timeline installation, collateral pieces and a retirement project that spanned 30 years. After thirty years of compiling data on the habits of retirees TIAA published its findings we compiled a website that shares the data, videos of customer experiences and links to stories written about the findings.\",\n    credits: \"Art direction, design\",\n    videoUrl: \"https://player.vimeo.com/video/910195637\",\n    heroAlt: \"TIAA enterprise rebrand — timeline installation, collateral, and retirement data project\",\n    color: \"#00529B\", year: \"2023\", featured: true,\n  },\n  {\n    slug: \"bloomberg\", title: \"Bloomberg Video Installation\", category: \"Design\",\n    desc: \"Video installation for Bloomberg offices\",\n    longDesc: \"A large-scale video installation created for Bloomberg's office environment, combining art direction and design to showcase the intersection of data and visual storytelling.\",\n    credits: \"Art direction, design\",\n    videoUrl: \"https://player.vimeo.com/video/910191569\",\n    heroAlt: \"Bloomberg video installation — motion graphics for office digital displays\",\n    color: \"#1A1A1A\", year: \"2022\", featured: true,\n  },\n  {\n    slug: \"employee-brand\", title: \"Employee Brand Identity\", category: \"Design\",\n    desc: \"Bloomberg summer picnic series branding\",\n    longDesc: \"Bloomberg had a history of throwing a series of global summer picnics to thank the employees for all of their hard work during the year. The concept behind this particular year's summer picnic series is to celebrate the diversity and vibrance of color, combined with the energy and movement of the people. This is a visual representation of the Bloomberg employees and the company as a whole. Get in the Mix promotes joining, linking, connecting, collaborating, getting together and having fun.\",\n    credits: \"Art direction and design\",\n    heroAlt: \"Bloomberg employee brand — summer picnic series event identity\",\n    color: \"#6B4C9A\", year: \"2022\",\n  },\n  {\n    slug: \"opera\", title: \"The Metropolitan Opera\", category: \"Motion\",\n    desc: \"Bloomberg sponsorship preview spot\",\n    longDesc: \"Bloomberg was a sponsor for The Metropolitan Opera's movie theater initiative. We created this spot that focused on the combination of art and data to run as a preview before the live streaming event.\",\n    credits: \"Art direction, design\",\n    videoUrl: \"https://player.vimeo.com/video/910179983\",\n    cropPosition: \"left center\",\n    color: \"#8B2942\", year: \"2022\",\n  },\n  {\n    slug: \"construction\", title: \"Construction Wall\", category: \"Design\",\n    desc: \"Environmental mural for Bloomberg pantry\",\n    longDesc: \"Bloomberg was doing some construction in the main, famous pantry area. Because the company valued design, the facilities team came to the internal creative team to create a mural to put up for the duration of the project. I worked closely with a copywriter to develop a concept that would be bold, clever and informative. There were quotes all along the wall about progress, waiting and having patience.\",\n    credits: \"Design\",\n    color: \"#7A7A7A\", year: \"2021\",\n  },\n  {\n    slug: \"product-branding\", title: \"Product Brand Identity\", category: \"Design\",\n    desc: \"Bloomberg wealth product branding\",\n    longDesc: \"Bloomberg's wealth management division needed a cohesive brand identity across its product suite. The project encompassed stationery systems, digital touchpoints, and environmental branding that unified the product family under a sophisticated visual language.\",\n    credits: \"Art direction, design\",\n    color: \"#1A1A1A\", year: \"2022\",\n  },\n];\n\nexport function getProject(slug: string): Project | undefined {\n  return PROJECTS.find((p) => p.slug === slug);\n}\n\nexport const GRID_ROWS_HOME: GridRow[] = [\n  { type: \"hero\", slugs: [\"battlebank\"], text: [true], heights: [560] },\n  { type: \"wide-narrow\", slugs: [\"glg-brand\", \"glg-video\"], text: [true, true], heights: [520, 380] },\n  { type: \"narrow-wide\", slugs: [\"liquidstock\", \"year-ahead\"], text: [true, true], heights: [400, 560] },\n  { type: \"hero\", slugs: [\"tiaa\"], text: [true], heights: [480] },\n  { type: \"wide-narrow\", slugs: [\"bloomberg\", \"employee-brand\"], text: [true, true], heights: [460, 340] },\n];\n\nexport const GRID_ROWS_ALL: GridRow[] = [\n  ...GRID_ROWS_HOME,\n  { type: \"narrow-wide\", slugs: [\"opera\", \"construction\"], text: [true, true], heights: [380, 520] },\n  { type: \"hero\", slugs: [\"glg-explainer\"], text: [true], heights: [400] },\n  { type: \"hero\", slugs: [\"product-branding\"], text: [true], heights: [480] },\n];\n\nexport const CATEGORIES = [\n  \"All\", \"Identity\", \"Design\", \"Motion\",\n] as const;\n\nexport const CASE_STUDIES: Record<string, CaseStudy> = {\n  battlebank: {\n    sections: [\n      { heading: \"The Challenge\", body: \"Battle Bank needed a visual identity that could stand up in a crowded fintech landscape while communicating trust and tenacity. The name demanded a brand that felt bold without being aggressive.\", images: 2 },\n      { heading: \"Strategic Foundation\", body: \"We began with a brand audit of the competitive landscape, identifying a whitespace opportunity: most challenger banks default to either playful illustration or stark minimalism. Battle Bank could own the middle ground -- serious capability wrapped in confident energy.\", images: 1 },\n      { heading: \"Visual System\", body: \"The identity centers on a custom wordmark with sharpened geometry and a supporting system of graphic devices drawn from financial charting. The color palette grounds military greens with warm neutrals and a signal accent.\", images: 3 },\n    ],\n  },\n  \"glg-brand\": {\n    sections: [\n      { heading: \"A Global Platform\", body: \"GLG connects the world's professionals with the expertise they need. The rebrand needed to work across 25+ countries, dozens of industries, and thousands of daily interactions.\", images: 2 },\n      { heading: \"Simplifying Complexity\", body: \"The previous identity was fragmented across business units. We unified everything under a single, confident design language that could flex without breaking.\", images: 2 },\n      { heading: \"Design Language\", body: \"Clean typography, a rationalized color system, and a flexible grid that adapts from pitch decks to product interfaces. Every element earns its place.\", images: 3 },\n    ],\n  },\n};\n\nexport const THOUGHTS: Thought[] = [\n  { slug: \"brand-systems\", title: \"Why Brand Systems Beat Brand Guidelines\", date: \"Jan 2025\", excerpt: \"Guidelines tell you what not to do. Systems tell you how to think.\" },\n  { slug: \"fractional-cd\", title: \"The Case for Fractional Creative Directors\", date: \"Nov 2024\", excerpt: \"Not every company needs a full-time CD. But every brand needs creative direction.\" },\n  { slug: \"visual-storytelling\", title: \"Visual Storytelling in B2B\", date: \"Sep 2024\", excerpt: \"B2B doesn't have to be boring. Here's how to bring narrative to enterprise design.\" },\n  { slug: \"design-leadership\", title: \"Design Leadership Without the Title\", date: \"Jul 2024\", excerpt: \"You don't need to be a director to lead design thinking in your organization.\" },\n];\n\nexport const CLIENTS = [\n  \"Bloomberg\", \"GLG\", \"TIAA\", \"American Express\", \"Martha Stewart\", \"Bailard\",\n  \"JC Flowers\", \"Johnson & Johnson\", \"Sony BMG\", \"Simon & Schuster\", \"Viacom\", \"Scholastic\",\n] as const;\n","numLines":156,"startLine":1,"totalLines":156}},"sourceToolAssistantUUID":"b8248520-9946-44f2-9137-367d582e94f7"}
