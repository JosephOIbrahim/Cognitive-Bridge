   href=\"#main-content\"\n          style={{\n            position: \"absolute\",\n            left: \"-9999px\",\n            top: \"auto\",\n            width: \"1px\",\n            height: \"1px\",\n            overflow: \"hidden\",\n          }}\n        >\n          Skip to content\n        </a>\n        <IntroAnimation />\n        <GridLines animated />\n        <ScrollProgress />\n        <Nav />\n        <main id=\"main-content\" style={{ position: \"relative\", zIndex: 1 }}>\n          {children}\n        </main>\n        <Footer />\n        <GoogleAnalytics />\n        <Analytics />\n        <SpeedInsights />\n      </body>\n    </html>\n  );\n}\n","structuredPatch":[{"oldStart":85,"oldLines":17,"newStart":85,"newLines":7,"lines":["         />","       </head>","       <body>","-        <a","-          href=\"#main-content\"","-          style={{","-            position: \"absolute\",","-            left: \"-9999px\",","-            top: \"auto\",","-            width: \"1px\",","-            height: \"1px\",","-            overflow: \"hidden\",","-          }}","-        >","+        <a href=\"#main-content\" className=\"skip-link\">","           Skip to content","         </a>","         <IntroAnimation />"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"a7ab221f-4df3-4bdc-996d-e0eaf184290e"}
