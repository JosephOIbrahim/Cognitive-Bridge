st prev = idx > 0 ? PROJECTS[idx - 1] : null;\n  const next = idx < PROJECTS.length - 1 ? PROJECTS[idx + 1] : null;\n\n  return (\n    <div style={{ paddingTop: \"var(--nav-h)\" }}>\n      {/* Back link */}\n      <div style={{ maxWidth: \"var(--max-w)\", margin: \"0 auto\", padding: \"clamp(24px, 4vh, 40px) var(--pad) 0\" }}>\n        <Link href=\"/work\" className=\"link-muted\" style={{ fontSize: 13, letterSpacing: \"0.06em\", textTransform: \"uppercase\", display: \"inline-flex\", alignItems: \"center\", gap: 8 }}>\n          {BackArrow}\n          All Work\n        </Link>\n      </div>\n\n      {/* Header */}\n      <div style={{ padding: \"clamp(32px, 6vh, 64px) var(--pad) clamp(48px, 6vh, 80px)\", maxWidth: \"var(--max-w)\", margin: \"0 auto\" }}>\n        <h1 style={{ fontSize: \"clamp(36px, 4.5vw, 64px)\", fontWeight: 400, letterSpacing: \"-0.02em\", color: \"var(--text)\", margin: \"0 0 24px\", lineHeight: 1.05 }}>\n          {project.title}\n        </h1>\n        <div style={{ display: \"flex\", gap: \"clamp(40px, 6vw, 120px)\", alignItems: \"flex-start\", flexWrap: \"wrap\" }}>\n          <p style={{ fontSize: \"clamp(16px, 1.4vw, 20px)\", fontWeight: 400, color: \"var(--muted)\", lineHeight: 1.6, margin: 0, maxWidth: 540, flex: \"1 1 360px\" }}>\n            {project.longDesc || project.desc}\n          </p>\n          <div style={{ flex: \"0 0 180px\" }}>\n            {[\n              { label: \"Role\", value: \"Brand Design Director\" },\n              { label: \"Year\", value: project.year },\n              { label: \"Discipline\", value: project.category },\n              ...(project.credits ? [{ label: \"Credits\", value: project.credits }] : []),\n            ].map((item) => (\n              <div key={item.label} style={{ marginBottom: 18 }}>\n                <div style={{ fontSize: 11, color: \"var(--muted-light)\", fontWeight: 400, letterSpacing: \"0.06em\", textTransform: \"uppercase\", marginBottom: 3 }}>\n                  {item.label}\n                </div>\n                <div style={{ fontSize: 14, color: \"var(--text)\", fontWeight: 400, lineHeight: 1.4 }}>\n                  {item.value}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Hero image -- natural aspect ratio, full width */}\n      {hero && (\n        <div style={{ maxWidth: \"var(--max-w)\", margin: \"0 auto\", padding: \"0 var(--pad)\" }}>\n          <Image\n            src={hero}\n            alt={project.title}\n            width={2400}\n            height={1600}\n            style={{ width: \"100%\", height: \"auto\", borderRadius: \"var(--img-radius)\" }}\n            sizes=\"(max-width: 768px) 100vw, (max-width: 1400px) 90vw, 1400px\"\n            priority\n          />\n        </div>\n      )}\n\n      {/* Video embed */}\n      {project.videoUrl && (\n        <div style={{ maxWidth: \"var(--max-w)\", margin: \"40px auto 0\", padding: \"0 var(--pad)\" }}>\n          <div style={{ position: \"relative\", paddingBottom: \"56.25%\", height: 0, overflow: \"hidden\", borderRadius: \"var(--img-radius)\" }}>\n            <iframe\n              src={project.videoUrl}\n              style={{ position: \"absolute\", top: 0, left: 0, width: \"100%\", height: \"100%\", border: 0 }}\n              allow=\"autoplay; fullscreen; picture-in-picture\"\n              allowFullScreen\n              title={project.title}\n            />\n          </div>\n        </div>\n      )}\n\n      {/* Case study or gallery -- single column, natural aspect ratios */}\n      <div style={{ maxWidth: \"var(--max-w)\", margin: \"0 auto\", padding: \"0 var(--pad)\" }}>\n        {caseStudy ? (\n          caseStudy.sections.map((section, si) => {\n            // Compute cumulative offset from previous sections' image counts\n            const offset = caseStudy.sections\n              .slice(0, si)\n              .reduce((sum, s) => sum + (s.images || 2), 0);\n            const sectionImages = details.slice(offset, offset + (section.images || 2));\n            return (\n              <CaseStudySection key={si} section={section} sectionIndex={si} title={project.title} images={sectionImages} />\n            );\n          })\n        ) : details.length > 0 ? (\n          <ImageGallery images={details} alt={project.title} />\n        ) : null}\n      </div>\n\n      {/* Prev/Next navigation */}\n      <div style={{ maxWidth: \"var(--max-w)\", margin: \"60px auto 0\", padding: \"0 var(--pad)\", display: \"flex\", justifyContent: \"space-between\", borderTop: \"1px solid var(--border)\", paddingTop: 32 }}>\n        {prev ? (\n          <Link href={`/work/${prev.slug}`} className=\"hover-dim\" style={{ fontSize: 16, color: \"var(--text)\" }}>\n            <span style={{ fontSize: 11, color: \"var(--muted)\", letterSpacing: \"0.08em\", textTransform: \"uppercase\", display: \"block\", marginBottom: 4 }}>Previous</span>\n            {prev.title}\n          </Link>\n        ) : <div />}\n        {next ? (\n          <Link href={`/work/${next.slug}`} className=\"hover-dim\" style={{ fontSize: 16, color: \"var(--text)\", textAlign: \"right\" }}>\n            <span style={{ fontSize: 11, color: \"var(--muted)\", letterSpacing: \"0.08em\", textTransform: \"uppercase\", display: \"block\", marginBottom: 4 }}>Next</span>\n            {next.title}\n          </Link>\n        ) : <div />}\n      </div>\n\n      <div style={{ height: 60 }} />\n    </div>\n  );\n}\n","numLines":153,"startLine":1,"totalLines":153}},"sourceToolAssistantUUID":"c7183007-db93-4be3-a34e-f030ae38bd79"}
