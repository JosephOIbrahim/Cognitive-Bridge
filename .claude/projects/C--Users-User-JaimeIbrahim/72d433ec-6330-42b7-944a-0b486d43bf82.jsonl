5→          .filter((i) => i !== -1);\n    46→\n    47→        if (filtered.length === 0) return null;\n    48→\n    49→        return {\n    50→          ...row,\n    51→          type:\n    52→            filtered.length === 1\n    53→              ? (\"hero\" as GridRowType)\n    54→              : filtered.length === 2 && row.type === \"triple\"\n    55→                ? (\"wide-narrow\" as GridRowType)\n    56→                : row.type,\n    57→          slugs: filtered.map((i) => row.slugs[i]),\n    58→          text: filtered.map((i) => row.text[i]),\n    59→          heights: filtered.map((i) => row.heights[i]),\n    60→        };\n    61→      })\n    62→      .filter((row): row is GridRow => row !== null);\n    63→  }, [rows, filterCategory]);\n    64→\n    65→  return (\n    66→    <div className={styles.container}>\n    67→      {filteredRows.map((row, ri) => (\n    68→        <div\n    69→          key={ri}\n    70→          className={`${styles.row} ${responsiveClass(row.type)}`}\n    71→          style={{ gridTemplateColumns: colsFor(row.type) }}\n    72→        >\n    73→          {row.slugs.map((slug, si) => {\n    74→            const project = PROJECT_MAP.get(slug);\n    75→            if (!project) return null;\n    76→            return (\n    77→              <GridCard\n    78→                key={slug}\n    79→                project={project}\n    80→                showText={row.text[si]}\n    81→                height={row.heights[si]}\n    82→                columnIndex={si}\n    83→              />\n    84→            );\n    85→          })}\n    86→        </div>\n    87→      ))}\n    88→    </div>\n    89→  );\n    90→}\n    91→"}]},"uuid":"406a297b-a345-419c-a38f-c1eb77b889f9","timestamp":"2026-02-18T01:10:27.340Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\User\\JaimeIbrahim\\src\\components\\EditorialGrid.tsx","content":"\"use client\";\n\nimport { useMemo } from \"react\";\nimport { GridCard } from \"./GridCard\";\nimport { PROJECTS } from \"@/lib/projects\";\nimport type { GridRow, GridRowType } from \"@/lib/types\";\nimport styles from \"./EditorialGrid.module.css\";\n\nconst PROJECT_MAP = new Map(PROJECTS.map((p) => [p.slug, p]));\n\nfunction colsFor(type: GridRowType): string {\n  switch (type) {\n    case \"wide-narrow\":\n      return \"2fr 1fr\";\n    case \"narrow-wide\":\n      return \"1fr 2fr\";\n    case \"triple\":\n      return \"1fr 1fr 1fr\";\n    default:\n      return \"1fr\";\n  }\n}\n\nfunction responsiveClass(type: GridRowType): string {\n  if (type === \"triple\") return \"grid-triple\";\n  if (type === \"wide-narrow\" || type === \"narrow-wide\") return \"grid-pair\";\n  return \"\";\n}\n\ninterface EditorialGridProps {\n  rows: GridRow[];\n  filterCategory?: string;\n}\n\nexport function EditorialGrid({ rows, filterCategory = \"All\" }: EditorialGridProps) {\n  const filteredRows = useMemo(() => {\n    if (filterCategory === \"All\") return rows;\n    return rows\n      .map((row) => {\n        const filtered = row.slugs\n          .map((slug, i) => {\n            const p = PROJECT_MAP.get(slug);\n            return p && p.category === filterCategory ? i : -1;\n          })\n          .filter((i) => i !== -1);\n\n        if (filtered.length === 0) return null;\n\n        return {\n          ...row,\n          type:\n            filtered.length === 1\n              ? (\"hero\" as GridRowType)\n              : filtered.length === 2 && row.type === \"triple\"\n                ? (\"wide-narrow\" as GridRowType)\n                : row.type,\n          slugs: filtered.map((i) => row.slugs[i]),\n          text: filtered.map((i) => row.text[i]),\n          heights: filtered.map((i) => row.heights[i]),\n        };\n      })\n      .filter((row): row is GridRow => row !== null);\n  }, [rows, filterCategory]);\n\n  return (\n    <div className={styles.container}>\n      {filteredRows.map((row, ri) => (\n        <div\n          key={ri}\n          className={`${styles.row} ${responsiveClass(row.type)}`}\n          style={{ gridTemplateColumns: colsFor(row.type) }}\n        >\n          {row.slugs.map((slug, si) => {\n            const project = PROJECT_MAP.get(slug);\n            if (!project) return null;\n            return (\n              <GridCard\n                key={slug}\n                project={project}\n                showText={row.text[si]}\n                height={row.heights[si]}\n                columnIndex={si}\n              />\n            );\n          })}\n        </div>\n      ))}\n    </div>\n  );\n}\n","numLines":91,"startLine":1,"totalLines":91}},"sourceToolAssistantUUID":"367a4c2d-fcbb-45e7-ad6d-cc7ab4cba13c"}
