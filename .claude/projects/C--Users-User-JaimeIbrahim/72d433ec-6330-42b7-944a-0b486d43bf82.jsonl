 42→  const caseStudy = CASE_STUDIES[project.slug];\n    43→  const hero = heroImage(project.slug);\n    44→  const details = detailImages(project.slug);\n    45→  const idx = PROJECTS.findIndex((p) => p.slug === project.slug);\n    46→  const prev = idx > 0 ? PROJECTS[idx - 1] : null;\n    47→  const next = idx < PROJECTS.length - 1 ? PROJECTS[idx + 1] : null;\n    48→\n    49→  return (\n    50→    <div style={{ paddingTop: \"var(--nav-h)\" }}>\n    51→      {/* Back link */}\n    52→      <div style={{ maxWidth: \"var(--max-w)\", margin: \"0 auto\", padding: \"clamp(24px, 4vh, 40px) var(--pad) 0\" }}>\n    53→        <Link href=\"/work\" className=\"link-muted\" style={{ fontSize: 13, letterSpacing: \"0.06em\", textTransform: \"uppercase\", display: \"inline-flex\", alignItems: \"center\", gap: 8 }}>\n    54→          {BackArrow}\n    55→          All Work\n    56→        </Link>\n    57→      </div>\n    58→\n    59→      {/* Header */}\n    60→      <div style={{ padding: \"clamp(32px, 6vh, 64px) var(--pad) clamp(48px, 6vh, 80px)\", maxWidth: \"var(--max-w)\", margin: \"0 auto\" }}>\n    61→        <h1 style={{ fontSize: \"clamp(36px, 4.5vw, 64px)\", fontWeight: 400, letterSpacing: \"-0.02em\", color: \"var(--text)\", margin: \"0 0 24px\", lineHeight: 1.05 }}>\n    62→          {project.title}\n    63→        </h1>\n    64→        <div style={{ display: \"flex\", gap: \"clamp(40px, 6vw, 120px)\", alignItems: \"flex-start\", flexWrap: \"wrap\" }}>\n    65→          <p style={{ fontSize: \"clamp(16px, 1.4vw, 20px)\", fontWeight: 400, color: \"var(--muted)\", lineHeight: 1.6, margin: 0, maxWidth: 540, flex: \"1 1 360px\" }}>\n    66→            {project.longDesc || project.desc}\n    67→          </p>\n    68→          <div style={{ flex: \"0 0 180px\" }}>\n    69→            {[\n    70→              { label: \"Role\", value: \"Brand Design Director\" },\n    71→              { label: \"Discipline\", value: project.category },\n    72→              ...(project.credits ? [{ label: \"Credits\", value: project.credits }] : []),\n    73→            ].map((item) => (\n    74→              <div key={item.label} style={{ marginBottom: 18 }}>\n    75→                <div style={{ fontSize: 11, color: \"var(--muted-light)\", fontWeight: 400, letterSpacing: \"0.06em\", textTransform: \"uppercase\", marginBottom: 3 }}>\n    76→                  {item.label}\n    77→                </div>\n    78→                <div style={{ fontSize: 14, color: \"var(--text)\", fontWeight: 400, lineHeight: 1.4 }}>\n    79→                  {item.value}\n    80→                </div>\n    81→              </div>\n    82→            ))}\n    83→          </div>\n    84→        </div>\n    85→      </div>\n    86→\n    87→      {/* Hero image -- natural aspect ratio, full width */}\n    88→      {hero && (\n    89→        <div style={{ maxWidth: \"var(--max-w)\", margin: \"0 auto\", padding: \"0 var(--pad)\" }}>\n    90→          <Image\n    91→            src={hero}\n    92→            alt={project.heroAlt || project.title}\n    93→            width={2400}\n    94→            height={1600}\n    95→            style={{ width: \"100%\", height: \"auto\", borderRadius: \"var(--img-radius)\" }}\n    96→            sizes=\"(max-width: 768px) 100vw, (max-width: 1400px) 90vw, 1400px\"\n    97→            priority\n    98→          />\n    99→        </div>\n   100→      )}\n   101→\n   102→      {/* Video embed */}\n   103→      {project.videoUrl && (\n   104→        <div style={{ maxWidth: \"var(--max-w)\", margin: \"40px auto 0\", padding: \"0 var(--pad)\" }}>\n   105→          <div style={{ position: \"relative\", paddingBottom: \"56.25%\", height: 0, overflow: \"hidden\", borderRadius: \"var(--img-radius)\" }}>\n   106→            <iframe\n   107→              src={project.videoUrl}\n   108→              style={{ position: \"absolute\", top: 0, left: 0, width: \"100%\", height: \"100%\", border: 0 }}\n   109→              allow=\"autoplay; fullscreen; pict