jectionState()\n    if args.profile and args.profile != \"none\":\n        state.activate(args.profile)\n        for _ in range(5):\n            state.advance_exchange()\n\n    pipeline = LosslessPipeline(root, state)\n    result = pipeline.convert()\n\n    if args.dry_run:\n        sys.stdout.write(result.markdown)\n    else:\n        write_claude_md(result, output)\n        print(f\"Generated {output}\")\n        print(f\"  Profile: {result.profile_name}\")\n        print(f\"  Clean hash: {result.clean.clean_hash[:16]}...\")\n        print(f\"  Anchor hash: {result.clean.anchor_hash[:16]}...\")\n\n\ndef cmd_verify(args):\n    paths = get_default_paths()\n    target = Path(args.file) if args.file else paths[\"output\"]\n\n    if not target.exists():\n        print(f\"File not found: {target}\", file=sys.stderr)\n        sys.exit(1)\n\n    text = target.read_text(encoding='utf-8')\n    result = verify_integrity_block(text)\n\n    if result[\"valid\"]:\n        print(\"Integrity block: VALID\")\n        for k, v in sorted(result[\"fields\"].items()):\n            print(f\"  {k}: {v}\")\n        if result.get(\"fidelity_ok\"):\n            print(\"  Fidelity: OK (1.0)\")\n        else:\n            print(\"  Fidelity: FAILED\")\n    else:\n        print(\"Integrity block: NOT FOUND or INVALID\")\n        sys.exit(1)\n\n\ndef cmd_diff(args):\n    paths = get_default_paths()\n    root = Path(args.root) if args.root else paths[\"root\"]\n    output = Path(args.output) if args.output else paths[\"output\"]\n\n    state = InjectionState()\n    pipeline = LosslessPipeline(root, state)\n    result = pipeline.convert()\n    diff = diff_claude_md(result, output)\n\n    if diff:\n        print(diff)\n    else:\n        print(\"No changes.\")\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"Lossless converter CLI\")\n    sub = ap.add_subparsers(dest=\"command\")\n\n    compile_p = sub.add_parser(\"compile\", help=\"Compile USDA to CLAUDE.md\")\n    compile_p.add_argument(\"--profile\", default=\"none\")\n    compile_p.add_argument(\"--root\", default=\"\")\n    compile_p.add_argument(\"--output\", default=\"\")\n    compile_p.add_argument(\"--dry-run\", action=\"store_true\")\n\n    verify_p = sub.add_parser(\"verify\", help=\"Verify integrity block\")\n    verify_p.add_argument(\"--file\", default=\"\")\n\n    diff_p = sub.add_parser(\"diff\", help=\"Show diff vs current\")\n    diff_p.add_argument(\"--root\", default=\"\")\n    diff_p.add_argument(\"--output\", default=\"\")\n\n    args = ap.parse_args()\n\n    if args.command == \"compile\":\n        cmd_compile(args)\n    elif args.command == \"verify\":\n        cmd_verify(args)\n    elif args.command == \"diff\":\n        cmd_diff(args)\n    else:\n        ap.print_help()\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":116,"startLine":1,"totalLines":116}},"sourceToolAssistantUUID":"3cb36be0-5d3f-4b43-86fb-f7624794046d"}
