# 4. Get Blueprint components
section("4. Inspect Blueprint Components")
r = ue.execute_python(f"""
import unreal, json

bp = unreal.EditorAssetLibrary.load_asset("{bp_path}")
if bp:
    scs = bp.get_editor_property("simple_construction_script")
    nodes = scs.get_all_nodes() if scs else []
    components = []
    for node in nodes:
        template = node.get_editor_property("component_template")
        if template:
            components.append({{
                "name": node.get_editor_property("internal_variable_name"),
                "class": template.get_class().get_name(),
            }})
    parent = bp.get_editor_property("parent_class")
    parent_name = parent.get_name() if parent else "None"
    print("RESULT:" + json.dumps({{
        "blueprint": "{bp_path}",
        "parent_class": parent_name,
        "components": components
    }}))
else:
    print("RESULT:{{\\"error\\": \\"BP not found\\"}}")
""")
print(f"  Result: {json.dumps(r['result'], indent=4)}")
print(f"  Error:  {r['error']}")

# 5. Set component property (assign cube mesh)
section("5. Set Mesh on StaticMeshComponent")
r = ue.execute_python(f"""
import unreal, json

bp = unreal.EditorAssetLibrary.load_asset("{bp_path}")
if bp:
    scs = bp.get_editor_property("simple_construction_script")
    nodes = scs.get_all_nodes() if scs else []
    for node in nodes:
        var_name = node.get_editor_property("internal_variable_name")
        if var_name == "CubeMesh":
            template = node.get_editor_property("component_template")
            cube = unreal.EditorAssetLibrary.load_asset("/Engine/BasicShapes/Cube")
            if template and cube:
                template.set_editor_property("static_mesh", cube)
                unreal.KismetEditorUtilities.compile_blueprint(bp)
                unreal.EditorAssetLibrary.save_asset("{bp_path}")
                print("RESULT:{{\\"set_mesh\\": true}}")
            else:
                print("RESULT:{{\\"error\\": \\"template or cube not found\\"}}")
            break
    else:
        print("RESULT:{{\\"error\\": \\"CubeMesh component not found\\"}}")
else:
    print("RESULT:{{\\"error\\": \\"BP not found\\"}}")
""")
print(f"  Result: {r['result']}")
print(f"  Error:  {r['error']}")

