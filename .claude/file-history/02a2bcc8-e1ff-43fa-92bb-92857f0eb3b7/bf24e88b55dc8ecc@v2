# 2. Add StaticMeshComponent
section("2. Add StaticMeshComponent")
r = ue.execute_python(f"""
import unreal, json

bp = unreal.EditorAssetLibrary.load_asset("{bp_path}")
if bp:
    scs = bp.get_editor_property("simple_construction_script")
    node = scs.create_node(unreal.StaticMeshComponent, "CubeMesh")
    if node:
        root = scs.get_default_scene_root_node()
        if root and node != root:
            scs.add_node_to(node, root)
        unreal.KismetEditorUtilities.compile_blueprint(bp)
        unreal.EditorAssetLibrary.save_asset("{bp_path}")
        print("RESULT:{{\\"added\\": \\"CubeMesh\\"}}")
    else:
        print("RESULT:{{\\"error\\": \\"create_node failed\\"}}")
else:
    print("RESULT:{{\\"error\\": \\"BP not found\\"}}")
""")
print(f"  Result: {r['result']}")
print(f"  Error:  {r['error']}")

