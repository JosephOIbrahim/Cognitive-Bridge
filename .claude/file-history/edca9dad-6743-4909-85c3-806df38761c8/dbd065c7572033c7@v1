# ---------------------------------------------------------------------------
# Metadata generation
# ---------------------------------------------------------------------------

def build_semantic_entry(file_key, entries):
    """Build a semantic_index.json entry for one topic."""
    config = next(r for r in FILE_ROUTES if r["key"] == file_key)

    # Collect all unique functions across entries for the description
    all_funcs = set()
    for e in entries:
        all_funcs.update(e.get("vex_functions", []))
    func_list = ", ".join(sorted(all_funcs)[:20])

    return {
        "summary": config["title"],
        "description": f"{config['desc']} Covers functions: {func_list}.",
        "keywords": TOPIC_KEYWORDS.get(file_key, ["joy_of_vex"]),
        "reference_file": file_key,
    }


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Export Joy of VEX dataset to Synapse RAG format."
    )
    parser.add_argument(
        "--synapse-rag",
        type=Path,
        default=DEFAULT_SYNAPSE_RAG,
        help="Path to Synapse/rag/ directory",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print what would be written without writing files",
    )
    args = parser.parse_args()

    synapse_rag = args.synapse_rag
    skills_dir = synapse_rag / SKILLS_DIR
    metadata_dir = synapse_rag / METADATA_DIR
    semantic_path = metadata_dir / "semantic_index.json"
    relevance_path = metadata_dir / "agent_relevance_map.json"

    # -- Load JSONL ----------------------------------------------------------
    print(f"Reading {INPUT_JSONL} ...")
    records = []
    with open(INPUT_JSONL, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                records.append(json.loads(line))
    print(f"  Loaded {len(records)} records")

    # -- Quality filter ------------------------------------------------------
    quality_records = [r for r in records if passes_quality(r)]
    print(f"  After quality filter: {len(quality_records)} records")

    # -- Deduplicate ---------------------------------------------------------
    deduped = deduplicate(quality_records)
    print(f"  After dedup: {len(deduped)} unique records")

    # -- Route to files ------------------------------------------------------
    file_buckets = defaultdict(list)
    for r in deduped:
        target = route_record(r)
        file_buckets[target].append(r)

    # Sort entries within each bucket by episode, then timestamp, then ID
    for key in file_buckets:
        file_buckets[key].sort(key=lambda r: (
            r.get("episode", 999),
            r.get("timestamp", "99:99"),
            r.get("id", ""),
        ))

    # -- Per-file cap --------------------------------------------------------
    for key in file_buckets:
        bucket = file_buckets[key]
        if len(bucket) > MAX_ENTRIES_PER_FILE:
            # Keep entries with longest explanations (He2025: stable sort)
            bucket.sort(key=lambda r: -len(r.get("explanation", "")))
            file_buckets[key] = sorted(
                bucket[:MAX_ENTRIES_PER_FILE],
                key=lambda r: (
                    r.get("episode", 999),
                    r.get("timestamp", "99:99"),
                    r.get("id", ""),
                ),
            )

    # -- Summary -------------------------------------------------------------
    total_entries = sum(len(v) for v in file_buckets.values())
    print(f"\nRouting summary ({total_entries} total entries across {len(file_buckets)} files):")
    for route in FILE_ROUTES:
        key = route["key"]
        count = len(file_buckets.get(key, []))
        print(f"  {key}: {count} entries")

    # -- Generate markdown files ---------------------------------------------
    print(f"\nWriting markdown files to {skills_dir}/ ...")
    for route in FILE_ROUTES:
        key = route["key"]
        entries = file_buckets.get(key, [])
        if not entries:
            print(f"  SKIP {key}.md (0 entries)")
            continue

        md_content = generate_markdown(key, entries)
        md_path = skills_dir / f"{key}.md"
        line_count = md_content.count("\n") + 1

        if args.dry_run:
            print(f"  [DRY RUN] Would write {md_path.name} ({line_count} lines, {len(entries)} entries)")
        else:
            md_path.parent.mkdir(parents=True, exist_ok=True)
            with open(md_path, "w", encoding="utf-8") as f:
                f.write(md_content)
            print(f"  Wrote {md_path.name} ({line_count} lines, {len(entries)} entries)")

    # -- Merge semantic_index.json -------------------------------------------
    print(f"\nUpdating {semantic_path} ...")
    if semantic_path.exists():
        with open(semantic_path, encoding="utf-8") as f:
            semantic_index = json.loads(f.read())
    else:
        semantic_index = {}

    existing_count = len(semantic_index)
    new_topics = 0
    for route in FILE_ROUTES:
        key = route["key"]
        entries = file_buckets.get(key, [])
        if not entries:
            continue
        if key not in semantic_index:
            new_topics += 1
        semantic_index[key] = build_semantic_entry(key, entries)

    if args.dry_run:
        print(f"  [DRY RUN] Would add {new_topics} new topics ({existing_count} -> {len(semantic_index)})")
    else:
        with open(semantic_path, "w", encoding="utf-8") as f:
            json.dump(semantic_index, f, indent=2, sort_keys=False, ensure_ascii=False)
            f.write("\n")
        print(f"  Added {new_topics} new topics ({existing_count} -> {len(semantic_index)})")

    # -- Merge agent_relevance_map.json --------------------------------------
    print(f"\nUpdating {relevance_path} ...")
    if relevance_path.exists():
        with open(relevance_path, encoding="utf-8") as f:
            relevance_map = json.loads(f.read())
    else:
        relevance_map = {}

    existing_count = len(relevance_map)
    new_entries = 0
    for route in FILE_ROUTES:
        key = route["key"]
        entries = file_buckets.get(key, [])
        if not entries:
            continue
        if key not in relevance_map:
            new_entries += 1
        relevance_map[key] = "sop_agent"

    if args.dry_run:
        print(f"  [DRY RUN] Would add {new_entries} new entries ({existing_count} -> {len(relevance_map)})")
    else:
        with open(relevance_path, "w", encoding="utf-8") as f:
            json.dump(relevance_map, f, indent=2, sort_keys=False, ensure_ascii=False)
            f.write("\n")
        print(f"  Added {new_entries} new entries ({existing_count} -> {len(relevance_map)})")

    # -- Done ----------------------------------------------------------------
    if args.dry_run:
        print("\n[DRY RUN] No files written. Re-run without --dry-run to apply.")
    else:
        print(f"\nDone. {total_entries} entries exported to {len(file_buckets)} files.")
        print("Run 'python -m pytest Synapse/tests/test_knowledge.py -v' to verify.")


if __name__ == "__main__":
    main()
