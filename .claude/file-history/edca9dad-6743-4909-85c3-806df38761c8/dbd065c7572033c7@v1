# Sets used for routing decisions
_QUAT_FUNCS = {"quaternion", "qrotate", "slerp", "qmultiply", "qinvert",
               "eulertoquaternion", "dihedral", "@orient", "maketransform"}
_TRIG_FUNCS = {"sin", "cos", "tan", "asin", "acos", "atan", "atan2", "radians", "degrees"}
_SURFACE_FUNCS = {"primuv", "xyzdist", "minpos", "uvsample", "primduv"}
_PCOPEN_FUNCS = {"pcopen", "pcfilter", "pciterate", "pcimport", "pcclose",
                 "pcnumfound", "pcfarthest"}
_NEARPOINT_FUNCS = {"nearpoint", "nearpoints", "pcfind", "pcfind_radius",
                    "neighbours", "neighbor"}
_CREATION_FUNCS = {"addpoint", "addprim", "addvertex", "removepoint", "removeprim"}
_NOISE_FUNCS = {"noise", "snoise", "xnoise", "curlnoise", "onoise",
                "flownoise", "vnoise", "random", "rand", "nrandom"}
_SMALL_CATS = {"simulation", "arrays", "debugging", "optimization",
               "groups_and_selection", "animation", "other", "strings", "volumes"}


def route_record(record):
    """Return the target file key for a record. He2025 deterministic."""
    cat = record.get("category", "other")
    funcs = set(record.get("vex_functions", []))
    funcs_lower = {f.lower() for f in funcs}
    code = record.get("code", "")

    # Small categories -> tips
    if cat in _SMALL_CATS:
        return "joy_of_vex_tips"

    if cat == "math_operations":
        if funcs & _QUAT_FUNCS or "@orient" in code:
            return "joy_of_vex_quaternions"
        if funcs & _TRIG_FUNCS:
            return "joy_of_vex_trigonometry"
        return "joy_of_vex_vector_math"

    if cat == "geometry_manipulation":
        if funcs & _SURFACE_FUNCS:
            return "joy_of_vex_surface_sampling"
        # Animated deformation: uses sin/cos AND modifies @P
        if (funcs & _TRIG_FUNCS) and ("@P" in code):
            return "joy_of_vex_deformation"
        # Ramp-driven deformation
        if "chramp" in code and ("@P" in code):
            return "joy_of_vex_deformation"
        return "joy_of_vex_geometry"

    if cat == "point_clouds":
        if funcs & _PCOPEN_FUNCS:
            return "joy_of_vex_pcopen"
        return "joy_of_vex_nearpoints"

    if cat == "color":
        return "joy_of_vex_color"

    if cat == "ui_and_parameters":
        return "joy_of_vex_ramps"

    if cat == "attributes":
        return "joy_of_vex_attribs"

    if cat == "geometry_creation":
        return "joy_of_vex_geometry_creation"

    if cat == "flow_control":
        return "joy_of_vex_flow_control"

    if cat == "noise_and_randomness":
        return "joy_of_vex_noise"

    # Fallback
    return "joy_of_vex_tips"


# ---------------------------------------------------------------------------
# Deduplication (He2025 deterministic)
# ---------------------------------------------------------------------------

def normalize_code(code):
    """Normalize VEX code for dedup: strip whitespace, collapse to single line."""
    lines = code.strip().splitlines()
    # Remove blank lines, strip each line, rejoin
    cleaned = " ".join(line.strip() for line in lines if line.strip())
    # Collapse multiple spaces
    cleaned = re.sub(r"\s+", " ", cleaned)
    return cleaned


def deduplicate(records):
    """Group by normalized code, keep the record with longest explanation.
    Ties broken by lowest episode, then lowest ID (He2025 deterministic)."""
    groups = defaultdict(list)
    for r in records:
        key = normalize_code(r.get("code", ""))
        groups[key].append(r)

    deduped = []
    for key, group in sorted(groups.items()):
        # Sort: longest explanation first, then lowest episode, then lowest ID
        group.sort(key=lambda r: (
            -len(r.get("explanation", "")),
            r.get("episode", 999),
            r.get("id", "zzz"),
        ))
        deduped.append(group[0])

    # Sort final output deterministically by ID
    deduped.sort(key=lambda r: r.get("id", ""))
    return deduped


# ---------------------------------------------------------------------------
# Quality filter
# ---------------------------------------------------------------------------

def passes_quality(record):
    """Check minimum quality thresholds."""
    explanation = record.get("explanation", "")
    code = record.get("code", "").strip()
    if len(explanation) < MIN_EXPLANATION_LEN:
        return False
    if len(code) < MIN_CODE_LEN:
        return False
    return True


# ---------------------------------------------------------------------------
# Markdown generation
