def format_timestamp_link(record):
    """Format a YouTube timestamp link."""
    url = record.get("youtube_url", "")
    ts = record.get("timestamp", "")
    ep = record.get("episode", "?")
    if url:
        return f"[Ep{ep}, {ts}]({url})"
    return f"Ep{ep}, {ts}"


def format_entry(record):
    """Format a single record as a markdown section."""
    topic = record.get("topic", "Untitled")
    code = record.get("code", "").strip()
    explanation = record.get("explanation", "")
    needs_review = record.get("needs_review", False)
    ts_link = format_timestamp_link(record)

    badge = " [Needs Review]" if needs_review else ""
    lines = []
    lines.append(f"### {topic}{badge} [{ts_link}]")
    lines.append("```vex")
    lines.append(code)
    lines.append("```")
    lines.append(explanation)
    lines.append("")
    return "\n".join(lines)


def generate_markdown(file_key, entries):
    """Generate a complete markdown file for a topic."""
    # Find the route config
    config = next(r for r in FILE_ROUTES if r["key"] == file_key)
    title = config["title"]

    lines = []
    lines.append(f"# {title}")
    lines.append("")
    lines.append("> Tutorial examples from The Joy of VEX video series by Matt Estela.")
    lines.append("> Source: https://www.youtube.com/@MattEstela")
    lines.append("")

    # Group entries by subcategory for readability
    # Use a simple grouping by the first function or a broad topic
    current_section = None
    for entry in entries:
        section = _infer_section(entry, file_key)
        if section != current_section:
            lines.append(f"## {section}")
            lines.append("")
            current_section = section
        lines.append(format_entry(entry))

    return "\n".join(lines)


def _infer_section(record, file_key):
