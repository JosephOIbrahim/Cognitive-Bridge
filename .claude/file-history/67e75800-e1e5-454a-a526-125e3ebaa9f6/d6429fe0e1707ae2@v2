            "class_type": "OldNode",
            "inputs": {"old_param": 42, "keep_me": "yes"},
        }
        input_mapping = [
            {"new_id": "new_param", "old_id": "old_param"},
        ]
        patches = _build_migration_patches(
            "1", node_data, "NewNode", input_mapping, [], {}
        )
        # Should have class_type patch + inputs patch
        assert len(patches) == 2
        inputs_patch = patches[1]
        assert inputs_patch["path"] == "/1/inputs"
        new_inputs = inputs_patch["value"]
        assert new_inputs["new_param"] == 42
        assert new_inputs["keep_me"] == "yes"  # preserved

    def test_set_value_mapping(self):
