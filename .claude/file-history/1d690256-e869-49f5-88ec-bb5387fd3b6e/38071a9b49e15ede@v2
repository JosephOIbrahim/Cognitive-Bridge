"""Simple render farm test: render 3 frames, validate each, report."""
import hou
import os
import time
import tempfile

outdir = os.path.join(tempfile.gettempdir(), "synapse_farm")
os.makedirs(outdir, exist_ok=True)

rop = hou.node("/out/test_render")
rop.parm("soho_foreground").set(1)

results = []
total_t0 = time.time()

for frame in range(1, 4):
    hou.setFrame(frame)
    outpath = outdir.replace("\\", "/") + "/frame_{:04d}.jpg".format(frame)
    rop.parm("outputimage").set(outpath)

    t0 = time.time()
    try:
        rop.render(frame_range=(frame, frame))
        dt = time.time() - t0
        exists = os.path.exists(outpath)
        size = os.path.getsize(outpath) if exists else 0
        results.append("Frame {}: OK {:.1f}s {}bytes".format(frame, dt, size))
    except Exception as e:
        dt = time.time() - t0
        results.append("Frame {}: FAIL {:.1f}s {}".format(frame, dt, str(e)[:80]))

total_dt = time.time() - total_t0

# List output files
files = sorted(os.listdir(outdir))
result = "Render farm test: {:.1f}s total\n".format(total_dt) + "\n".join(results) + "\nFiles: " + str(files)
