#!/bin/bash
set -e

# Set up PATH for Windows (ffmpeg, tesseract, yt-dlp)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/env_setup.sh" ]; then
    source "$SCRIPT_DIR/env_setup.sh"
fi

echo "============================================"
echo " VEX Tutorial RAG Pipeline"
echo " Target: The Joy of VEX by Matt Estela"
echo "============================================"
echo ""

PLAYLIST_URL="${1:-https://www.youtube.com/playlist?list=PLTXmnikJEYnBtSfn4LwKx5vpopwrInp18}"
TRANSCRIPT_FILE="${2:-}"  # Optional: path to bulk transcript file

echo "Playlist: $PLAYLIST_URL"
[ -n "$TRANSCRIPT_FILE" ] && echo "Transcript: $TRANSCRIPT_FILE"
echo ""

# Stage 1: Download
echo "=== STAGE 1: Downloading videos + subtitles ==="
python scripts/01_download.py "$PLAYLIST_URL"
echo ""

# Stage 2: Extract frames
echo "=== STAGE 2: Extracting frames ==="
python scripts/02_extract_frames.py
echo ""

# Stage 3: Detect code frames
echo "=== STAGE 3: Detecting code frames ==="
python scripts/03_detect_code_frames.py
echo ""

# CHECKPOINT: Pause for human verification
echo ""
echo "========================================================"
echo "  CHECKPOINT: Verify code frame detection"
echo ""
echo "  Open data/code_frames/ and visually check that the"
echo "  detected frames actually show VEX code."
echo ""
echo "  If detection is off, adjust parameters in"
echo "  scripts/03_detect_code_frames.py and re-run Stage 3."
echo "========================================================"
echo ""
read -p "Press Enter to continue (or Ctrl+C to stop and adjust)..."
echo ""

# Stage 4: OCR
echo "=== STAGE 4: OCR on code frames ==="
python scripts/04_ocr_code.py
echo ""

# Stage 5: Process transcripts
echo "=== STAGE 5: Processing transcripts ==="
if [ -n "$TRANSCRIPT_FILE" ]; then
    python scripts/05_process_transcripts.py --transcript "$TRANSCRIPT_FILE"
else
    python scripts/05_process_transcripts.py
fi
echo ""

# Stage 6: Align
echo "=== STAGE 6: Temporal alignment ==="
python scripts/06_align.py
echo ""

# Stage 7: LLM Structuring
echo "=== STAGE 7: LLM structuring (requires ANTHROPIC_API_KEY) ==="
if [ -z "$ANTHROPIC_API_KEY" ]; then
    echo "ERROR: ANTHROPIC_API_KEY not set."
    echo "Export it: export ANTHROPIC_API_KEY=sk-ant-..."
    exit 1
fi
python scripts/07_structure_jsonl.py
echo ""

# Stage 8: Validate + Assemble
echo "=== STAGE 8: Validation + final assembly ==="
python scripts/08_validate_and_assemble.py
echo ""

echo "============================================"
echo " Pipeline complete!"
echo ""
echo " Outputs:"
echo "   output/joy_of_vex_rag.jsonl         <- RAG dataset"
echo "   output/joy_of_vex_reference.md      <- Human reference"
echo "   output/joy_of_vex_functions.json    <- Function index"
echo "   output/validation_report.json       <- QA report"
echo "============================================"
