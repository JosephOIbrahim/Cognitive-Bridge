.card {
  cursor: pointer;
  display: block;
}

.imageContainer {
  border-radius: var(--img-radius);
  overflow: hidden;
  position: relative;
}

/* --- Domino reveal (IO-triggered) --- */

.imageInner {
  clip-path: inset(0 0 100% 0);
  opacity: 0;
  transform: scale(1.05);
  transition:
    clip-path 700ms var(--ease-out) var(--reveal-delay, 0ms),
    opacity 600ms var(--ease-out) var(--reveal-delay, 0ms),
    transform 800ms var(--ease-out) var(--reveal-delay, 0ms);
}

.cardRevealed .imageInner {
  clip-path: inset(0 0 0% 0);
  opacity: 1;
  transform: scale(1);
}

.textBlock {
  margin-top: 14px;
  padding-bottom: 0;
  opacity: 0;
  transform: translateY(12px);
  transition:
    opacity 500ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 200ms),
    transform 500ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 200ms);
}

.cardRevealed .textBlock {
  opacity: 1;
  transform: translateY(0);
}

/* --- Directional wipe hover overlay --- */

.wipeOverlay {
  position: absolute;
  inset: 0;
  background: var(--project-color, #1A1A1A);
  opacity: 0;
  transform: translateX(-101%);
  transition:
    transform 450ms var(--ease-out),
    opacity 200ms var(--ease);
  display: flex;
  align-items: flex-end;
  padding: 24px;
  pointer-events: none;
  z-index: 1;
}

.card:hover .wipeOverlay {
  transform: translateX(0);
  opacity: 0.88;
}

.wipeTitle {
  color: #fff;
  font-size: 16px;
  font-weight: 500;
  letter-spacing: 0.02em;
  line-height: 1.3;
  opacity: 0;
  transform: translateY(8px);
  transition:
    opacity 300ms var(--ease) 120ms,
    transform 300ms var(--ease-out) 120ms;
}

.card:hover .wipeTitle {
  opacity: 1;
  transform: translateY(0);
}

/* After reveal, switch to hover-ready transitions (no delay) */
.cardRevealed .imageInner {
  transition:
    transform 600ms var(--ease);
}

.card:hover .imageInner {
  transform: scale(1.03);
}

/* --- Text styles --- */

.title {
  font-size: 18px;
  font-weight: 500;
  margin: 0 0 6px;
  color: var(--text);
  letter-spacing: 0.015em;
  line-height: 1.3;
}

.desc {
  font-size: 14px;
  font-weight: 400;
  margin: 0 0 8px;
  color: var(--muted);
  letter-spacing: normal;
  line-height: 1.4;
}

/* Elevator metatags */
.metatagWrapper {
  height: 30px;
  overflow: hidden;
  margin-top: 8px;
}

.metatagInner {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  transform: translateY(-110%);
  opacity: 0;
  transition:
    transform 350ms var(--ease),
    opacity 250ms var(--ease);
}

.card:hover .metatagInner {
  transform: translateY(0);
  opacity: 1;
  transition:
    transform 350ms var(--ease-out),
    opacity 250ms var(--ease-out);
}

/* --- Accessibility: reduced motion --- */
@media (prefers-reduced-motion: reduce) {
  .imageInner {
    clip-path: none;
    opacity: 1;
    transform: none;
    transition: none;
  }
  .textBlock {
    opacity: 1;
    transform: none;
    transition: none;
  }
  .wipeOverlay {
    transition: opacity 200ms var(--ease);
    transform: none;
  }
  .card:hover .wipeOverlay {
    transform: none;
    opacity: 0.88;
  }
}
