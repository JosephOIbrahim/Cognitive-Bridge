.tag {
  display: inline-block;
  padding: 5px 12px;
  border-radius: 4px;
  background: transparent;
  color: var(--muted-light);
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.01em;
  line-height: 1;
  transition:
    background 250ms var(--ease),
    color 250ms var(--ease);
}

.tag:hover {
  background: #E0E0DC;
  color: #555555;
}
