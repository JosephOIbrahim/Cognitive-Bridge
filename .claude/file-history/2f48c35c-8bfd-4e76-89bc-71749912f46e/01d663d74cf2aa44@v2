"use client";

import { useEffect, useRef } from "react";

export function ScrollProgress() {
  const barRef = useRef<HTMLDivElement>(null);
  const wrapperRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handler = () => {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(1, Math.max(0, window.scrollY / docHeight)) : 0;
      if (barRef.current) {
        barRef.current.style.transform = `scaleX(${pct})`;
      }
      if (wrapperRef.current) {
        wrapperRef.current.style.display = pct < 0.01 ? "none" : "block";
      }
    };
    window.addEventListener("scroll", handler, { passive: true });
    return () => window.removeEventListener("scroll", handler);
  }, []);

  return (
    <div ref={wrapperRef} style={{ position: "fixed", top: 0, left: 0, right: 0, height: 2, zIndex: 200, display: "none" }}>
      <div
        ref={barRef}
        style={{
          height: "100%",
          background: "var(--text)",
          opacity: 0.15,
          transform: "scaleX(0)",
          transformOrigin: "left",
          willChange: "transform",
        }}
      />
    </div>
  );
}
