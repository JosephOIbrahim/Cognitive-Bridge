.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: var(--nav-h);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 var(--pad);
  transition: all 300ms var(--ease);
  font-family: var(--font-nav), var(--font);
}

.navScrolled {
  background: rgba(250, 250, 248, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.links {
  display: flex;
  gap: 28px;
  align-items: center;
}

.linksLeft {
  justify-content: flex-start;
}

.linksRight {
  justify-content: flex-end;
}

.navLink {
  font-size: 16px;
  font-weight: 500;
  color: var(--muted-light);
  text-transform: uppercase;
  letter-spacing: 0.10em;
  padding: 4px 0;
  display: inline-block;
  text-decoration: none;
  transition: color 200ms var(--ease);
  line-height: 1;
}

.navLink:hover {
  color: var(--text);
}

.navLinkActive {
  color: var(--text);
}


.nameplate {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 4px 0;
}

.hairline {
  width: 1px;
  height: 14px;
  background: rgba(0, 0, 0, 0.12);
  flex-shrink: 0;
}

.nameplateText {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.18em;
  color: var(--text);
  text-transform: uppercase;
  white-space: nowrap;
  line-height: 1;
}

/* Mobile */
.mobileMenuBtn {
  display: none;
  flex-direction: column;
  gap: 4px;
  padding: 8px;
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
}

.mobileMenuLine {
  width: 20px;
  height: 1.5px;
  background: var(--text);
  display: block;
  transition: transform 200ms var(--ease);
}

.mobileDropdown {
  position: absolute;
  top: var(--nav-h);
  left: 0;
  right: 0;
  background: rgba(250, 250, 248, 0.97);
  backdrop-filter: blur(20px);
  padding: 16px 0;
  animation: fadeSlideUp 200ms var(--ease-out);
}

.mobileLink {
  display: block;
  width: 100%;
  text-align: left;
  padding: 12px var(--pad);
  font-size: 14px;
  font-weight: 500;
  color: var(--text);
  text-transform: uppercase;
  letter-spacing: 0.10em;
}

.mobileLinkActive {
  font-weight: 600;
}

.mobileSocials {
  display: flex;
  gap: 24px;
  padding: 12px var(--pad);
}

.mobileSocialLink {
  font-size: 14px;
  font-weight: 500;
  color: var(--text);
  text-transform: uppercase;
  letter-spacing: 0.10em;
}

@media (max-width: 480px) {
  .links {
    display: none !important;
  }
  .mobileMenuBtn {
    display: flex !important;
  }
}
