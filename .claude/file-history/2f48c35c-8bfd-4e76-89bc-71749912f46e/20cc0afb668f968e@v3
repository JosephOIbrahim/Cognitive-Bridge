"use client";

import Image from "next/image";
import { useInView } from "@/lib/hooks";
import { T } from "@/lib/tokens";
import type { CaseStudySection as CaseStudySectionType } from "@/lib/types";
import styles from "./CaseStudySection.module.css";

interface Props {
  section: CaseStudySectionType;
  sectionIndex: number;
  title: string;
  /** Pre-sliced image paths for this section */
  images: string[];
}

export function CaseStudySection({ section, sectionIndex, title, images }: Props) {
  const [ref, inView] = useInView({ threshold: 0.1 });

  // Alternate pair direction per section
  const pairType = sectionIndex % 2 === 0 ? "wide-narrow" : "narrow-wide";

  return (
    <div ref={ref} className={styles.section}>
      <div
        className={styles.textBlock}
        style={{
          opacity: inView ? 1 : 0,
          transform: inView ? "translateY(0)" : "translateY(20px)",
          transition: `all 600ms ${T.easeOut}`,
        }}
      >
        <h2 className={styles.heading}>{section.heading}</h2>
        <p className={styles.body}>{section.body}</p>
      </div>

      {/* Images — varied layout based on count */}
      <div className={styles.imageGrid}>
        {images.length === 1 && (
          <Image
            src={images[0]}
            alt={`${title} - ${section.heading}`}
            width={2400}
            height={1600}
            style={{ width: "100%", height: "auto", borderRadius: "var(--img-radius)" }}
            sizes="(max-width: 768px) 100vw, (max-width: 1400px) 90vw, 1400px"
          />
        )}

        {images.length === 2 && (
          <div
            className={styles.pair}
            style={{
              gridTemplateColumns: pairType === "wide-narrow" ? "2fr 1fr" : "1fr 2fr",
            }}
          >
            {images.map((src, i) => (
              <Image
                key={i}
                src={src}
                alt={`${title} - ${section.heading}`}
                width={2400}
                height={1600}
                style={{ width: "100%", height: "auto", borderRadius: "var(--img-radius)" }}
                sizes={pairType === "wide-narrow"
                  ? (i === 0 ? "(max-width: 768px) 100vw, 60vw" : "(max-width: 768px) 100vw, 30vw")
                  : (i === 0 ? "(max-width: 768px) 100vw, 30vw" : "(max-width: 768px) 100vw, 60vw")
                }
              />
            ))}
          </div>
        )}

        {images.length >= 3 && (
          <>
            {/* First image full-width */}
            <Image
              src={images[0]}
              alt={`${title} - ${section.heading}`}
              width={2400}
              height={1600}
              style={{ width: "100%", height: "auto", borderRadius: "var(--img-radius)" }}
              sizes="(max-width: 768px) 100vw, (max-width: 1400px) 90vw, 1400px"
            />
            {/* Remaining as asymmetric pair */}
            <div
              className={styles.pair}
              style={{
                gridTemplateColumns: pairType === "wide-narrow" ? "2fr 1fr" : "1fr 2fr",
              }}
            >
              {images.slice(1, 3).map((src, i) => (
                <Image
                  key={i}
                  src={src}
                  alt={`${title} - ${section.heading}`}
                  width={2400}
                  height={1600}
                  style={{ width: "100%", height: "auto", borderRadius: "var(--img-radius)" }}
                  sizes={pairType === "wide-narrow"
                    ? (i === 0 ? "(max-width: 768px) 100vw, 60vw" : "(max-width: 768px) 100vw, 30vw")
                    : (i === 0 ? "(max-width: 768px) 100vw, 30vw" : "(max-width: 768px) 100vw, 60vw")
                  }
                />
              ))}
            </div>
            {/* Any extras beyond 3, full-width */}
            {images.slice(3).map((src, i) => (
              <Image
                key={i + 3}
                src={src}
                alt={`${title} - ${section.heading}`}
                width={2400}
                height={1600}
                style={{ width: "100%", height: "auto", borderRadius: "var(--img-radius)" }}
                sizes="(max-width: 768px) 100vw, (max-width: 1400px) 90vw, 1400px"
              />
            ))}
          </>
        )}
      </div>
    </div>
  );
}
