.section {
  margin: 80px 0;
}

.textBlock {
  max-width: 640px;
  margin-bottom: 40px;
}

.heading {
  font-size: clamp(18px, 1.6vw, 24px);
  font-weight: 400;
  color: var(--text);
  margin: 0 0 14px;
  line-height: 1.3;
  letter-spacing: -0.005em;
}

.body {
  font-size: clamp(15px, 1.2vw, 17px);
  font-weight: 400;
  color: var(--muted);
  line-height: 1.7;
  margin: 0;
}
