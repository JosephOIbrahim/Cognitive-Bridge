.section {
  margin: 64px 0;
}

.textBlock {
  max-width: 640px;
  margin-bottom: 32px;
}

.heading {
  font-size: clamp(20px, 2vw, 28px);
  font-weight: 400;
  color: var(--text);
  margin: 0 0 12px;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.body {
  font-size: clamp(15px, 1.2vw, 17px);
  font-weight: 400;
  color: var(--muted);
  line-height: 1.7;
  margin: 0;
}
