# ---------------------------------------------------------------------------
# HTML Parsing
# ---------------------------------------------------------------------------

def parse_html_transcript(html_path):
    """Parse a Youtube2Webpage index.html and extract (timestamp, text) pairs."""
    with open(html_path, "r", encoding="utf-8") as f:
        content = f.read()

    # Extract YouTube URL from the source link
    url_match = re.search(r'href="(https://www\.youtube\.com/watch\?v=[^"]+)"', content)
    youtube_url = url_match.group(1) if url_match else ""

    # Extract all caption entries: <span id="HH:MM:SS.mmm">text</span>
    pattern = r'<span id="(\d{2}:\d{2}:\d{2}\.\d{3})">(.+?)</span>'
    entries = []
    for match in re.finditer(pattern, content):
        timestamp = match.group(1)
        text = html.unescape(match.group(2)).strip()
        # Clean up common auto-caption artifacts
        text = re.sub(r'^>>\s*', '', text)  # Remove >> prefix
        text = text.strip()
        if text and text.lower() not in ('[music]', '[applause]'):
            entries.append((timestamp, text))

    return youtube_url, entries


def timestamp_to_seconds(ts):
    """Convert HH:MM:SS.mmm to float seconds."""
    parts = ts.split(':')
    h, m = int(parts[0]), int(parts[1])
    s = float(parts[2])
    return h * 3600 + m * 60 + s


def format_timestamp_short(ts):
    """Convert HH:MM:SS.mmm to MM:SS for display."""
    parts = ts.split(':')
    h, m, s = int(parts[0]), int(parts[1]), parts[2].split('.')[0]
    total_min = h * 60 + m
    return f"{total_min}:{s}"


def group_into_paragraphs(entries, window=PARAGRAPH_WINDOW):
    """Group caption entries into paragraphs by time window."""
    if not entries:
        return []

    paragraphs = []
    current_lines = []
    current_start_ts = entries[0][0]
    current_start_sec = timestamp_to_seconds(entries[0][0])

    for ts, text in entries:
        sec = timestamp_to_seconds(ts)
        # Start new paragraph if we've exceeded the window
        if sec - current_start_sec >= window and current_lines:
            paragraphs.append((current_start_ts, ' '.join(current_lines)))
            current_lines = [text]
            current_start_ts = ts
            current_start_sec = sec
        else:
            current_lines.append(text)

    # Flush remaining
    if current_lines:
        paragraphs.append((current_start_ts, ' '.join(current_lines)))

    return paragraphs


