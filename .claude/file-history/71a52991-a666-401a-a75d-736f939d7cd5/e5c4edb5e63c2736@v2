def build_semantic_entries():
    """Build semantic index entries for all 18 videos."""
    entries = {}
    for slug, url, title, keywords in VIDEOS:
        part_num = int(slug.split('-')[0])
        topic_key = 'mpm_' + slug.split('-', 1)[1].replace('-', '_')
        raw_file = slug.replace('-', '_') + '.md'
        tutorial_file = topic_key + '.md'

        # Related docs: adjacent parts + overview
        related = [f'tutorials/workflow_guides/{tutorial_file}']
        if part_num != 0:
            related.append('tutorials/workflow_guides/mpm_overview.md')

        entry = {
            'primary_doc': f'tutorials/workflow_guides/{tutorial_file}',
            'related_docs': related + [
                f'_raw_documentation/mpm_masterclass/{raw_file}'
            ],
            'keywords': keywords,
            'agent_relevance': {
                'Librarian': 0.90,
                'GraphTracer': 0.75,
                'VexAuditor': 0.45
            },
            'common_queries': [
                f'How does {title.replace("MPM ", "").lower()} work?',
                f'{title} tutorial',
                f'MPM {slug.split("-", 1)[1].replace("-", " ")} Houdini 21',
            ],
            'source_type': 'youtube_video',
            'series': SERIES_NAME,
        }
        entries[topic_key] = entry

    return entries


def update_semantic_index(new_entries):
    """Merge new entries into the existing semantic_index.json."""
    index_path = METADATA_DIR / 'semantic_index.json'
    with open(index_path, 'r', encoding='utf-8') as f:
        index = json.load(f)

    topics = index.get('semantic_index', {}).get('topics', {})
    added = 0
    for key, entry in sorted(new_entries.items()):
        if key not in topics:
            topics[key] = entry
            added += 1
        else:
            # Update existing entry
            topics[key] = entry

    index['semantic_index']['topics'] = dict(sorted(topics.items()))

    with open(index_path, 'w', encoding='utf-8') as f:
        json.dump(index, f, indent=2, ensure_ascii=False, sort_keys=False)

    return added


