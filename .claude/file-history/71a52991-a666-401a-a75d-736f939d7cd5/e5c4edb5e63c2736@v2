def write_raw_transcript(slug, youtube_url, title, keywords, entries, paragraphs):
    """Write a clean Tier 1 transcript markdown file."""
    filename = slug.replace('-', '_') + '.md'
    filepath = RAW_DIR / filename
    part_num = int(slug.split('-')[0])

    lines = []
    # YAML frontmatter
    lines.append('---')
    lines.append(f'title: "{title}"')
    lines.append('category: _raw_documentation')
    lines.append('subcategory: mpm_masterclass')
    kw_str = json.dumps(keywords, ensure_ascii=False)
    lines.append(f'keywords: {kw_str}')
    lines.append('agent_relevance:')
    lines.append('  Librarian: 0.85')
    lines.append('  GraphTracer: 0.70')
    lines.append('  VexAuditor: 0.40')
    lines.append('source:')
    lines.append('  type: youtube_video')
    lines.append(f'  url: "{youtube_url}"')
    lines.append(f'  series: "{SERIES_NAME}"')
    lines.append(f'  part: {part_num}')
    lines.append('  total_parts: 18')
    lines.append(f'  presenter: "{PRESENTER}"')
    lines.append(f'transcript_lines: {len(entries)}')
    if entries:
        first_ts = format_timestamp_short(entries[0][0])
        last_ts = format_timestamp_short(entries[-1][0])
        lines.append(f'duration_range: "{first_ts} - {last_ts}"')
    lines.append('---')
    lines.append('')

    # Document body
    lines.append(f'# {title}')
    lines.append('')
    lines.append(f'**Series:** [{SERIES_NAME}]({SERIES_URL})')
    lines.append(f'**Source:** [YouTube]({youtube_url})')
    lines.append(f'**Presenter:** {PRESENTER}')
    lines.append(f'**Part:** {part_num} of 18')
    lines.append(f'**Transcript Lines:** {len(entries)}')
    lines.append('')
    lines.append('---')
    lines.append('')
    lines.append('## Transcript')
    lines.append('')

    for ts, text in paragraphs:
        short_ts = format_timestamp_short(ts)
        sec = int(timestamp_to_seconds(ts))
        yt_link = f"{youtube_url}&t={sec}"
        lines.append(f'**[{short_ts}]({yt_link})** {text}')
        lines.append('')

    with open(filepath, 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))

    return filepath


