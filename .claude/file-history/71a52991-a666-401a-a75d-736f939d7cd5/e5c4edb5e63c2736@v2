            youtube_url = url  # Fallback to our mapping

        # Group into paragraphs
        paragraphs = group_into_paragraphs(entries)

        # Write Tier 1: Raw transcript
        raw_path = write_raw_transcript(slug, youtube_url, title, keywords, entries, paragraphs)

        # Write Tier 2: Knowledge stub
        part_num = int(slug.split('-')[0])
        stub_path = write_knowledge_stub(slug, youtube_url, title, keywords, paragraphs, part_num)

        total_lines += len(entries)
        total_paragraphs += len(paragraphs)

        print(f"  [{i+1:2d}/18] {slug}")
        print(f"         {len(entries)} lines -> {len(paragraphs)} paragraphs")
        print(f"         Tier 1: {raw_path.name}")
        print(f"         Tier 2: {stub_path.name}")

    print("=" * 60)
    print(f"Total: {total_lines} caption lines -> {total_paragraphs} paragraphs")

    # Update semantic index
    print("\nUpdating semantic_index.json...")
    new_entries = build_semantic_entries()
    added = update_semantic_index(new_entries)
    print(f"  Added/updated {added} topic entries in semantic index")

    print("\nDone! Phase 1 complete.")
    print(f"  Tier 1 (raw transcripts):    {RAW_DIR}")
    print(f"  Tier 2 (knowledge stubs):    {TUTORIALS_DIR}")
    print(f"  Metadata updated:            {METADATA_DIR / 'semantic_index.json'}")


