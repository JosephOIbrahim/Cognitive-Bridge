]

def main():
    print("RAG Retrieval Test - MPM H21 Masterclass Knowledge Base")
    print(f"Index: {INDEX_PATH}")
    print(f"Docs:  {TUTORIALS_DIR}")

    topics = load_index()
    mpm_count = sum(1 for k in topics if k.startswith("mpm_"))
    print(f"MPM topics in index: {mpm_count}")

    for query in QUERIES:
        run_test(query)

    print(f"\n{'='*70}")
    print("RETRIEVAL TEST COMPLETE")
    print(f"{'='*70}")

if __name__ == "__main__":
    main()
