'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import {
  getProcessPostsBySection,
  sectionLabels,
  sectionDescriptions,
  type ProcessSection,
  type ProcessPost
} from '@/lib/process-posts';
import { usePrefersReducedMotion } from '@/lib/hooks/usePrefersReducedMotion';

/**
 * PROCESS Page — Flat Section Layout
 *
 * Two sections, all visible (no accordion):
 * 1. Tools — Production tools (strongest section, shown first)
 * 2. Explorations — Case studies + research merged
 *
 * Card grid: 2-col desktop, 1-col mobile
 * GitHub + version badges inline on tool cards
 */

const SECTIONS: ProcessSection[] = ['tools', 'explorations'];

function ProcessCard({ post }: { post: ProcessPost }) {
  const [isHovered, setIsHovered] = useState(false);

  // Tools with GitHub link → external; everything else → internal detail page
  const isExternal = !!post.githubUrl;
  const href = isExternal ? post.githubUrl! : `/process/${post.slug}`;

  const Wrapper = isExternal ? 'a' : Link;
  const linkProps = isExternal
    ? { href, target: '_blank' as const, rel: 'noopener noreferrer' as const }
    : { href };

  return (
    <Wrapper
      {...linkProps}
      className="group block"
      onMouseEnter={() => setIsHovered(true)}
      onMouseLeave={() => setIsHovered(false)}
      style={{ textDecoration: 'none' }}
    >
      {/* Thumbnail — full-width 16:9 */}
      <div
        style={{
          aspectRatio: '16 / 9',
          borderRadius: 'var(--radius-md)',
          overflow: 'hidden',
          backgroundColor: post.thumbnail ? '#1a1a1a' : 'rgba(255, 255, 255, 0.04)',
          marginBottom: 'var(--space-tiny)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center'
        }}
      >
        {post.thumbnail ? (
          <img
            src={post.thumbnail}
            alt={post.title}
            loading="lazy"
            style={{
              width: '100%',
              height: '100%',
              objectFit: 'cover',
              opacity: isHovered ? 1 : 0.85,
              transform: isHovered ? 'scale(1.02)' : 'scale(1)',
              transition: 'opacity 0.3s ease, transform 0.3s ease'
            }}
          />
        ) : (
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="1.5"
            strokeLinecap="round"
            style={{
              color: isHovered ? 'rgba(255, 255, 255, 0.25)' : 'rgba(255, 255, 255, 0.12)',
              transition: 'color 200ms ease'
            }}
          >
            <path d="M6 6L18 18M6 18L18 6" />
          </svg>
        )}
      </div>

      {/* Title */}
      <h3
        style={{
          color: isHovered ? 'var(--grey-50)' : 'var(--text-primary)',
          fontFamily: 'var(--font-display)',
          fontWeight: 400,
          fontSize: '16px',
          letterSpacing: '0.01em',
          lineHeight: 1.3,
          marginBottom: '6px',
          transition: 'color 0.25s ease'
        }}
      >
        {post.title}
      </h3>

      {/* Excerpt — 2 lines max */}
      <p
        style={{
          color: 'var(--grey-500)',
          fontFamily: 'var(--font-display)',
          fontWeight: 400,
          fontSize: '14px',
          lineHeight: 1.6,
          display: '-webkit-box',
          WebkitLineClamp: 2,
          WebkitBoxOrient: 'vertical',
          overflow: 'hidden',
          marginBottom: '0'
        }}
      >
        {post.excerpt}
      </p>

      {/* Meta row — version + GitHub + tags */}
      <div className="flex flex-wrap items-center" style={{ gap: '8px', marginTop: '10px' }}>
        {post.version && (
          <span
            style={{
              color: 'var(--text-dim)',
              fontFamily: 'var(--font-display)',
              fontSize: '11px',
              fontWeight: 500,
              letterSpacing: '0.08em',
              textTransform: 'uppercase'
            }}
          >
            v{post.version}
          </span>
        )}
        {post.githubUrl && (
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
            style={{ color: 'var(--text-dim)' }}
            aria-label="Available on GitHub"
          >
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
        )}
        {/* Tags — Pentagram discipline tag pattern */}
        {post.tags && post.tags.slice(0, 3).map((tag) => (
          <span
            key={tag}
            style={{
              color: 'var(--grey-600)',
              fontFamily: 'var(--font-display)',
              fontSize: '11px',
              fontWeight: 400,
              letterSpacing: '0.02em'
            }}
          >
            {tag}
          </span>
        ))}
      </div>
    </Wrapper>
  );
}

export default function ProcessPage() {
  const [introVisible, setIntroVisible] = useState(false);
  const prefersReducedMotion = usePrefersReducedMotion();

  // Trigger intro animation on mount
  useEffect(() => {
    const timer = setTimeout(() => setIntroVisible(true), 100);
    return () => clearTimeout(timer);
  }, []);

  return (
    <div className="min-h-screen" style={{ backgroundColor: '#141414' }}>
      <main
        className="mx-auto pb-32"
        style={{
          maxWidth: 'var(--max-content-width)',
          paddingTop: 'clamp(100px, 8vw + 60px, 180px)',
          paddingLeft: 'var(--side-padding)',
          paddingRight: 'var(--side-padding)'
        }}
      >
        {/* Hero Statement */}
        <section className="mb-12 sm:mb-[76px]">
          <h1
            style={{
              color: '#a0a0a0',
              fontFamily: 'var(--font-display)',
              fontWeight: 400,
              fontSize: 'clamp(22px, 3.5vw, 38px)',
              lineHeight: 1.3,
              letterSpacing: '0.01em',
              maxWidth: '900px',
              opacity: introVisible ? 1 : 0,
              transform: introVisible ? 'translateY(0)' : 'translateY(30px)',
              transition: prefersReducedMotion ? 'none' : 'opacity 550ms cubic-bezier(0.25, 0.1, 0.25, 1) 100ms, transform 550ms cubic-bezier(0.25, 0.1, 0.25, 1) 100ms'
            }}
          >
            Behind the final frame: tools built, problems solved, and the thinking that shapes the work.
          </h1>
        </section>

        {/* Sections — flat, all visible */}
        <div
          style={{
            opacity: introVisible ? 1 : 0,
            transform: introVisible ? 'translateY(0)' : 'translateY(20px)',
            transition: prefersReducedMotion ? 'none' : 'opacity 550ms ease 200ms, transform 550ms ease 200ms'
          }}
        >
          {SECTIONS.map((section) => {
            const posts = getProcessPostsBySection(section);
            if (posts.length === 0) return null;

            return (
              <section key={section} style={{ marginBottom: 'var(--space-section, 120px)' }}>
                {/* Section Header */}
                <div style={{ marginBottom: 'var(--space-sm)' }}>
                  <h2
                    style={{
                      color: 'var(--text-primary)',
                      fontFamily: 'var(--font-display)',
                      fontWeight: 400,
                      fontSize: 'clamp(22px, 2.2vw, 28px)',
                      lineHeight: 1.15,
                      letterSpacing: '0.005em',
                      marginBottom: '10px'
                    }}
                  >
                    {sectionLabels[section]}
                  </h2>
                  <p
                    style={{
                      color: 'var(--grey-500)',
                      fontFamily: 'var(--font-display)',
                      fontWeight: 400,
                      fontSize: '15px',
                      lineHeight: 1.5,
                      maxWidth: '600px'
                    }}
                  >
                    {sectionDescriptions[section]}
                  </p>
                </div>

                {/* Card Grid — 2-col desktop, 1-col mobile */}
                <div
                  className="grid grid-cols-1 md:grid-cols-2"
                  style={{ gap: 'clamp(24px, 3vw, 40px)' }}
                >
                  {posts.map((post) => (
                    <ProcessCard key={post.id} post={post} />
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      </main>
    </div>
  );
}
