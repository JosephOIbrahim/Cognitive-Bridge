'use client';

import { useEffect, useRef } from 'react';
import Link from 'next/link';

interface ToolsOverlayProps {
  isOpen: boolean;
  onClose: () => void;
}

interface DownloadableTool {
  id: string;
  name: string;
  version: string;
  description: string;
  githubUrl?: string;
  filename?: string;
  fileSize?: string;
}

const downloadableTools: DownloadableTool[] = [
  {
    id: 'hyphae',
    name: 'Hyphae',
    version: '1.0.0',
    description: 'AI ↔ Houdini bridge with persistent project memory. Synapse (WebSocket) + Engram (memory) + Core (determinism).',
    githubUrl: 'https://github.com/JosephOIbrahim/Hyphae'
  },
  {
    id: 'radiant-suite',
    name: 'Radiant Suite',
    version: '2.0.0',
    description: 'Lighting, texturing, and compositing workflows. Aurora (lighting) + Spectrum (materials) + Prism (COPs).',
    githubUrl: 'https://github.com/JosephOIbrahim/RadiantSuite'
  },
  {
    id: 'jetblock-optimizer',
    name: 'JetBlock Optimizer',
    version: '4.0',
    description: 'Deterministic inference for Nemotron 3 in ComfyUI. Same seed, same output, every time.',
    githubUrl: 'https://github.com/JosephOIbrahim/comfyui-jetblock-optimizer'
  },
  {
    id: 'lighting-setups',
    name: 'Houdini Lighting Setups',
    version: '2.0.0',
    description: 'Template scenes for product, portrait, automotive, and architectural lighting.'
  }
];

/**
 * ToolsOverlay - Easter Egg Download Hub
 *
 * Revealed by double-clicking the chat icon in navigation.
 * Contains actual download links for tools (not available on PROCESS page).
 */
export function ToolsOverlay({ isOpen, onClose }: ToolsOverlayProps) {
  const overlayRef = useRef<HTMLDivElement>(null);

  // Close on escape key
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) {
        onClose();
      }
    };

    if (isOpen) {
      document.addEventListener('keydown', handleKeyDown);
      document.body.style.overflow = 'hidden';
    }

    return () => {
      document.removeEventListener('keydown', handleKeyDown);
      document.body.style.overflow = '';
    };
  }, [isOpen, onClose]);

  // Close when clicking backdrop
  const handleBackdropClick = (e: React.MouseEvent) => {
    if (e.target === overlayRef.current) {
      onClose();
    }
  };

  if (!isOpen) return null;

  return (
    <div
      ref={overlayRef}
      onClick={handleBackdropClick}
      className="fixed inset-0 flex items-center justify-center"
      style={{
        backgroundColor: 'rgba(0, 0, 0, 0.85)',
        backdropFilter: 'blur(8px)',
        zIndex: 200,
        animation: 'fadeIn 300ms ease-out'
      }}
    >
      <div
        className="relative w-full max-w-2xl mx-4"
        style={{
          backgroundColor: '#1a1a1a',
          borderRadius: '8px',
          border: '1px solid rgba(255, 255, 255, 0.1)',
          maxHeight: '85vh',
          overflow: 'auto',
          animation: 'slideUp 300ms ease-out'
        }}
      >
        {/* Header */}
        <div
          className="sticky top-0 flex items-center justify-between p-6"
          style={{
            backgroundColor: '#1a1a1a',
            borderBottom: '1px solid rgba(255, 255, 255, 0.06)'
          }}
        >
          <div>
            <h2
              style={{
                color: '#d0d0d0',
                fontFamily: 'var(--font-display)',
                fontSize: '18px',
                fontWeight: 500,
                letterSpacing: '0.04em',
                marginBottom: '4px'
              }}
            >
              Tools & Downloads
            </h2>
            <p
              style={{
                color: '#5a5a5a',
                fontFamily: 'var(--font-display)',
                fontSize: '13px'
              }}
            >
              You found the secret stash
            </p>
          </div>

          {/* Close button */}
          <button
            onClick={onClose}
            className="transition-opacity hover:opacity-60"
            style={{
              padding: '8px',
              marginRight: '-8px'
            }}
            aria-label="Close"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#7a7a7a"
              strokeWidth="1.5"
              strokeLinecap="round"
            >
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        {/* Tools list */}
        <div className="p-6 space-y-6">
          {downloadableTools.map((tool) => (
            <div
              key={tool.id}
              className="group"
              style={{
                padding: '20px',
                backgroundColor: 'rgba(255, 255, 255, 0.02)',
                borderRadius: '6px',
                border: '1px solid rgba(255, 255, 255, 0.04)'
              }}
            >
              {/* Tool header */}
              <div className="flex items-start justify-between gap-4 mb-3">
                <div>
                  <h3
                    style={{
                      color: '#c0c0c0',
                      fontFamily: 'var(--font-display)',
                      fontSize: '16px',
                      fontWeight: 500,
                      marginBottom: '2px'
                    }}
                  >
                    {tool.name}
                    <span
                      style={{
                        color: '#5a5a5a',
                        fontSize: '12px',
                        fontWeight: 400,
                        marginLeft: '10px'
                      }}
                    >
                      v{tool.version}
                    </span>
                  </h3>
                </div>

                {/* GitHub or Download button */}
                {tool.githubUrl ? (
                  <a
                    href={tool.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-center gap-2 transition-all"
                    style={{
                      padding: '8px 14px',
                      backgroundColor: 'rgba(255, 255, 255, 0.06)',
                      borderRadius: '4px',
                      color: '#a0a0a0',
                      fontFamily: 'var(--font-display)',
                      fontSize: '13px',
                      fontWeight: 500,
                      flexShrink: 0
                    }}
                    onMouseEnter={(e) => {
                      e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.1)';
                      e.currentTarget.style.color = '#ffffff';
                    }}
                    onMouseLeave={(e) => {
                      e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.06)';
                      e.currentTarget.style.color = '#a0a0a0';
                    }}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    GitHub
                  </a>
                ) : tool.filename ? (
                  <a
                    href={`/downloads/${tool.filename}`}
                    download
                    className="flex items-center gap-2 transition-all"
                    style={{
                      padding: '8px 14px',
                      backgroundColor: 'rgba(255, 255, 255, 0.06)',
                      borderRadius: '4px',
                      color: '#a0a0a0',
                      fontFamily: 'var(--font-display)',
                      fontSize: '13px',
                      fontWeight: 500,
                      flexShrink: 0
                    }}
                    onMouseEnter={(e) => {
                      e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.1)';
                      e.currentTarget.style.color = '#ffffff';
                    }}
                    onMouseLeave={(e) => {
                      e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.06)';
                      e.currentTarget.style.color = '#a0a0a0';
                    }}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                      <polyline points="7 10 12 15 17 10" />
                      <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                    Download
                  </a>
                ) : (
                  <span
                    style={{
                      padding: '8px 14px',
                      backgroundColor: 'rgba(255, 255, 255, 0.03)',
                      borderRadius: '4px',
                      color: '#5a5a5a',
                      fontFamily: 'var(--font-display)',
                      fontSize: '13px',
                      fontWeight: 500,
                      flexShrink: 0
                    }}
                  >
                    Coming Soon
                  </span>
                )}
              </div>

              {/* Description */}
              <p
                style={{
                  color: '#7a7a7a',
                  fontFamily: 'var(--font-display)',
                  fontSize: '14px',
                  lineHeight: 1.6
                }}
              >
                {tool.description}
              </p>
            </div>
          ))}
        </div>

        {/* Footer */}
        <div
          className="p-6"
          style={{ borderTop: '1px solid rgba(255, 255, 255, 0.06)' }}
        >
          <p
            style={{
              color: '#5a5a5a',
              fontFamily: 'var(--font-display)',
              fontSize: '13px',
              marginBottom: '12px'
            }}
          >
            Read about these tools and see them in action:
          </p>
          <Link
            href="/process"
            onClick={onClose}
            className="inline-flex items-center gap-2 transition-opacity hover:opacity-70"
            style={{
              color: '#8a8a8a',
              fontFamily: 'var(--font-display)',
              fontSize: '14px',
              fontWeight: 500
            }}
          >
            Visit Process
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </Link>
        </div>
      </div>

      <style jsx>{`
        @keyframes fadeIn {
          from { opacity: 0; }
          to { opacity: 1; }
        }
        @keyframes slideUp {
          from {
            opacity: 0;
            transform: translateY(20px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      `}</style>
    </div>
  );
}
