'use client';

import { useEffect, useState } from 'react';

type CursorState = 'default' | 'link' | 'video' | 'button';

export function CustomCursor() {
  const [position, setPosition] = useState({ x: -100, y: -100 });
  const [cursorState, setCursorState] = useState<CursorState>('default');
  const [isVisible, setIsVisible] = useState(false);
  const [animationKey, setAnimationKey] = useState(0);
  const [isOverMetatag, setIsOverMetatag] = useState(false);
  const [currentVideoSlug, setCurrentVideoSlug] = useState<string | null>(null);
  const [isPressed, setIsPressed] = useState(false);

  useEffect(() => {
    // Check if device supports hover (desktop only)
    const hasHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (!hasHover) return;

    setIsVisible(true);

    const updateCursor = (e: MouseEvent) => {
      setPosition({ x: e.clientX, y: e.clientY });

      // Always use normal browser cursor
      setIsOverMetatag(true);
      setCursorState('default');
      setCurrentVideoSlug(null);
    };

    window.addEventListener('mousemove', updateCursor);

    return () => {
      window.removeEventListener('mousemove', updateCursor);
    };
  }, [cursorState]);

  // Trigger animation when entering video hover state, and repeat continuously every 3 seconds
  // Watch currentVideoSlug so animation retriggers when moving between different videos
  useEffect(() => {
    let animationInterval: NodeJS.Timeout | null = null;

    if (cursorState === 'video' && currentVideoSlug) {
      // Trigger initial animation immediately on EVERY video entry (including switching between videos)
      setAnimationKey(prev => prev + 1);

      // Set interval to continuously repeat animation every 3 seconds while hovering
      animationInterval = setInterval(() => {
        setAnimationKey(prev => prev + 1);
      }, 3000);
    }

    // Cleanup interval if user leaves video hover
    return () => {
      if (animationInterval) {
        clearInterval(animationInterval);
      }
    };
  }, [cursorState, currentVideoSlug]);

  if (!isVisible) return null;

  // Cursor properties based on state
  const getCursorProps = () => {
    switch (cursorState) {
      case 'video':
        return {
          width: 'auto',
          height: 'auto',
          padding: '0.25rem 0.625rem', // Match metatag padding (py-1 px-2.5)
          color: '#181818', // Dark grey background (matches site)
          text: 'play',
          fontSize: '11px',
          fontWeight: 600, // Semibold weight
          letterSpacing: '0.04em', // Subtle letter spacing
          textColor: '#f5f5f5', // Project title color
          fontFamily: 'var(--font-display)', // Match site font
          borderRadius: '6px' // Match metatag rounded-md
        };
      case 'link':
        return {
          width: 20,
          height: 20,
          padding: '0',
          color: '#6a6a6a',
          text: '.',
          fontSize: '20px',
          fontWeight: 400,
          letterSpacing: '0',
          textColor: '#d9d9d9',
          fontFamily: 'var(--font-dm-sans), -apple-system, BlinkMacSystemFont, sans-serif',
          borderRadius: '2px'
        };
      case 'button':
        return {
          width: 20,
          height: 20,
          padding: '0',
          color: '#4a4a4a',
          text: '.',
          fontSize: '20px',
          fontWeight: 400,
          letterSpacing: '0',
          textColor: '#d9d9d9',
          fontFamily: 'var(--font-dm-sans), -apple-system, BlinkMacSystemFont, sans-serif',
          borderRadius: '2px'
        };
      default:
        return {
          width: 20,
          height: 20,
          padding: '0',
          color: '#8a8a8a',
          text: '.',
          fontSize: '20px',
          fontWeight: 400,
          letterSpacing: '0',
          textColor: '#d9d9d9',
          fontFamily: 'var(--font-dm-sans), -apple-system, BlinkMacSystemFont, sans-serif',
          borderRadius: '2px'
        };
    }
  };

  const { width, height, padding, color, text, fontSize, fontWeight, letterSpacing, textColor, fontFamily, borderRadius } = getCursorProps();

  // Lighten colors when pressed (dark background needs to brighten)
  const activeBackgroundColor = isPressed && cursorState === 'video' ? '#303030' : color;
  const activeTextColor = isPressed && cursorState === 'video' ? '#ffffff' : textColor;

  return (
    <>

      {/* Filled pill cursor with text */}
      <div
        style={{
          position: 'fixed',
          left: 0,
          top: 0,
          width: typeof width === 'number' ? `${width}px` : width,
          height: typeof height === 'number' ? `${height}px` : height,
          padding: padding,
          backgroundColor: activeBackgroundColor,
          opacity: isOverMetatag ? 0 : 1,
          pointerEvents: 'none',
          transform: `translate(${position.x}px, ${position.y}px) translate(-50%, -50%)`,
          transition: 'width 0.3s cubic-bezier(0.16, 1, 0.3, 1), height 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.1s ease-out, transform 0.04s ease-out, opacity 0.2s ease-out',
          zIndex: 9999,
          willChange: 'transform, width, height, background-color',
          borderRadius: borderRadius,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          color: activeTextColor,
          fontFamily: fontFamily,
          fontSize: fontSize,
          fontWeight: fontWeight,
          letterSpacing: letterSpacing,
          textTransform: cursorState === 'video' ? 'uppercase' : 'none',
          userSelect: 'none',
          overflow: 'hidden',
          perspective: '200px'
        }}
      >
        <span
          key={animationKey}
          style={{
            opacity: 1,
            lineHeight: 1,
            animation: cursorState === 'video' ? 'filmReelRotate 0.8s cubic-bezier(0.45, 0, 0.55, 1) forwards' : 'none',
            transformStyle: 'preserve-3d'
          }}
        >
          {text}
        </span>
      </div>
    </>
  );
}
