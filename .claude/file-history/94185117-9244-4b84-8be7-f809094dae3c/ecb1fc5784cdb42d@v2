'use client';

import { useState } from 'react';
import Link from 'next/link';

/**
 * ProcessThumbnail - Clean item card for PROCESS page
 *
 * COLOR HIERARCHY MANTRA:
 * - Title: --text-primary (brightest)
 * - Description: --grey-500 (medium)
 * - Version: --text-dim (dimmest)
 *
 * Information hierarchy = Color hierarchy
 */

interface ProcessThumbnailProps {
  slug: string;
  title: string;
  excerpt: string;
  version?: string;
  thumbnail?: string;
  githubUrl?: string;
}

export default function ProcessThumbnail({
  slug,
  title,
  excerpt,
  version,
  thumbnail,
  githubUrl
}: ProcessThumbnailProps) {
  const [isHovered, setIsHovered] = useState(false);

  // If there's a GitHub URL, link to that; otherwise link to internal page
  const linkProps = githubUrl
    ? { href: githubUrl, target: '_blank', rel: 'noopener noreferrer' as const }
    : { href: `/process/${slug}` };

  const Wrapper = githubUrl ? 'a' : Link;

  return (
    <Wrapper
      {...linkProps}
      className="flex flex-col sm:flex-row gap-4 sm:gap-6 group"
      onMouseEnter={() => setIsHovered(true)}
      onMouseLeave={() => setIsHovered(false)}
    >
      {/* Thumbnail - real image or placeholder */}
      {/* Mobile: full width capped at 390px, Desktop: 240px (125% of previous) */}
      <div
        className="flex-shrink-0 w-full max-w-[390px] sm:w-[240px] sm:max-w-none"
        style={{
          aspectRatio: '16 / 9',
          borderRadius: '4px',
          overflow: 'hidden',
          backgroundColor: thumbnail ? 'transparent' : 'rgba(255, 255, 255, 0.04)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center'
        }}
      >
        {thumbnail ? (
          <img
            src={thumbnail}
            alt={title}
            style={{
              width: '100%',
              height: '100%',
              objectFit: 'cover',
              opacity: isHovered ? 0.8 : 1,
              transition: 'opacity 200ms ease'
            }}
          />
        ) : (
          /* Placeholder X */
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="1.5"
            strokeLinecap="round"
            style={{
              color: isHovered ? 'rgba(255, 255, 255, 0.25)' : 'rgba(255, 255, 255, 0.15)',
              transition: 'color 200ms ease'
            }}
          >
            <path d="M6 6L18 18M6 18L18 6" />
          </svg>
        )}
      </div>

      {/* Content */}
      <div className="flex flex-col justify-center min-w-0">
        {/* Title - PRIMARY in hierarchy */}
        <h3
          className="text-[13px] sm:text-[17px] md:text-[clamp(17px,1.7vw,20px)] flex items-center gap-2"
          style={{
            color: isHovered ? 'var(--grey-50)' : 'var(--text-primary)',
            fontFamily: 'var(--font-display)',
            fontWeight: 500,
            lineHeight: 1.25,
            letterSpacing: '0.02em',
            marginBottom: '8px',
            transition: 'color 200ms ease'
          }}
        >
          {title}
          {/* GitHub indicator - TERTIARY */}
          {githubUrl && (
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              style={{
                color: isHovered ? 'var(--grey-500)' : 'var(--text-dim)',
                transition: 'color 200ms ease',
                flexShrink: 0
              }}
              aria-label="Available on GitHub"
            >
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          )}
        </h3>

        {/* Description - SECONDARY in hierarchy */}
        <p
          className="text-[13px] sm:text-[18px]"
          style={{
            color: 'var(--grey-500)',
            fontFamily: 'var(--font-display)',
            fontWeight: 300,
            lineHeight: 1.6,
            letterSpacing: '-0.01em',
            display: '-webkit-box',
            WebkitLineClamp: 2,
            WebkitBoxOrient: 'vertical',
            overflow: 'hidden'
          }}
        >
          {excerpt}
        </p>

        {/* Version - TERTIARY in hierarchy */}
        {version && (
          <span
            style={{
              color: 'var(--text-dim)',
              fontFamily: 'var(--font-display)',
              fontSize: '12px',
              fontWeight: 500,
              letterSpacing: '0.08em',
              textTransform: 'uppercase',
              marginTop: '12px'
            }}
          >
            v{version}
          </span>
        )}
      </div>
    </Wrapper>
  );
}
