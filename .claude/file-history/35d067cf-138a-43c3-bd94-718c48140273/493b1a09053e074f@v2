# ── Composition Tests ────────────────────────────────────────────────


class TestComposition:
    def test_compose_empty_layers(self):
        prims, conflicts = compose_livrps([])
        assert prims == []
        assert conflicts == []

    def test_compose_single_layer(self):
        p1 = CognitivePrim(name="A", phase="KNOWLEDGE", priority=10)
        p2 = CognitivePrim(name="B", phase="COST", priority=20)
        prims, conflicts = compose_livrps([("layer1", [p1, p2])])
        assert len(prims) == 2
        assert conflicts == []

    def test_stronger_layer_wins(self):
        weak = CognitivePrim(name="A", phase="COST", markdown_content="weak")
        strong = CognitivePrim(name="A", phase="COST", markdown_content="strong")
        prims, conflicts = compose_livrps([
            ("weak_layer", [weak]),
            ("strong_layer", [strong]),
        ])
        assert len(prims) == 1
        assert prims[0].markdown_content == "strong"
        assert len(conflicts) == 1

    def test_deterministic_100x(self):
        """Run composition 100 times, verify identical results."""
        p1 = CognitivePrim(name="A", phase="KNOWLEDGE", priority=10, markdown_content="a")
        p2 = CognitivePrim(name="B", phase="COST", priority=20, markdown_content="b")
        p3 = CognitivePrim(name="C", phase="SAFETY", priority=5, markdown_content="c")

        layers = [("base", [p1, p2, p3])]
        baseline_prims, baseline_conflicts = compose_livrps(layers)
        baseline_names = [p.name for p in baseline_prims]

        for _ in range(100):
            prims, conflicts = compose_livrps(layers)
            names = [p.name for p in prims]
            assert names == baseline_names

    def test_canonical_sort_by_phase_order(self):
        """Prims sort by PHASES order, not alphabetically."""
        p_cost = CognitivePrim(name="Z", phase="COST", priority=0)
        p_knowledge = CognitivePrim(name="A", phase="KNOWLEDGE", priority=0)
        prims, _ = compose_livrps([("layer", [p_cost, p_knowledge])])
        assert prims[0].phase == "KNOWLEDGE"
        assert prims[1].phase == "COST"


