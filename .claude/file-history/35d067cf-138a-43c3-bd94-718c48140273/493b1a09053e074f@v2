# ── Gain Tests ───────────────────────────────────────────────────────


class TestGain:
    def test_gain_identity_at_zero(self):
        """gain(any_phase, 0.0) == 1.0"""
        for phase in PHASES:
            assert abs(gain(phase, 0.0) - 1.0) < FLOAT_TOLERANCE

    def test_anchor_invariance(self):
        """gain(anchor_phase, any_s) == 1.0"""
        for phase in sorted(ANCHOR_PHASES):
            for profile_data in PROFILES.values():
                s = profile_data["s_NM"]
                assert abs(gain(phase, s) - 1.0) < FLOAT_TOLERANCE

    def test_gain_always_gte_one(self):
        for phase in PHASES:
            for s in [0.0, 0.005, 0.01, 0.015, 0.025]:
                assert gain(phase, s) >= 1.0 - FLOAT_TOLERANCE

    def test_gain_continuity(self):
        """Small s_NM change -> small gain change."""
        max_d = max(D_MAP.values())
        for phase in PHASES:
            g1 = gain(phase, 0.024)
            g2 = gain(phase, 0.026)
            assert abs(g1 - g2) < 0.002 * max_d + FLOAT_TOLERANCE

    def test_gain_with_alpha_identity(self):
        """alpha=0 -> gain=1.0"""
        for phase in PHASES:
            result = gain_with_alpha(phase, 0.025, 0.0)
            assert abs(result - 1.0) < FLOAT_TOLERANCE

    def test_gain_with_alpha_full(self):
        """alpha=1 -> gain = gain(phase, s)"""
        for phase in PHASES:
            expected = gain(phase, 0.025)
            result = gain_with_alpha(phase, 0.025, 1.0)
            assert abs(result - expected) < FLOAT_TOLERANCE

    def test_unknown_phase_raises(self):
        try:
            gain("NONEXISTENT", 0.01)
            assert False, "Should have raised"
        except ValueError:
            pass


# ── Pharmacokinetics Tests ───────────────────────────────────────────


class TestPharmacokinetics:
    def test_none_profile_always_zero(self):
        for t in range(20):
            assert abs(pharmacokinetic_alpha("none", t, 0, True)) < FLOAT_TOLERANCE
            assert abs(pharmacokinetic_alpha("none", 0, t, False)) < FLOAT_TOLERANCE

    def test_onset_reaches_high(self):
        """Alpha reaches >0.95 within onset_exchanges."""
        for name in sorted(PROFILES.keys()):
            if name == "none":
                continue
            from src.lossless.constants import ONSET_EXCHANGES
            onset = ONSET_EXCHANGES[name]
            alpha = pharmacokinetic_alpha(name, onset, 0, True)
            assert alpha > 0.95 - FLOAT_TOLERANCE, f"{name}: alpha={alpha}"

    def test_offset_drops_low(self):
        """Alpha drops below 0.05 within offset_exchanges."""
        for name in sorted(PROFILES.keys()):
            if name == "none":
                continue
            from src.lossless.constants import OFFSET_EXCHANGES
            offset = OFFSET_EXCHANGES[name]
            alpha = pharmacokinetic_alpha(name, 0, offset, False)
            assert alpha < 0.05 + FLOAT_TOLERANCE, f"{name}: alpha={alpha}"

    def test_onset_monotonic(self):
        """Alpha is monotonically increasing during onset."""
        for name in sorted(PROFILES.keys()):
            if name == "none":
                continue
            prev = 0.0
            for t in range(20):
                a = pharmacokinetic_alpha(name, t, 0, True)
                assert a >= prev - FLOAT_TOLERANCE, f"{name} t={t}: {a} < {prev}"
                prev = a

    def test_offset_monotonic(self):
        """Alpha is monotonically decreasing during offset."""
        for name in sorted(PROFILES.keys()):
            if name == "none":
                continue
            prev = 1.0
            for t in range(20):
                a = pharmacokinetic_alpha(name, 0, t, False)
                assert a <= prev + FLOAT_TOLERANCE, f"{name} t={t}: {a} > {prev}"
                prev = a
