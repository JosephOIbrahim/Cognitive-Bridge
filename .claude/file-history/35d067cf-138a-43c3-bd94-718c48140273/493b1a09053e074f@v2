# ── Constants Tests ──────────────────────────────────────────────────


class TestConstants:
    def test_all_anchor_phases_in_phases(self):
        for phase in ANCHOR_PHASES:
            assert phase in PHASES

    def test_all_modulated_phases_in_phases(self):
        for phase in MODULATED_PHASES:
            assert phase in PHASES

    def test_anchor_and_modulated_are_disjoint(self):
        assert len(ANCHOR_PHASES & MODULATED_PHASES) == 0

    def test_anchor_and_modulated_cover_all_phases(self):
        assert ANCHOR_PHASES | MODULATED_PHASES == set(PHASES)

    def test_d_map_covers_all_phases(self):
        for phase in PHASES:
            assert phase in D_MAP

    def test_d_map_values_in_valid_range(self):
        for phase, d in sorted(D_MAP.items()):
            assert 0.0 <= d <= 1.0, f"{phase}: d={d}"

    def test_profiles_none_has_zero_s_nm(self):
        assert abs(PROFILES["none"]["s_NM"]) < FLOAT_TOLERANCE

    def test_profiles_none_is_standard_routing(self):
        assert PROFILES["none"]["routing"] == "standard"

    def test_all_profiles_have_required_keys(self):
        required = {"s_NM", "routing", "cross_expert", "tangent_mult"}
        for name in sorted(PROFILES.keys()):
            assert required.issubset(PROFILES[name].keys()), name

    def test_phase_count_matches(self):
        assert PHASE_COUNT == len(PHASES) == 10

    def test_expert_count_matches(self):
        assert EXPERT_COUNT == len(EXPERTS) == 7

    def test_cognitive_tile_size_positive(self):
        assert COGNITIVE_TILE_SIZE > 0

    def test_routing_modes_are_known(self):
        for profile_data in PROFILES.values():
            assert profile_data["routing"] in ROUTING_MODES


# ── Phase Tests ──────────────────────────────────────────────────────


class TestPhases:
    def test_build_phase_registry_covers_all(self):
        registry = build_phase_registry()
        assert set(registry.keys()) == set(PHASES)

    def test_phase_anchor_flag_matches_constants(self):
        registry = build_phase_registry()
        for name, phase in sorted(registry.items()):
            expected = name in ANCHOR_PHASES
            assert phase.is_anchor == expected, name

    def test_phase_index_matches_order(self):
        registry = build_phase_registry()
        for i, name in enumerate(PHASES):
            assert registry[name].index == i

    def test_get_ordered_phases_preserves_order(self):
        ordered = get_ordered_phases()
        assert [p.name for p in ordered] == PHASES

    def test_anchor_modulated_partition(self):
        anchors = get_anchor_phases()
        modulated = get_modulated_phases()
        all_names = {p.name for p in anchors} | {p.name for p in modulated}
        assert all_names == set(PHASES)

    def test_phase_is_frozen(self):
        phase = Phase(name="TEST", index=0, is_anchor=True, receptor_density=0.5)
        try:
            phase.name = "OTHER"
            assert False, "Should have raised"
        except AttributeError:
            pass


