    @patch("agent.tools.pipeline._resolve_stage_outputs")
    @patch("agent.tools.pipeline._execute_stage_workflow")
    @patch("agent.tools.pipeline._load_workflow_for_stage")
    def test_run_stop_on_error_true(self, mock_load, mock_exec, mock_resolve):
        """stop_on_error=True halts pipeline after first stage failure."""
        # First call loads OK, second load fails
        mock_load.side_effect = [
            (None, "Template not found: bad_template"),
            (_minimal_workflow(), None),
        ]
        mock_exec.return_value = _mock_exec_success()
        mock_resolve.return_value = [_mock_resolved_output()]

        pipeline = {
            "name": "stop_test",
            "stages": [
                {"stage_id": "s1", "workflow_source": "template:bad_template"},
                {"stage_id": "s2", "workflow_source": "template:txt2img_sdxl"},
            ],
        }
        with patch("agent.tools.pipeline.handle") as mock_dispatch:
            mock_dispatch.return_value = json.dumps({"recorded": True})
            result = json.loads(handle("run_pipeline", {
                "pipeline": pipeline,
                "stop_on_error": True,
            }))

        assert result["status"] == "error"
        assert result["stages_completed"] == 0
        assert result["stages_failed"] == 1
        # Only one stage result — second stage was never started
        assert len(result["stage_results"]) == 1

