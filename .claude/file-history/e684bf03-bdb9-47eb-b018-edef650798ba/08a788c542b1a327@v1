class TestCreatePipeline:
    def test_create_simple_two_stage(self):
        """Create a pipeline with two stages returns correct summary."""
        result = json.loads(handle("create_pipeline", {
            "name": "my_pipe",
            "stages": [
                {"stage_id": "gen", "workflow_source": "template:txt2img_sdxl"},
                {"stage_id": "upscale", "workflow_source": "template:upscale_basic"},
            ],
        }))
        assert result["created"] is True
        assert result["name"] == "my_pipe"
        assert result["stage_count"] == 2
        assert len(result["stages"]) == 2
        assert result["stages"][0]["stage_id"] == "gen"
        assert result["stages"][1]["stage_id"] == "upscale"
        assert "run_pipeline" in result["message"]

    def test_create_stores_pipeline_in_state(self):
        """Pipeline definition is saved to module state after creation."""
        handle("create_pipeline", {
            "stages": [
                {"stage_id": "stage1", "workflow_source": "template:txt2img_sdxl"},
            ],
        })
        with _pipeline_lock:
            current = _pipeline_state["current_pipeline"]
        assert current is not None
        assert current["stages"][0]["stage_id"] == "stage1"

    def test_create_sets_status_idle(self):
        """Status is reset to idle on create."""
        # Dirty the state first
        with _pipeline_lock:
            _pipeline_state["status"] = "error"
            _pipeline_state["error"] = "previous error"

        handle("create_pipeline", {
            "stages": [
                {"stage_id": "s1", "workflow_source": "template:txt2img_sdxl"},
            ],
        })
        with _pipeline_lock:
            assert _pipeline_state["status"] == "idle"
            assert _pipeline_state["error"] is None
            assert _pipeline_state["execution_results"] == []

    def test_create_with_input_mappings_in_summary(self):
        """Input mappings are reflected in the stage summary."""
        result = json.loads(handle("create_pipeline", {
            "stages": [
                {"stage_id": "gen", "workflow_source": "template:txt2img_sdxl"},
                {
                    "stage_id": "upscale",
                    "workflow_source": "template:upscale_basic",
                    "input_mappings": [
                        {
                            "node_id": "10",
                            "input_name": "image",
                            "from_stage": "gen",
                            "output_index": 0,
                        },
                    ],
                },
            ],
        }))
        assert result["created"] is True
        upscale_summary = result["stages"][1]
        assert "receives_from" in upscale_summary
        assert "gen" in upscale_summary["receives_from"]

    def test_create_with_param_overrides_in_summary(self):
        """param_overrides count is included in stage summary."""
        result = json.loads(handle("create_pipeline", {
            "stages": [
                {
                    "stage_id": "gen",
                    "workflow_source": "template:txt2img_sdxl",
                    "param_overrides": {
                        "3.seed": 99,
                        "6.text": "a beautiful cat",
                    },
                },
            ],
        }))
        assert result["created"] is True
        assert result["stages"][0]["override_count"] == 2

    def test_create_error_empty_stages(self):
        """Empty stages list is rejected."""
        result = json.loads(handle("create_pipeline", {"stages": []}))
        assert "error" in result
        assert "at least one stage" in result["error"].lower()

    def test_create_error_duplicate_stage_ids(self):
        """Duplicate stage_id values are rejected."""
        result = json.loads(handle("create_pipeline", {
            "stages": [
                {"stage_id": "gen", "workflow_source": "template:a"},
                {"stage_id": "gen", "workflow_source": "template:b"},
            ],
        }))
        assert "error" in result
        assert "duplicate" in result["error"].lower()

    def test_create_error_missing_workflow_source(self):
        """Missing workflow_source is rejected."""
        result = json.loads(handle("create_pipeline", {
            "stages": [
                {"stage_id": "gen"},
            ],
        }))
        assert "error" in result
        assert "workflow_source" in result["error"]

    def test_create_error_forward_reference_in_input_mapping(self):
        """Input mapping that references a later stage is rejected."""
        result = json.loads(handle("create_pipeline", {
            "stages": [
                {
                    "stage_id": "gen",
                    "workflow_source": "template:txt2img_sdxl",
                    "input_mappings": [
                        {
                            "node_id": "10",
                            "input_name": "image",
                            "from_stage": "upscale",  # forward reference!
                        },
                    ],
                },
                {"stage_id": "upscale", "workflow_source": "template:upscale_basic"},
            ],
        }))
        assert "error" in result
        assert "upscale" in result["error"]

    def test_create_default_name(self):
        """Pipeline gets a default name when none is specified."""
        result = json.loads(handle("create_pipeline", {
            "stages": [
                {"stage_id": "s1", "workflow_source": "template:txt2img_sdxl"},
            ],
        }))
        assert result["created"] is True
        assert result["name"] == "unnamed_pipeline"

    def test_create_error_missing_stage_id(self):
        """Stage missing stage_id is rejected."""
        result = json.loads(handle("create_pipeline", {
            "stages": [
                {"workflow_source": "template:txt2img_sdxl"},
            ],
        }))
        assert "error" in result
        assert "stage_id" in result["error"]


