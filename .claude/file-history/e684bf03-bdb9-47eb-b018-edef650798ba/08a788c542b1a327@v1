class TestApplyParamOverrides:
    def test_valid_override_applied(self):
        """Valid 'node_id.input_name' override is applied in-place."""
        wf = {
            "3": {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 20}},
        }
        errors = _apply_param_overrides(wf, {"3.seed": 999})
        assert errors == []
        assert wf["3"]["inputs"]["seed"] == 999

    def test_multiple_overrides_applied(self):
        """Multiple overrides are all applied."""
        wf = {
            "3": {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 20}},
            "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "default"}},
        }
        errors = _apply_param_overrides(wf, {
            "3.seed": 42,
            "3.steps": 30,
            "6.text": "new prompt",
        })
        assert errors == []
        assert wf["3"]["inputs"]["seed"] == 42
        assert wf["3"]["inputs"]["steps"] == 30
        assert wf["6"]["inputs"]["text"] == "new prompt"

    def test_override_creates_missing_inputs_key(self):
        """Override creates 'inputs' dict if node doesn't have one."""
        wf = {"5": {"class_type": "EmptyLatentImage"}}
        errors = _apply_param_overrides(wf, {"5.width": 512})
        assert errors == []
        assert wf["5"]["inputs"]["width"] == 512

    def test_invalid_key_format_no_dot(self):
        """Override key without dot separator returns error."""
        wf = {"3": {"class_type": "KSampler", "inputs": {}}}
        errors = _apply_param_overrides(wf, {"seedonly": 42})
        assert len(errors) == 1
        assert "node_id.input_name" in errors[0]

    def test_invalid_key_empty_string(self):
        """Empty override key returns error."""
        wf = {"3": {"class_type": "KSampler", "inputs": {}}}
        errors = _apply_param_overrides(wf, {"": 42})
        assert len(errors) == 1

    def test_missing_node_returns_error(self):
        """Override targeting nonexistent node returns error."""
        wf = {"3": {"class_type": "KSampler", "inputs": {}}}
        errors = _apply_param_overrides(wf, {"99.seed": 1})
        assert len(errors) == 1
        assert "99" in errors[0]

    def test_deterministic_override_order(self):
        """Multiple overrides are applied in sorted key order (He2025)."""
        applied_order = []
        original_setdefault = dict.setdefault

        wf = {
            "a": {"class_type": "NodeA", "inputs": {}},
            "z": {"class_type": "NodeZ", "inputs": {}},
            "m": {"class_type": "NodeM", "inputs": {}},
        }
        # He2025 requires sorted override application — verify no error
        errors = _apply_param_overrides(wf, {
            "z.val": 3,
            "a.val": 1,
            "m.val": 2,
        })
        assert errors == []
        assert wf["a"]["inputs"]["val"] == 1
        assert wf["m"]["inputs"]["val"] == 2
        assert wf["z"]["inputs"]["val"] == 3

    def test_mixed_valid_and_invalid_overrides(self):
        """Valid overrides applied; errors collected for invalid ones."""
        wf = {
            "3": {"class_type": "KSampler", "inputs": {"seed": 0}},
        }
        errors = _apply_param_overrides(wf, {
            "3.seed": 100,       # valid
            "badkey": 99,        # invalid format
            "99.steps": 20,      # missing node
        })
        assert len(errors) == 2
        assert wf["3"]["inputs"]["seed"] == 100  # valid was still applied


