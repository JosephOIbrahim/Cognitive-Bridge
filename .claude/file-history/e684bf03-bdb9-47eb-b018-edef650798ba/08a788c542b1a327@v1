class TestPipelineStatus:
    def test_status_no_pipeline(self):
        """Returns no_pipeline status when nothing has been created."""
        result = json.loads(handle("get_pipeline_status", {}))
        assert result["status"] == "no_pipeline"
        assert "create_pipeline" in result["message"]

