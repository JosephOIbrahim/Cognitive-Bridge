class TestApplyInputMappings:
    def _make_workflow_with_load_image(self):
        return {
            "10": {"class_type": "LoadImage", "inputs": {"image": "placeholder.png"}},
        }

    def test_valid_mapping_wires_filename(self):
        """Valid mapping sets the filename from source stage output."""
        wf = self._make_workflow_with_load_image()
        stage_outputs = {
            "gen": [
                {
                    "filename": "gen_out.png",
                    "absolute_path": "/output/gen_out.png",
                    "exists": True,
                    "size_bytes": 1024,
                    "type": "image",
                }
            ],
        }
        errors = _apply_input_mappings(
            wf,
            [{"node_id": "10", "input_name": "image", "from_stage": "gen", "output_index": 0}],
            stage_outputs,
        )
        assert errors == []
        assert wf["10"]["inputs"]["image"] == "gen_out.png"

    def test_output_index_selects_correct_output(self):
        """output_index selects the correct entry from the source outputs."""
        wf = self._make_workflow_with_load_image()
        stage_outputs = {
            "gen": [
                {"filename": "first.png", "type": "image"},
                {"filename": "second.png", "type": "image"},
            ],
        }
        errors = _apply_input_mappings(
            wf,
            [{"node_id": "10", "input_name": "image", "from_stage": "gen", "output_index": 1}],
            stage_outputs,
        )
        assert errors == []
        assert wf["10"]["inputs"]["image"] == "second.png"

    def test_missing_stage_output_returns_error(self):
        """Mapping from a stage with no outputs returns error."""
        wf = self._make_workflow_with_load_image()
        stage_outputs = {}  # gen has no outputs recorded
        errors = _apply_input_mappings(
            wf,
            [{"node_id": "10", "input_name": "image", "from_stage": "gen", "output_index": 0}],
            stage_outputs,
        )
        assert len(errors) == 1
        assert "gen" in errors[0]
        assert "no captured outputs" in errors[0]

    def test_output_index_out_of_range_returns_error(self):
        """output_index beyond available outputs returns error."""
        wf = self._make_workflow_with_load_image()
        stage_outputs = {
            "gen": [{"filename": "only_one.png", "type": "image"}],
        }
        errors = _apply_input_mappings(
            wf,
            [{"node_id": "10", "input_name": "image", "from_stage": "gen", "output_index": 5}],
            stage_outputs,
        )
        assert len(errors) == 1
        assert "out of range" in errors[0]
        assert "5" in errors[0]

    def test_output_entry_missing_filename_returns_error(self):
        """Output entry without 'filename' key returns error."""
        wf = self._make_workflow_with_load_image()
        stage_outputs = {
            "gen": [{"type": "image"}],  # no filename
        }
        errors = _apply_input_mappings(
            wf,
            [{"node_id": "10", "input_name": "image", "from_stage": "gen", "output_index": 0}],
            stage_outputs,
        )
        assert len(errors) == 1
        assert "no filename" in errors[0]

    def test_target_node_missing_from_workflow_returns_error(self):
        """Mapping to a node not in the workflow returns error."""
        wf = {}  # no nodes at all
        stage_outputs = {
            "gen": [{"filename": "out.png", "type": "image"}],
        }
        errors = _apply_input_mappings(
            wf,
            [{"node_id": "99", "input_name": "image", "from_stage": "gen", "output_index": 0}],
            stage_outputs,
        )
        assert len(errors) == 1
        assert "99" in errors[0]
        assert "not found" in errors[0]

    def test_empty_mappings_no_errors(self):
        """Empty mappings list returns no errors and makes no changes."""
        wf = {"10": {"class_type": "LoadImage", "inputs": {"image": "original.png"}}}
        errors = _apply_input_mappings(wf, [], {})
        assert errors == []
        assert wf["10"]["inputs"]["image"] == "original.png"

    def test_default_output_index_is_zero(self):
        """Mapping without output_index defaults to index 0."""
        wf = self._make_workflow_with_load_image()
        stage_outputs = {
            "gen": [
                {"filename": "zero_idx.png", "type": "image"},
                {"filename": "one_idx.png", "type": "image"},
            ],
        }
        # omit output_index entirely
        errors = _apply_input_mappings(
            wf,
            [{"node_id": "10", "input_name": "image", "from_stage": "gen"}],
            stage_outputs,
        )
        assert errors == []
        assert wf["10"]["inputs"]["image"] == "zero_idx.png"


