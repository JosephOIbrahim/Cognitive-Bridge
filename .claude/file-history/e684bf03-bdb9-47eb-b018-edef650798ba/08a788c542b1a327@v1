class TestValidatePipelineDefinition:
    def test_valid_single_stage(self):
        err = _validate_pipeline_definition({
            "stages": [
                {"stage_id": "s1", "workflow_source": "template:txt2img_sdxl"},
            ],
        })
        assert err is None

    def test_valid_two_stage_with_mapping(self):
        err = _validate_pipeline_definition({
            "stages": [
                {"stage_id": "gen", "workflow_source": "template:a"},
                {
                    "stage_id": "up",
                    "workflow_source": "template:b",
                    "input_mappings": [
                        {"node_id": "10", "input_name": "image", "from_stage": "gen"},
                    ],
                },
            ],
        })
        assert err is None

    def test_invalid_no_stages_key(self):
        err = _validate_pipeline_definition({})
        assert err is not None
        assert "at least one stage" in err.lower()

    def test_invalid_empty_stages(self):
        err = _validate_pipeline_definition({"stages": []})
        assert err is not None

    def test_invalid_stages_not_list(self):
        err = _validate_pipeline_definition({"stages": "not a list"})
        assert err is not None
        assert "array" in err.lower()

    def test_invalid_stage_not_dict(self):
        err = _validate_pipeline_definition({"stages": ["a_string"]})
        assert err is not None
        assert "object" in err.lower()

    def test_invalid_missing_stage_id(self):
        err = _validate_pipeline_definition({
            "stages": [{"workflow_source": "template:a"}],
        })
        assert err is not None
        assert "stage_id" in err

    def test_invalid_empty_stage_id(self):
        err = _validate_pipeline_definition({
            "stages": [{"stage_id": "", "workflow_source": "template:a"}],
        })
        assert err is not None

    def test_invalid_duplicate_stage_id(self):
        err = _validate_pipeline_definition({
            "stages": [
                {"stage_id": "s1", "workflow_source": "template:a"},
                {"stage_id": "s1", "workflow_source": "template:b"},
            ],
        })
        assert err is not None
        assert "duplicate" in err.lower()
        assert "s1" in err

    def test_invalid_missing_workflow_source(self):
        err = _validate_pipeline_definition({
            "stages": [{"stage_id": "s1"}],
        })
        assert err is not None
        assert "workflow_source" in err

    def test_invalid_forward_reference(self):
        err = _validate_pipeline_definition({
            "stages": [
                {
                    "stage_id": "s1",
                    "workflow_source": "template:a",
                    "input_mappings": [
                        {"node_id": "1", "input_name": "img", "from_stage": "s2"},
                    ],
                },
                {"stage_id": "s2", "workflow_source": "template:b"},
            ],
        })
        assert err is not None
        assert "s2" in err
        assert "earlier stages" in err.lower() or "hasn't been defined" in err.lower()

    def test_self_reference_passes_validation(self):
        """A stage referencing itself via from_stage passes validation.

        The validator adds the current stage_id to seen_ids before checking
        its own input_mappings, so self-references resolve successfully.
        This is a deliberate implementation choice -- the stage will simply
        receive no resolved output at runtime since its own outputs aren't
        yet available during execution.
        """
        err = _validate_pipeline_definition({
            "stages": [
                {
                    "stage_id": "s1",
                    "workflow_source": "template:a",
                    "input_mappings": [
                        {"node_id": "1", "input_name": "img", "from_stage": "s1"},
                    ],
                },
            ],
        })
        assert err is None


