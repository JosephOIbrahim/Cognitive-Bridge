{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/User/.claude/hooks/guard-deployed-files.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/User/.claude/hooks/guard-dangerous-bash.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/User/.claude/hooks/check-python-encoding.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/User/.claude/hooks/session-start-check.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers-developing-for-claude-code@superpowers-developing-for-claude-code-dev": true,
    "last30days@last30days": true,
    "image-generator@dair-academy-plugins": true,
    "llm-council@dair-academy-plugins": true
  },
  "effortLevel": "medium"
}
