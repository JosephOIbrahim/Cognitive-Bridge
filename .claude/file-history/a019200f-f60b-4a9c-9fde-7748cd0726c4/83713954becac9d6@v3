/* ── SUPER DUPER Sidebar Styles ────────────────────────────────────── */
/* Designed to match ComfyUI's dark theme.                              */

.sd-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: #4a9eff;
  border-bottom: 1px solid #3a3a3a;
  flex-shrink: 0;
}

.sd-header__title {
  flex: 1;
}

.sd-header__status {
  font-size: 11px;
  font-weight: 400;
  color: #666;
}

.sd-header__status--connecting {
  color: #e6a817;
}

.sd-header__status--disconnected {
  color: #e65050;
}

/* ── Stage indicator ─────────────────────────────────────────────── */

.sd-stage-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 16px;
  background: #1a2a3a;
  border-bottom: 1px solid #3a3a3a;
  flex-shrink: 0;
  font-size: 12px;
  animation: sd-pulse 1.5s ease-in-out infinite;
}

.sd-stage__label {
  color: #4a9eff;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.sd-stage__detail {
  color: #888;
}

@keyframes sd-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.sd-messages {
  flex: 1;
  overflow-y: auto;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* ── Messages ─────────────────────────────────────────────────────── */

.sd-message {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 8px 10px;
  border-radius: 6px;
  font-size: 13px;
  line-height: 1.45;
  word-wrap: break-word;
}

.sd-message--user {
  background: #2a3a4a;
  align-self: flex-end;
  max-width: 90%;
}

.sd-message--agent {
  background: #333;
  align-self: flex-start;
  max-width: 90%;
}

.sd-message--system {
  background: transparent;
  color: #888;
  font-style: italic;
  font-size: 12px;
  align-self: center;
}

.sd-message__label {
  font-size: 11px;
  font-weight: 600;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.sd-message--user .sd-message__label {
  color: #4a9eff;
}

.sd-message--agent .sd-message__label {
  color: #6fcf97;
}

.sd-message__body {
  color: #eee;
}

.sd-message--system .sd-message__body {
  color: #888;
}

/* ── Input bar ────────────────────────────────────────────────────── */

.sd-input-bar {
  display: flex;
  gap: 6px;
  padding: 10px 12px;
  border-top: 1px solid #3a3a3a;
  flex-shrink: 0;
}

.sd-input {
  flex: 1;
  background: #1e1e1e;
  border: 1px solid #444;
  border-radius: 6px;
  padding: 8px 10px;
  color: #eee;
  font-size: 13px;
  outline: none;
  transition: border-color 0.15s;
}

.sd-input:focus {
  border-color: #4a9eff;
}

.sd-input::placeholder {
  color: #666;
}

.sd-send-btn {
  background: #4a9eff;
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
  flex-shrink: 0;
}

.sd-send-btn:hover {
  background: #3a8eef;
}

.sd-send-btn:active {
  background: #2a7edf;
}

.sd-send-btn:disabled {
  background: #555;
  cursor: not-allowed;
}

/* ── Scrollbar ────────────────────────────────────────────────────── */

.sd-messages::-webkit-scrollbar {
  width: 6px;
}

.sd-messages::-webkit-scrollbar-track {
  background: transparent;
}

.sd-messages::-webkit-scrollbar-thumb {
  background: #444;
  border-radius: 3px;
}

.sd-messages::-webkit-scrollbar-thumb:hover {
  background: #555;
}
