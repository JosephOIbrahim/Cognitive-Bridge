/* ComfyUI 3D Viewport Bridge — Sidebar Panel Styles */

.viewport-bridge-panel {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    color: #ddd;
    padding: 8px;
    width: 100%;
    box-sizing: border-box;
}

/* Header */
.vb-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0 10px;
    border-bottom: 1px solid #444;
    margin-bottom: 8px;
}

.vb-title {
    font-size: 13px;
    font-weight: 600;
    color: #eee;
}

.vb-status {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 10px;
    background: #555;
    color: #aaa;
}

.vb-status-connected {
    background: #1a3a1a;
    color: #6c6;
}

.vb-status-disconnected {
    background: #3a1a1a;
    color: #c66;
}

.vb-status-error {
    background: #3a2a1a;
    color: #ca6;
}

/* Sections */
.vb-section {
    margin-bottom: 12px;
}

.vb-section-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #888;
    margin-bottom: 6px;
}

/* Camera info rows */
.vb-camera-info {
    background: #2a2a2a;
    border-radius: 4px;
    padding: 4px 0;
}

.vb-row {
    display: flex;
    justify-content: space-between;
    padding: 3px 8px;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
}

.vb-row span:first-child {
    color: #888;
    min-width: 50px;
}

.vb-row span:last-child {
    color: #ccc;
    text-align: right;
}

/* Preset buttons */
.vb-presets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
}

.vb-preset-btn {
    background: #333;
    border: 1px solid #555;
    border-radius: 4px;
    color: #ccc;
    padding: 6px 4px;
    font-size: 11px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
}

.vb-preset-btn:hover {
    background: #444;
    border-color: #777;
    color: #fff;
}

.vb-preset-btn:active {
    background: #555;
}

/* AOV grid */
.vb-aov-grid {
    background: #2a2a2a;
    border-radius: 4px;
    padding: 6px 8px;
    margin-bottom: 6px;
    min-height: 30px;
}

.vb-aov-empty {
    color: #666;
    font-style: italic;
    font-size: 11px;
    text-align: center;
    padding: 4px 0;
}

.vb-aov-card {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
}

.vb-aov-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6c6;
    flex-shrink: 0;
}

.vb-aov-name {
    font-size: 11px;
    color: #bbb;
    text-transform: capitalize;
}

.vb-aov-btn {
    width: 100%;
    background: #2a3a4a;
    border: 1px solid #4a6a8a;
    border-radius: 4px;
    color: #8ab;
    padding: 6px;
    font-size: 11px;
    cursor: pointer;
    transition: background 0.15s;
}

.vb-aov-btn:hover {
    background: #3a4a5a;
    color: #acd;
}

.vb-aov-btn:active {
    background: #4a5a6a;
}

/* Fallback panel wrapper (when sidebar API is not available) */
.vb-panel-wrapper {
    position: fixed;
    left: 48px;
    top: 0;
    width: 240px;
    height: 100vh;
    background: #1e1e1e;
    border-right: 1px solid #444;
    z-index: 1000;
    overflow-y: auto;
}
