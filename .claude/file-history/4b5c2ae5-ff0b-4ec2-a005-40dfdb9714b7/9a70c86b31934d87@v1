.ctaBlock {
  padding: clamp(48px, 8vh, 100px) 0 clamp(32px, 4vh, 60px);
  text-align: center;
  cursor: pointer;
}

.ctaText {
  font-size: clamp(32px, 4.5vw, 56px);
  font-weight: 400;
  letter-spacing: -0.02em;
  margin: 0;
  line-height: 1.2;
  transition: color 300ms var(--ease);
}

.ctaEmail {
  font-size: 13px;
  color: var(--muted);
  margin-top: 20px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-weight: 400;
}

.infoBar {
  padding: 32px var(--pad);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.socials {
  display: flex;
  align-items: center;
  gap: 16px;
}

.socialLink {
  display: flex;
  color: var(--muted-light);
  transition: color 200ms var(--ease);
}

.socialLink:hover {
  color: var(--text);
}

.copyright {
  font-size: 11px;
  color: var(--muted-light);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  text-align: center;
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  justify-content: center;
}

@media (max-width: 768px) {
  .ctaText {
    font-size: clamp(28px, 6vw, 48px) !important;
  }
}
