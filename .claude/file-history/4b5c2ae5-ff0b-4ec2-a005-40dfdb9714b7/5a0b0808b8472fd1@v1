"use client";

import { useInView } from "@/lib/hooks";
import { T } from "@/lib/tokens";

interface AnimatedTextProps {
  text: string;
  as?: "p" | "h1" | "h2" | "h3" | "span" | "div";
  style?: React.CSSProperties;
  delay?: number;
}

export function AnimatedText({ text, as: Tag = "p", style = {}, delay = 0 }: AnimatedTextProps) {
  const [ref, inView] = useInView({ threshold: 0.3 });

  const words = text.split(" ");
  const lineSize = Math.ceil(words.length / 2);
  const lines = [
    words.slice(0, lineSize).join(" "),
    words.slice(lineSize).join(" "),
  ].filter((l) => l.length > 0);

  return (
    <div ref={ref}>
    <Tag style={{ ...style, overflow: "hidden" }}>
      {lines.map((line, i) => (
        <span
          key={i}
          style={{
            display: "block",
            opacity: inView ? 1 : 0,
            transform: inView ? "translateY(0)" : "translateY(-100%)",
            transition: `all 700ms ${T.easeOut} ${delay + i * 120}ms`,
          }}
        >
          {line}{" "}
        </span>
      ))}
    </Tag>
    </div>
  );
}
