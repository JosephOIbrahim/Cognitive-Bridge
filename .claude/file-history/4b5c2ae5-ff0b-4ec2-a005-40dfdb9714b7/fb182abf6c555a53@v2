import { notFound } from "next/navigation";
import { THOUGHTS } from "@/lib/projects";
import { ARTICLE_CONTENT } from "@/lib/article-content";
import Link from "next/link";
import type { Metadata } from "next";

interface PageProps {
  params: Promise<{ slug: string }>;
}

export async function generateStaticParams() {
  return THOUGHTS.map((t) => ({ slug: t.slug }));
}

export async function generateMetadata({ params }: PageProps): Promise<Metadata> {
  const { slug } = await params;
  const thought = THOUGHTS.find((t) => t.slug === slug);
  if (!thought) return {};
  return { title: thought.title, description: thought.excerpt };
}

export default async function ArticlePage({ params }: PageProps) {
  const { slug } = await params;
  const article = THOUGHTS.find((t) => t.slug === slug);
  if (!article) notFound();

  const paragraphs = ARTICLE_CONTENT[slug] || [];

  return (
    <div style={{ padding: "var(--nav-h) var(--pad) clamp(48px, 6vh, 80px)" }}>
      <div style={{ maxWidth: 680, margin: "0 auto", paddingTop: "clamp(48px, 10vh, 120px)" }}>
        <Link href="/thoughts" style={{ fontSize: 13, color: "var(--muted)", letterSpacing: "0.06em", textTransform: "uppercase", display: "flex", alignItems: "center", gap: 8, marginBottom: "clamp(48px, 6vh, 72px)" }}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5">
            <path d="M8 1L2 7L8 13" />
          </svg>
          Thoughts
        </Link>

        <span style={{ fontSize: 11, color: "var(--muted-light)", letterSpacing: "0.08em", textTransform: "uppercase", display: "block", marginBottom: 16 }}>
          {article.date}
        </span>

        <h1 style={{ fontSize: "clamp(28px, 3.5vw, 48px)", fontWeight: 400, letterSpacing: "-0.02em", color: "var(--text)", margin: "0 0 clamp(32px, 4vh, 48px)", lineHeight: 1.15 }}>
          {article.title}
        </h1>

        <div style={{ width: 40, height: 1, background: "var(--border)", marginBottom: "clamp(32px, 4vh, 48px)" }} />

        <div style={{ fontSize: "clamp(16px, 1.3vw, 18px)", lineHeight: 1.75 }}>
          {paragraphs.map((p, i) => (
            <p key={i} style={{ margin: "0 0 28px", color: i === 0 ? "var(--text)" : "var(--muted)" }}>
              {p}
            </p>
          ))}
        </div>
      </div>
    </div>
  );
}
