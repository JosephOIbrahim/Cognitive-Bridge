/**
 * Scans public/images/ and generates src/lib/image-manifest.ts
 *
 * Run after adding/removing images:
 *   node scripts/generate-image-manifest.mjs
 *
 * This eliminates hardcoded image counts that can drift from actual files.
 */

import { readdir } from "node:fs/promises";
import { writeFile } from "node:fs/promises";
import { join } from "node:path";

const IMAGES_DIR = "public/images";
const OUTPUT_FILE = "src/lib/image-manifest.ts";

async function scan() {
  const slugDirs = await readdir(IMAGES_DIR, { withFileTypes: true });
  const manifest = {};

  for (const entry of slugDirs.sort((a, b) => a.name.localeCompare(b.name))) {
    if (!entry.isDirectory()) continue;
    const slug = entry.name;
    const files = await readdir(join(IMAGES_DIR, slug));

    const hasHero = files.includes("hero.jpg");
    const details = files
      .filter((f) => f.startsWith("detail-") && f.endsWith(".jpg"))
      .sort()
      .map((f) => `/images/${slug}/${f}`);

    manifest[slug] = {
      hero: hasHero ? `/images/${slug}/hero.jpg` : null,
      details,
    };
  }

  const lines = [
    "/** Auto-generated by scripts/generate-image-manifest.mjs -- do not edit manually */",
    "",
    "export interface ProjectImages {",
    "  hero: string | null;",
    "  details: string[];",
    "}",
    "",
    "export const IMAGE_MANIFEST: Record<string, ProjectImages> = {",
  ];

  for (const [slug, data] of Object.entries(manifest)) {
    lines.push(`  "${slug}": {`);
    lines.push(`    hero: ${data.hero ? `"${data.hero}"` : "null"},`);
    lines.push(`    details: [`);
    for (const d of data.details) {
      lines.push(`      "${d}",`);
    }
    lines.push(`    ],`);
    lines.push(`  },`);
  }

  lines.push("};");
  lines.push("");

  const content = lines.join("\n");
  await writeFile(OUTPUT_FILE, content, "utf-8");

  // Summary
  let totalImages = 0;
  for (const data of Object.values(manifest)) {
    if (data.hero) totalImages++;
    totalImages += data.details.length;
  }
  console.log(`Generated ${OUTPUT_FILE}`);
  console.log(`  ${Object.keys(manifest).length} projects, ${totalImages} images`);
}

scan().catch((err) => {
  console.error("Error:", err);
  process.exit(1);
});
