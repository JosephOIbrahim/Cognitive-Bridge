// Portrait for about page
const PORTRAIT = {
  src: "Professional_Portrait/Jaime Ibrahim headshot bw.jpg",
  dest: "about/portrait.jpg",
};

// Supported image extensions (skip GIFs and videos)
const SUPPORTED_EXT = new Set([".jpg", ".jpeg", ".png", ".webp", ".tiff"]);

function isSupported(filename) {
  return SUPPORTED_EXT.has(extname(filename).toLowerCase());
}

async function ensureDir(dir) {
  await mkdir(dir, { recursive: true });
}

async function processImage(srcPath, destPath, label) {
  if (!isSupported(srcPath)) {
    console.log(`  SKIP (unsupported format): ${basename(srcPath)}`);
    return false;
  }

  if (DRY_RUN) {
    console.log(`  DRY-RUN: ${basename(srcPath)} -> ${destPath}`);
    return true;
  }

  try {
    const image = sharp(srcPath);
    const metadata = await image.metadata();
    const needsResize = metadata.width > MAX_WIDTH;

    let pipeline = image;
    if (needsResize) {
      pipeline = pipeline.resize({ width: MAX_WIDTH, withoutEnlargement: true });
    }

    await pipeline
      .jpeg({ quality: JPEG_QUALITY, mozjpeg: true })
      .toFile(destPath);

    const srcStat = await stat(srcPath);
    const destStat = await stat(destPath);
    const savings = Math.round((1 - destStat.size / srcStat.size) * 100);
    const dims = needsResize ? `${metadata.width} -> ${MAX_WIDTH}w` : `${metadata.width}w (no resize)`;

    console.log(`  OK: ${label} [${dims}, ${savings > 0 ? `-${savings}%` : `+${Math.abs(savings)}%`}]`);
    return true;
  } catch (err) {
    console.error(`  ERROR: ${label} -- ${err.message}`);
    return false;
  }
}

async function processProject(slug, config) {
  console.log(`\n--- ${slug} ---`);
  const srcDir = join(SRC_ROOT, config.src);
  const destDir = join(DEST_ROOT, slug);
  await ensureDir(destDir);

  let count = 0;

  // Hero image
  const heroSrc = join(srcDir, config.hero);
  const heroDest = join(destDir, "hero.jpg");
  if (await processImage(heroSrc, heroDest, `hero (${config.hero})`)) count++;

  // Detail images
  for (let i = 0; i < config.details.length; i++) {
    const filename = config.details[i];
    const srcPath = join(srcDir, filename);
    const num = String(i + 1).padStart(2, "0");
    const destPath = join(destDir, `detail-${num}.jpg`);
    if (await processImage(srcPath, destPath, `detail-${num} (${basename(filename)})`)) count++;
  }

  console.log(`  Total: ${count} images`);
  return count;
}

async function processPortrait() {
  console.log(`\n--- portrait ---`);
  const srcPath = join(SRC_ROOT, PORTRAIT.src);
  const destDir = join(DEST_ROOT, "about");
  await ensureDir(destDir);
  const destPath = join(DEST_ROOT, PORTRAIT.dest);
  await processImage(srcPath, destPath, "portrait");
}

async function main() {
  console.log("=== Image Optimization Pipeline ===");
  console.log(`Source: ${SRC_ROOT}`);
  console.log(`Dest:   ${DEST_ROOT}`);
  console.log(`Max width: ${MAX_WIDTH}px, JPEG quality: ${JPEG_QUALITY}`);
  if (DRY_RUN) console.log("*** DRY RUN -- no files will be written ***\n");

  let totalImages = 0;

  for (const [slug, config] of Object.entries(IMAGE_MAP)) {
    totalImages += await processProject(slug, config);
  }

  await processPortrait();
  totalImages++;

  console.log(`\n=== Done: ${totalImages} images processed ===`);
}

main().catch((err) => {
  console.error("Fatal error:", err);
  process.exit(1);
});
