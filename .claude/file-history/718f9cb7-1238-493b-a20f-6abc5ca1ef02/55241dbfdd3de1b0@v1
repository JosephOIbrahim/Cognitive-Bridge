def main():
    import argparse
    parser = argparse.ArgumentParser(description="Synapse VFX Co-Pilot")
    parser.add_argument("goal", nargs="*", help="Goal to accomplish")
    parser.add_argument("--no-resume", action="store_true", help="Start fresh, ignore checkpoints")
    parser.add_argument("--list-checkpoints", action="store_true", help="List saved checkpoints")
