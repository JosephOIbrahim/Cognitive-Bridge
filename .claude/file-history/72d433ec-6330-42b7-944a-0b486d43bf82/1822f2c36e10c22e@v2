import { notFound } from "next/navigation";
import Image from "next/image";
import { PROJECTS, getProject, CASE_STUDIES } from "@/lib/projects";
import { CaseStudySection } from "@/components/CaseStudySection";
import { ImageGallery } from "@/components/ImageGallery";
import { heroImage, detailImages } from "@/lib/images";
import Link from "next/link";
import type { Metadata } from "next";

const BackArrow = (
  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5">
    <path d="M8 1L2 7L8 13" />
  </svg>
);

interface PageProps {
  params: Promise<{ slug: string }>;
}

export async function generateStaticParams() {
  return PROJECTS.map((p) => ({ slug: p.slug }));
}

export async function generateMetadata({ params }: PageProps): Promise<Metadata> {
  const { slug } = await params;
  const project = getProject(slug);
  if (!project) return {};
  return {
    title: project.title,
    description: project.desc,
    openGraph: {
      images: [`/images/${project.slug}/hero.jpg`],
    },
  };
}

export default async function ProjectPage({ params }: PageProps) {
  const { slug } = await params;
  const project = getProject(slug);
  if (!project) notFound();

  const caseStudy = CASE_STUDIES[project.slug];
  const hero = heroImage(project.slug);
  const details = detailImages(project.slug);
  const idx = PROJECTS.findIndex((p) => p.slug === project.slug);
  const prev = idx > 0 ? PROJECTS[idx - 1] : null;
  const next = idx < PROJECTS.length - 1 ? PROJECTS[idx + 1] : null;

  return (
    <div style={{ paddingTop: "var(--nav-h)" }}>
      {/* Back link */}
      <div style={{ maxWidth: "var(--max-w)", margin: "0 auto", padding: "clamp(24px, 4vh, 40px) var(--pad) 0" }}>
        <Link href="/work" className="link-muted" style={{ fontSize: 13, letterSpacing: "0.06em", textTransform: "uppercase", display: "inline-flex", alignItems: "center", gap: 8 }}>
          {BackArrow}
          All Work
        </Link>
      </div>

      {/* Header */}
      <div style={{ padding: "clamp(32px, 6vh, 64px) var(--pad) clamp(48px, 6vh, 80px)", maxWidth: "var(--max-w)", margin: "0 auto" }}>
        <h1 style={{ fontSize: "clamp(36px, 4.5vw, 64px)", fontWeight: 400, letterSpacing: "-0.02em", color: "var(--text)", margin: "0 0 24px", lineHeight: 1.05 }}>
          {project.title}
        </h1>
        <div style={{ display: "flex", gap: "clamp(40px, 6vw, 120px)", alignItems: "flex-start", flexWrap: "wrap" }}>
          <p style={{ fontSize: "clamp(16px, 1.4vw, 20px)", fontWeight: 400, color: "var(--muted)", lineHeight: 1.6, margin: 0, maxWidth: 540, flex: "1 1 360px" }}>
            {project.longDesc || project.desc}
          </p>
          <div style={{ flex: "0 0 180px" }}>
            {[
              { label: "Role", value: "Brand Design Director" },
              { label: "Discipline", value: project.category },
              ...(project.credits ? [{ label: "Credits", value: project.credits }] : []),
            ].map((item) => (
              <div key={item.label} style={{ marginBottom: 18 }}>
                <div style={{ fontSize: 11, color: "var(--muted-light)", fontWeight: 400, letterSpacing: "0.06em", textTransform: "uppercase", marginBottom: 3 }}>
                  {item.label}
                </div>
                <div style={{ fontSize: 14, color: "var(--text)", fontWeight: 400, lineHeight: 1.4 }}>
                  {item.value}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Hero image -- natural aspect ratio, full width */}
      {hero && (
        <div style={{ maxWidth: "var(--max-w)", margin: "0 auto", padding: "0 var(--pad)" }}>
          <Image
            src={hero}
            alt={project.heroAlt || project.title}
            width={2400}
            height={1600}
            style={{ width: "100%", height: "auto", borderRadius: "var(--img-radius)" }}
            sizes="(max-width: 768px) 100vw, (max-width: 1400px) 90vw, 1400px"
            priority
          />
        </div>
      )}

      {/* Video embed */}
      {project.videoUrl && (
        <div style={{ maxWidth: "var(--max-w)", margin: "40px auto 0", padding: "0 var(--pad)" }}>
          <div style={{ position: "relative", paddingBottom: "56.25%", height: 0, overflow: "hidden", borderRadius: "var(--img-radius)" }}>
            <iframe
              src={project.videoUrl}
              style={{ position: "absolute", top: 0, left: 0, width: "100%", height: "100%", border: 0 }}
              allow="autoplay; fullscreen; picture-in-picture"
              allowFullScreen
              title={project.title}
            />
          </div>
        </div>
      )}

      {/* Case study or gallery -- single column, natural aspect ratios */}
      <div style={{ maxWidth: "var(--max-w)", margin: "0 auto", padding: "0 var(--pad)" }}>
        {caseStudy ? (
          caseStudy.sections.map((section, si) => {
            // Compute cumulative offset from previous sections' image counts
            const offset = caseStudy.sections
              .slice(0, si)
              .reduce((sum, s) => sum + (s.images || 2), 0);
            const sectionImages = details.slice(offset, offset + (section.images || 2));
            return (
              <CaseStudySection key={si} section={section} sectionIndex={si} title={project.title} images={sectionImages} />
            );
          })
        ) : details.length > 0 ? (
          <ImageGallery images={details} alt={project.title} />
        ) : null}
      </div>

      {/* Prev/Next navigation */}
      <div style={{ maxWidth: "var(--max-w)", margin: "60px auto 0", padding: "0 var(--pad)", display: "flex", justifyContent: "space-between", borderTop: "1px solid var(--border)", paddingTop: 32 }}>
        {prev ? (
          <Link href={`/work/${prev.slug}`} className="hover-dim" style={{ fontSize: 16, color: "var(--text)" }}>
            <span style={{ fontSize: 11, color: "var(--muted)", letterSpacing: "0.08em", textTransform: "uppercase", display: "block", marginBottom: 4 }}>Previous</span>
            {prev.title}
          </Link>
        ) : <div />}
        {next ? (
          <Link href={`/work/${next.slug}`} className="hover-dim" style={{ fontSize: 16, color: "var(--text)", textAlign: "right" }}>
            <span style={{ fontSize: 11, color: "var(--muted)", letterSpacing: "0.08em", textTransform: "uppercase", display: "block", marginBottom: 4 }}>Next</span>
            {next.title}
          </Link>
        ) : <div />}
      </div>

      <div style={{ height: 60 }} />
    </div>
  );
}
