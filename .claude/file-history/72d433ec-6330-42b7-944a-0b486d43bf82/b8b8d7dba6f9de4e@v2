import styles from "./PlaceholderImage.module.css";

interface PlaceholderImageProps {
  color: string;
  title: string;
  height?: number | string;
  style?: React.CSSProperties;
}

export function PlaceholderImage({ color, title, height = 380, style }: PlaceholderImageProps) {
  return (
    <div
      className={styles.container}
      style={{ background: color, height: typeof height === "number" ? `calc(${height}px * var(--height-scale, 1))` : height, ...style }}
    >
      <div className={styles.pattern} />
      <span className={styles.label}>{title}</span>
    </div>
  );
}
