export function Footer() {
  const [hovered, setHovered] = useState(false);
  const [weather, setWeather] = useState<{ temp: number; icon: string } | null>(null);

  useEffect(() => {
    const fetchWeather = () => {
      fetch("https://api.open-meteo.com/v1/forecast?latitude=40.7128&longitude=-74.006&current=temperature_2m,weather_code&temperature_unit=fahrenheit")
        .then((r) => r.json())
        .then((d) => {
          if (d.current) {
            const temp = Math.round(d.current.temperature_2m);
            const code = d.current.weather_code;
            let icon = "Clear";
            if (code === 0) icon = "Clear";
            else if (code <= 3) icon = "Partly cloudy";
            else if (code <= 48) icon = "Cloudy";
            else if (code <= 67) icon = "Rain";
            else if (code <= 77) icon = "Snow";
            else if (code <= 82) icon = "Rain";
            else if (code <= 86) icon = "Snow";
            else icon = "Storm";
            setWeather({ temp, icon });
          }
        })
        .catch(() => {});
    };
    // Defer weather fetch so it doesn't compete with LCP resources
    if ("requestIdleCallback" in window) {
      const id = requestIdleCallback(fetchWeather);
      return () => cancelIdleCallback(id);
    } else {
      const id = setTimeout(fetchWeather, 2000);
      return () => clearTimeout(id);
    }
  }, []);

  return (
    <footer style={{ position: "relative", zIndex: 1 }}>
      <div
        className={styles.ctaBlock}
        onMouseEnter={() => setHovered(true)}
        onMouseLeave={() => setHovered(false)}
      >
        <Link href="/about" style={{ display: "block", cursor: "pointer" }}>
          <p className={styles.ctaText} style={{ color: hovered ? "var(--muted)" : "var(--text)" }}>
            Let&apos;s Work Together
          </p>
        </Link>
        <p className={styles.ctaEmail}>
          <a href="https://www.linkedin.com/in/jaimeibrahim/" target="_blank" rel="noopener noreferrer" style={{ color: "inherit" }}>
            Connect on LinkedIn
          </a>
        </p>
      </div>

      <div className={styles.infoBar}>
        <span className={styles.socials}>
          <a href="https://www.linkedin.com/in/jaimeibrahim/" target="_blank" rel="noopener noreferrer" className={styles.socialLink} aria-label="LinkedIn">
            {LinkedInIcon}
          </a>
          <a href="https://www.instagram.com/jaimeibrahim/" target="_blank" rel="noopener noreferrer" className={styles.socialLink} aria-label="Instagram">
            {InstagramIcon}
          </a>
        </span>
        <span className={styles.copyright}>
          &copy; 2026 Jaime Ibrahim &nbsp;&nbsp;|&nbsp;&nbsp; Brand Design Director &nbsp;&nbsp;|&nbsp;&nbsp; New York City
          {weather && (
            <span style={{ opacity: 0.5, fontSize: 11 }}>
              &nbsp;&nbsp;{weather.icon} {weather.temp}&deg;F
            </span>
          )}
        </span>
      </div>
    </footer>
  );
}
