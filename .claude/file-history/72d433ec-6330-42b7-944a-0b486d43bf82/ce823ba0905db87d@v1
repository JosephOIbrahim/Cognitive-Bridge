/* --- Design Tokens as CSS Custom Properties --- */
:root {
  --bg: #EEEEEC;
  --text: #1A1A1A;
  --muted: #767676;
  --muted-light: #999999;
  --accent: #D4FF00;
  --border: #E8E8E6;
  --grid-line: rgba(0,0,0,0.055);
  --grid-line-hover: rgba(0,0,0,0.08);
  --font: 'Inter', -apple-system, 'Helvetica Neue', Helvetica, sans-serif;
  --ease: cubic-bezier(0.33, 1, 0.68, 1);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --pad: clamp(20px, 4vw, 80px);
  --max-w: 1400px;
  --nav-h: 72px;
  --img-radius: 6px;
  --row-gap: 24px;
}

/* --- Resets --- */
*, *::before, *::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4, h5, h6, p {
  margin: 0;
  font-weight: 400;
}

button {
  border: none;
  font: inherit;
  cursor: pointer;
  background: none;
}

a {
  color: inherit;
  text-decoration: none;
}

/* --- Keyframes --- */
@keyframes lineReveal {
  from { transform: translateX(-50%) scaleY(0); }
  to { transform: translateX(-50%) scaleY(1); }
}

@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pageEnter {
  from { opacity: 0; }
  to { opacity: 1; }
}

main {
  animation: pageEnter 400ms var(--ease-out) both;
}

/* --- Hover utilities (for server components that can't use JS hover) --- */
.link-muted {
  color: var(--muted-light);
  transition: color 200ms var(--ease);
}
.link-muted:hover {
  color: var(--text);
}

.hover-dim {
  transition: opacity 200ms var(--ease);
}
.hover-dim:hover {
  opacity: 0.6;
}

/* --- Responsive --- */
@media (max-width: 768px) {
  .grid-pair { grid-template-columns: 1fr !important; }
  .grid-triple { grid-template-columns: 1fr !important; }
}

/* --- Accessibility --- */
:focus { outline: none; }
:focus-visible {
  outline: 2px solid rgba(0, 0, 0, 0.3);
  outline-offset: 2px;
}
button:focus:not(:focus-visible),
a:focus:not(:focus-visible) { outline: none; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
