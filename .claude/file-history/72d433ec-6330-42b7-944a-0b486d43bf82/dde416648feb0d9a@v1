.card {
  cursor: pointer;
  display: block;
}

.imageContainer {
  border-radius: var(--img-radius);
  overflow: hidden;
  position: relative;
}

/* Paper cutout: inset shadow layered over the image */
.imageContainer::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: var(--img-radius);
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
  pointer-events: none;
  z-index: 2;
}

/* --- Domino reveal (IO-triggered) --- */

.imageInner {
  clip-path: inset(0 0 100% 0);
  opacity: 0;
  transform: scale(1.05);
  transition:
    clip-path 700ms var(--ease-out) var(--reveal-delay, 0ms),
    opacity 600ms var(--ease-out) var(--reveal-delay, 0ms),
    transform 800ms var(--ease-out) var(--reveal-delay, 0ms);
}

/* Reveal lands at 75% opacity — hover brings to full */
.cardRevealed .imageInner {
  clip-path: inset(0 0 0% 0);
  opacity: 0.75;
  transform: scale(1);
}

/* After reveal, transition to hover-ready (no stagger delay) */
.cardRevealed .imageInner {
  transition:
    opacity 400ms var(--ease),
    transform 600ms var(--ease);
}

/* Hover: full opacity + subtle scale inside the crop window */
.card:hover .imageInner {
  opacity: 1;
  transform: scale(1.04);
}

/* --- Text block --- */

.textBlock {
  margin-top: 14px;
  padding-bottom: 0;
  opacity: 0;
  transform: translateY(12px);
  transition:
    opacity 500ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 200ms),
    transform 500ms var(--ease-out) calc(var(--reveal-delay, 0ms) + 200ms);
}

.cardRevealed .textBlock {
  opacity: 1;
  transform: translateY(0);
}

/* --- Text styles --- */

.title {
  font-size: 18px;
  font-weight: 500;
  margin: 0 0 6px;
  color: var(--text);
  letter-spacing: 0.015em;
  line-height: 1.3;
}

.desc {
  font-size: 14px;
  font-weight: 400;
  margin: 0 0 8px;
  color: var(--muted);
  letter-spacing: normal;
  line-height: 1.4;
}

/* Elevator metatags */
.metatagWrapper {
  height: 30px;
  overflow: hidden;
  margin-top: 8px;
}

.metatagInner {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  transform: translateY(-110%);
  opacity: 0;
  transition:
    transform 350ms var(--ease),
    opacity 250ms var(--ease);
}

.card:hover .metatagInner {
  transform: translateY(0);
  opacity: 1;
  transition:
    transform 350ms var(--ease-out),
    opacity 250ms var(--ease-out);
}

/* --- Accessibility: reduced motion --- */
@media (prefers-reduced-motion: reduce) {
  .imageInner {
    clip-path: none;
    opacity: 0.75;
    transform: none;
    transition: opacity 300ms var(--ease);
  }
  .card:hover .imageInner {
    opacity: 1;
    transform: none;
  }
  .textBlock {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
