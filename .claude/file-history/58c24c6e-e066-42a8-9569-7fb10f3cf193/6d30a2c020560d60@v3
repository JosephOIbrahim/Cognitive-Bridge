'use client';

import Link from 'next/link';
import { getProject } from '@/lib/projects';

/**
 * ChatProjectCard
 * Mini project card for inline display in chat messages
 * Shows thumbnail, title, client, and link to full project
 */

interface ChatProjectCardProps {
  slug: string;
}

export function ChatProjectCard({ slug }: ChatProjectCardProps) {
  const project = getProject(slug);

  if (!project) {
    return null;
  }

  return (
    <Link
      href={`/projects/${project.slug}`}
      className="chat-project-card"
      style={{
        display: 'flex',
        gap: '16px',
        alignItems: 'center',
        padding: '12px',
        marginTop: '20px',
        marginBottom: '12px',
        backgroundColor: 'rgba(255, 255, 255, 0.03)',
        borderRadius: '6px',
        border: '1px solid rgba(255, 255, 255, 0.06)',
        textDecoration: 'none',
        transition: 'background-color 0.2s ease, border-color 0.2s ease'
      }}
      onMouseEnter={(e) => {
        e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.06)';
        e.currentTarget.style.borderColor = 'rgba(255, 255, 255, 0.1)';
      }}
      onMouseLeave={(e) => {
        e.currentTarget.style.backgroundColor = 'rgba(255, 255, 255, 0.03)';
        e.currentTarget.style.borderColor = 'rgba(255, 255, 255, 0.06)';
      }}
    >
      {/* Thumbnail — only render when URL is present */}
      {project.thumbnail && (
        <div
          style={{
            width: '80px',
            height: '45px',
            borderRadius: '4px',
            overflow: 'hidden',
            flexShrink: 0,
            backgroundColor: '#1a1a1a'
          }}
        >
          <img
            src={project.thumbnail}
            alt={project.title}
            style={{
              width: '100%',
              height: '100%',
              objectFit: 'cover'
            }}
          />
        </div>
      )}

      {/* Info */}
      <div style={{ flex: 1, minWidth: 0 }}>
        <h4
          style={{
            color: '#e8e8e8',
            fontFamily: 'var(--font-lora)',
            fontStyle: 'italic',
            fontSize: '15px',
            fontWeight: 400,
            lineHeight: 1.3,
            margin: 0,
            overflow: 'hidden',
            textOverflow: 'ellipsis',
            whiteSpace: 'nowrap'
          }}
        >
          {project.title}
        </h4>
        {(project.client || project.studio) && (
          <p
            style={{
              color: '#6a6a6a',
              fontFamily: 'var(--font-display)',
              fontSize: '11px',
              letterSpacing: '0.08em',
              textTransform: 'uppercase',
              margin: '4px 0 0 0'
            }}
          >
            {project.client || project.studio}
          </p>
        )}
      </div>

      {/* Arrow */}
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        strokeWidth="1.5"
        strokeLinecap="round"
        strokeLinejoin="round"
        style={{ color: '#5a5a5a', flexShrink: 0 }}
      >
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    </Link>
  );
}

/**
 * Parse message text and extract project slugs
 * Returns array of { type: 'text' | 'project', content: string }
 */
export function parseMessageWithProjects(text: string): Array<{ type: 'text' | 'project'; content: string }> {
  const parts: Array<{ type: 'text' | 'project'; content: string }> = [];
  const projectRegex = /\[PROJECT:([a-z0-9-]+)\]/gi;

  let lastIndex = 0;
  let match;

  while ((match = projectRegex.exec(text)) !== null) {
    // Add text before the match
    if (match.index > lastIndex) {
      parts.push({
        type: 'text',
        content: text.slice(lastIndex, match.index)
      });
    }

    // Add the project reference
    parts.push({
      type: 'project',
      content: match[1] // The slug
    });

    lastIndex = match.index + match[0].length;
  }

  // Add remaining text
  if (lastIndex < text.length) {
    parts.push({
      type: 'text',
      content: text.slice(lastIndex)
    });
  }

  return parts.length > 0 ? parts : [{ type: 'text', content: text }];
}
