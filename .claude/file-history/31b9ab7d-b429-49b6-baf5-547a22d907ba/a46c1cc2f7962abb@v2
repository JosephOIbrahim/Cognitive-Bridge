'use client';

import dynamic from 'next/dynamic';

const CustomCursor = dynamic(() => import('./CustomCursor').then(mod => ({ default: mod.CustomCursor })), {
  ssr: false,
});

const ShutdownOverlay = dynamic(() => import('./ShutdownOverlay').then(mod => ({ default: mod.ShutdownOverlay })), {
  ssr: false,
});

export function DeferredOverlays() {
  return (
    <>
      <CustomCursor />
      <ShutdownOverlay />
    </>
  );
}
