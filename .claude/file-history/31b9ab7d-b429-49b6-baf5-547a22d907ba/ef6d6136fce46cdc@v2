import { ImageResponse } from 'next/og';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { projects } from '@/lib/projects';
import { genAiProjects } from '@/lib/gen-ai-projects';

export const alt = 'Joseph Ibrahim — Project';
export const size = { width: 1200, height: 630 };
export const contentType = 'image/png';

const allProjects = [...projects, ...genAiProjects];

export default async function Image({ params }: { params: Promise<{ slug: string }> }) {
  const { slug } = await params;
  const project = allProjects.find(p => p.slug === slug);

  if (!project) {
    return new ImageResponse(
      (
        <div style={{ width: '100%', height: '100%', backgroundColor: '#141414', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#666' }}>
          <span style={{ fontSize: '32px' }}>Project Not Found</span>
        </div>
      ),
      { ...size }
    );
  }

  // Use Vimeo thumbnail as background
  const thumbnailUrl = project.thumbnail || `https://vumbnail.com/${project.videoId}.jpg`;

  // Load fonts from local bundle via filesystem
  const fontsDir = join(process.cwd(), 'app', 'fonts');
  const [loraItalic, dmSans] = await Promise.all([
    readFile(join(fontsDir, 'lora-italic.ttf')),
    readFile(join(fontsDir, 'dm-sans-regular.ttf')),
  ]);

  // Build subtitle from available metadata
  const subtitleParts: string[] = [];
  if (project.client) subtitleParts.push(project.client);
  if (project.studio) subtitleParts.push(project.studio);
  if (project.year) subtitleParts.push(project.year);
  const subtitle = subtitleParts.join('  ·  ');

  return new ImageResponse(
    (
      <div style={{ width: '100%', height: '100%', backgroundColor: '#141414', display: 'flex', position: 'relative', overflow: 'hidden' }}>
        {/* Project thumbnail background */}
        <img
          src={thumbnailUrl}
          alt=""
          style={{
            position: 'absolute', top: 0, left: 0, width: '100%', height: '100%',
            objectFit: 'cover', opacity: 0.45, filter: 'saturate(0.8) contrast(1.1)',
          }}
        />

        {/* Gradient overlay — heavier at bottom for text legibility */}
        <div style={{
          position: 'absolute', left: 0, top: 0, width: '100%', height: '100%',
          background: 'linear-gradient(180deg, rgba(20,20,20,0.5) 0%, rgba(20,20,20,0.65) 40%, rgba(20,20,20,0.92) 100%)',
        }} />

        {/* Text content — bottom-aligned like a film title card */}
        <div style={{
          display: 'flex', flexDirection: 'column', justifyContent: 'flex-end',
          width: '100%', height: '100%', padding: '60px', position: 'relative', zIndex: 10,
        }}>
          {/* Project title */}
          <div style={{
            color: '#f0f0f0', fontFamily: 'Lora', fontStyle: 'italic', fontWeight: 400,
            fontSize: '56px', lineHeight: 1.15, letterSpacing: '0.005em', marginBottom: '16px',
          }}>
            {project.title}
          </div>

          {/* Client / Studio / Year */}
          {subtitle ? (
            <div style={{
              color: '#999', fontFamily: 'DM Sans', fontWeight: 400,
              fontSize: '22px', lineHeight: 1.4, letterSpacing: '0.03em',
              marginBottom: '8px',
            }}>
              {subtitle}
            </div>
          ) : null}

          {/* Role */}
          {project.myRole ? (
            <div style={{
              color: '#6a6a6a', fontFamily: 'DM Sans', fontWeight: 400,
              fontSize: '18px', lineHeight: 1.4, letterSpacing: '0.02em',
            }}>
              {project.myRole}
            </div>
          ) : null}
        </div>

        {/* Site URL — bottom right */}
        <div style={{
          position: 'absolute', bottom: '28px', right: '60px',
          color: '#4a4a4a', fontFamily: 'DM Sans', fontWeight: 500,
          fontSize: '13px', letterSpacing: '0.12em', textTransform: 'uppercase',
        }}>
          josephibrahim.com
        </div>
      </div>
    ),
    {
      ...size,
      fonts: [
        { name: 'Lora', data: loraItalic, style: 'italic' as const, weight: 400 as const },
        { name: 'DM Sans', data: dmSans, style: 'normal' as const, weight: 400 as const },
      ],
    }
  );
}
