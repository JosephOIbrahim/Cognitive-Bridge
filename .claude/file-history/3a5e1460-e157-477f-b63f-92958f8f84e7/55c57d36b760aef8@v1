"""
Synapse Runner — Claude Code <-> Houdini bridge
Execute Python code inside Houdini's live session via WebSocket.

Usage:
    python synapse_runner.py <command_file.py> [--port 9999] [--timeout 30]
    python synapse_runner.py --inline "import hou; print(hou.applicationVersionString())"
    python synapse_runner.py --check
"""
import asyncio
import sys
import json
import argparse

# Add synapse client to path
sys.path.insert(0, r'C:\Users\User\.synapse\agent')


async def run_in_houdini(code: str, port: int = 9999, timeout: int = 30):
    """Execute Python code inside Houdini via Synapse, return result."""
    from synapse_ws import SynapseClient
    async with SynapseClient(port=port) as client:
        result = await client.execute_python(code, timeout=timeout)
        return result


async def health_check(port: int = 9999):
    """Quick Synapse/Houdini health check."""
    from synapse_ws import SynapseClient
    checks = {}
    try:
        async with SynapseClient(port=port) as c:
            # Basic connectivity
            r = await c.execute_python(
                "import hou; print(hou.applicationVersionString())", timeout=5
            )
            checks['houdini_version'] = r.get('data', '').strip() if isinstance(r, dict) else str(r).strip()
            checks['synapse_connected'] = True

            # Python environment
            r = await c.execute_python("""
import sys, json
checks = {
    'python_version': sys.version.split()[0],
    'has_wolframalpha': __import__('importlib').util.find_spec('wolframalpha') is not None,
    'has_httpx': __import__('importlib').util.find_spec('httpx') is not None,
    'has_nest_asyncio': __import__('importlib').util.find_spec('nest_asyncio') is not None,
    'houdini_prefs': __import__('hou').homeHoudiniDirectory(),
}
print(json.dumps(checks))
""", timeout=10)
            data = r.get('data', '{}') if isinstance(r, dict) else str(r)
            env = json.loads(data.strip())
            checks.update(env)

            # Warn if nest_asyncio is present (poison)
            if checks.get('has_nest_asyncio'):
                checks['WARNING'] = 'nest_asyncio.py found — DELETE IT from scripts/python/'

    except Exception as e:
        checks['synapse_connected'] = False
        checks['error'] = str(e)
        checks['fix'] = 'Start Houdini, then in Python Shell: from synapse.server import SynapseServer; s = SynapseServer(port=9999); s.start()'

    return checks


async def run_wolfram_phase(phase: str, port: int = 9999, timeout: int = 60):
    """Run a specific Wolfram upgrade phase."""
    phases = {
        'W1': """
import sys, json
sys.path.insert(0, r'C:\\Users\\User\\OneDrive\\Documents\\houdini21.0\\scripts\\python')
from cinema_camera.wolfram_upgrades.validate_optics import validate_all_optics
result = validate_all_optics()
print(json.dumps(result, default=str))
""",
        'W2-W3': """
import sys, json
sys.path.insert(0, r'C:\\Users\\User\\OneDrive\\Documents\\houdini21.0\\scripts\\python')
from cinema_camera.wolfram_upgrades.fit_squeeze_breathing import fit_squeeze_curves
result = fit_squeeze_curves()
print(json.dumps(result, default=str))
""",
        'W4': """
import sys, json
sys.path.insert(0, r'C:\\Users\\User\\OneDrive\\Documents\\houdini21.0\\scripts\\python')
from cinema_camera.wolfram_upgrades.fit_pupil_shift import fit_pupil_shift_curves
result = fit_pupil_shift_curves()
print(json.dumps(result, default=str))
""",
        'W5': """
import sys, json
sys.path.insert(0, r'C:\\Users\\User\\OneDrive\\Documents\\houdini21.0\\scripts\\python')
from cinema_camera.wolfram_upgrades.calibrate_biomechanics import calibrate_biomechanics
result = calibrate_biomechanics()
print(json.dumps(result, default=str))
""",
    }

    if phase not in phases:
        return {'error': f'Unknown phase: {phase}. Valid: {list(phases.keys())}'}

    from synapse_ws import SynapseClient
    async with SynapseClient(port=port) as client:
        result = await client.execute_python(phases[phase], timeout=timeout)
        return result


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='Synapse Runner — Claude Code <-> Houdini bridge')
    parser.add_argument('command_file', nargs='?', help='Python file to execute in Houdini')
    parser.add_argument('--inline', '-i', help='Inline Python code to execute')
    parser.add_argument('--check', '-c', action='store_true', help='Run health check')
    parser.add_argument('--phase', '-p', help='Run Wolfram phase (W1, W2-W3, W4, W5)')
    parser.add_argument('--all-phases', action='store_true', help='Run all Wolfram phases')
    parser.add_argument('--port', type=int, default=9999)
    parser.add_argument('--timeout', type=int, default=30)
    args = parser.parse_args()

    if args.check:
        result = asyncio.run(health_check(args.port))
        print(json.dumps(result, indent=2))

    elif args.phase:
        result = asyncio.run(run_wolfram_phase(args.phase, args.port, args.timeout))
        print(json.dumps(result, indent=2, default=str))

    elif args.all_phases:
        async def run_all():
            results = {}
            for phase in ['W1', 'W2-W3', 'W4', 'W5']:
                print(f"\n[{phase}] Running...")
                r = await run_wolfram_phase(phase, args.port, args.timeout)
                results[phase] = r
                status = '✓' if (isinstance(r, dict) and r.get('success')) else '✗'
                print(f"[{phase}] {status}")
            return results
        results = asyncio.run(run_all())
        print(json.dumps(results, indent=2, default=str))

    elif args.inline:
        result = asyncio.run(run_in_houdini(args.inline, args.port, args.timeout))
        print(json.dumps(result, indent=2, default=str) if isinstance(result, dict) else result)

    elif args.command_file:
        with open(args.command_file, 'r') as f:
            code = f.read()
        result = asyncio.run(run_in_houdini(code, args.port, args.timeout))
        print(json.dumps(result, indent=2, default=str) if isinstance(result, dict) else result)

    else:
        parser.print_help()
