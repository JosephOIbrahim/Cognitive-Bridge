"""
Synapse Runner — Claude Code <-> Houdini bridge
Execute Python code inside Houdini's live session via WebSocket.

Usage:
    python synapse_runner.py <command_file.py> [--timeout 30]
    python synapse_runner.py --inline "import hou; print(hou.applicationVersionString())"
    python synapse_runner.py --check
    python synapse_runner.py --all-phases --timeout 60
"""
import asyncio
import sys
import json
import argparse

# Add synapse client to path
sys.path.insert(0, r'C:\Users\User\.synapse\agent')


async def run_in_houdini(code: str, timeout: int = 30):
    """Execute Python code inside Houdini via Synapse, return result."""
    from synapse_ws import SynapseClient
    async with SynapseClient() as client:
        result = await client.execute_python(code, timeout=timeout)
        return result


async def health_check():
    """Quick Synapse/Houdini health check."""
    from synapse_ws import SynapseClient
    checks = {}
    try:
        async with SynapseClient() as c:
            # Basic connectivity
            r = await c.execute_python(
                "import hou; result = hou.applicationVersionString()", timeout=5
            )
            checks['houdini_version'] = str(r).strip() if r else 'unknown'
            checks['synapse_connected'] = True

            # Python environment
            r = await c.execute_python("""
import sys, importlib
result = {
    'python_version': sys.version.split()[0],
    'has_wolframalpha': importlib.util.find_spec('wolframalpha') is not None,
    'has_httpx': importlib.util.find_spec('httpx') is not None,
    'has_nest_asyncio': importlib.util.find_spec('nest_asyncio') is not None,
    'houdini_prefs': __import__('hou').homeHoudiniDirectory(),
}
""", timeout=10)
            if isinstance(r, dict):
                checks.update(r)

            # Warn if nest_asyncio is present (poison)
            if checks.get('has_nest_asyncio'):
                checks['WARNING'] = 'nest_asyncio.py found — DELETE IT from scripts/python/'

    except Exception as e:
        checks['synapse_connected'] = False
        checks['error'] = str(e)
        checks['fix'] = 'Start Houdini, then in Python Shell: from synapse.server import SynapseServer; s = SynapseServer(port=9999); s.start()'

    return checks


