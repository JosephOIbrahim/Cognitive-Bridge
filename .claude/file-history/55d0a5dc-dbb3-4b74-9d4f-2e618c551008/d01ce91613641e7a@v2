{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.josephibrahim.com" }],
      "destination": "https://josephibrahim.com/:path*",
      "permanent": true
    }
  ]
}
